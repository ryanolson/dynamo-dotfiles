DNS_LABEL = re.compile(r'^[a-z0-9]([-a-z0-9]*[a-z0-9])?$')
DNS_SUBDOMAIN = re.compile(r'^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$')
LABEL_VALUE = re.compile(r'^[A-Za-z0-9]([A-Za-z0-9._-]{0,61}[A-Za-z0-9])?$')
LEASE_ID = re.compile(r'^lse_[a-z0-9]{4,64}$')
ATTEMPT_ID = re.compile(r'^att_[a-z0-9]{8,64}$')
REQUEST_ID = re.compile(r'^req_[a-z0-9]{8,64}$')
# The plugin's refusals of a claim, all decided before its transaction commits. Any other error (an internal
# one, say) may come after the commit, so the request stays the one to ask with again.
CLAIM_REFUSALS = {
    'enforcement_unhealthy', 'not_your_thread', 'invalid_argument', 'profiles_unavailable', 'cluster_not_allowed',
    'cluster_never', 'cluster_read_only', 'cluster_profile_incomplete', 'first_run_unapproved', 'too_many_hours',
    'gpu_type_not_on_cluster', 'gpu_type_no_limit', 'multi_node_unapproved', 'namespace_not_premade',
    'thread_not_live', 'namespace_not_found', 'inspect_failed', 'uid_mismatch', 'namespace_not_ours',
    'namespace_over_lease', 'cluster_changed', 'namespace_leased', 'predecessor_mismatch', 'over_limit',
    'request_conflict'}
# What the API server answers when it refused a write outright: the write did not happen. Any other failure
# (a timeout, a lost connection, an internal error) leaves the outcome unknown.
DEFINITE = ('(AlreadyExists)', '(Conflict)', '(NotFound)', '(Invalid)', '(BadRequest)', '(Forbidden)',
            '(UnprocessableEntity)', '(MethodNotAllowed)', '(Gone)', 'testing value', 'test operation',
            'Precondition failed')
UID = re.compile(r'^[A-Za-z0-9][A-Za-z0-9-]{0,63}$')


# --- secrets never leave the process -----------------------------------------

_SECRET_VALUES = []


def remember_secret(value):
    for form in (value, base64.b64encode(value.encode()).decode(),
                 base64.b64encode(f'$oauthtoken:{value}'.encode()).decode()):
        if form and form not in _SECRET_VALUES:
            _SECRET_VALUES.append(form)


def scrub(text):
    text = str(text)
    for value in _SECRET_VALUES:
        text = text.replace(value, '[secret]')
    return text


def emit(obj, status=0):
    sys.stdout.write(scrub(json.dumps(obj, indent=2)) + '\n')
    return status


# --- time ---------------------------------------------------------------------

def now():
    return datetime.now(timezone.utc)


def rfc3339(dt):
    return dt.astimezone(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def parse_time(value, what):
    try:
        dt = datetime.fromisoformat(str(value).replace('Z', '+00:00'))
    except ValueError:
        raise Refusal('invalid_time', f'{what} is not an RFC 3339 time: {value!r}')
    if dt.tzinfo is None:
        raise Refusal('invalid_time', f'{what} has no time zone: {value!r}')
    return dt


# --- kubectl --------------------------------------------------------------------

class Kubectl:
    """The pinned kubectl on a kubeconfig rendered for one context, through k8s_profiles.

    prepare_bot_kubeconfig finds the installed kubectl ELF binary whose sha256 is the profile's pin,
    keeps only tbot's fields of the bot kubeconfig, and replaces tbot's exec plugin with a credential
    snapshot taken now, in a memfd sealed against writes. So each guard run takes a fresh snapshot
    (the certificate lives about an hour). Every call uses that kubectl, /proc/self/fd/<n> of that
    memfd, and kubectl_env(): no KUBECONFIG, no KUBECTL_*, kuberc off.
    """

    def __init__(self, bot, context):
        try:
            kubectl, self.fd = prepare_bot_kubeconfig(bot['kubeconfig'], context, bot['kubectl_sha256'])
        except ProfileError as e:
            # kubectl_not_found, kubectl_mismatch, kubeconfig_not_bot, kubectl_error, context_missing,
            # kubeconfig_credentials or credentials_expired: the guard refuses with the same code.
            raise Refusal(e.code, str(e))
        self.base = [kubectl, '--kubeconfig', f'/proc/self/fd/{self.fd}', '--context', context]
        self.env = kubectl_env()

    def run(self, *args, input=None, timeout=KUBECTL_TIMEOUT):
        try:
            p = subprocess.run(self.base + list(args), input=input, capture_output=True, text=True,
                               env=self.env, timeout=timeout, pass_fds=(self.fd,),
                               stdin=None if input is not None else subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            return 124, '', f'kubectl timed out after {timeout}s'
        except FileNotFoundError:
            return 127, '', 'kubectl is not on PATH'
        return p.returncode, p.stdout, p.stderr

    def json(self, *args, input=None, not_found=None, timeout=KUBECTL_TIMEOUT):
        rc, out, err = self.run(*args, input=input, timeout=timeout)
        if rc != 0:
            if not_found is not None and is_not_found(err):
                return not_found
            raise kubectl_error(args, rc, err)
        try:
            return json.loads(out)
        except json.JSONDecodeError:
            raise Refusal('kubectl_error', f'kubectl {args[0]} printed no JSON')


class _Missing:
    pass


MISSING = _Missing()


def is_not_found(err):
    return '(NotFound)' in err or 'NotFound' in err.split(':', 1)[0]


def kubectl_error(args, rc, err):
    e = Refusal('kubectl_error', f'kubectl {" ".join(args[:3])} exited {rc}: {clip(err, 600)}')
    e.raw = err  # kept, not printed: whether the server refused outright decides an attempt's outcome
    return e


def definite(err):
    return any(m in err for m in DEFINITE)


def clip(text, n):
    """Redact first, then cut: a cut through a secret would leave a prefix no redaction can find."""
    return scrub(str(text).strip())[:n]


# --- bb (the k8s-leases plugin) ---------------------------------------------------

class BbResult:
    def __init__(self, value=None, code=None, error=None, offline=False):
        self.value, self.code, self.error, self.offline = value, code, error, offline

    @property
    def ok(self):
        return self.value is not None


def bb(*args):
    """Call the plugin. A JSON error is the plugin's answer; anything else means it could not be reached."""
    try:
        p = subprocess.run(['bb', *args], capture_output=True, text=True, stdin=subprocess.DEVNULL,
                           timeout=BB_TIMEOUT)
    except FileNotFoundError:
        return BbResult(offline=True, error='bb is not on PATH')
    except subprocess.TimeoutExpired:
        return BbResult(offline=True, error=f'bb timed out after {BB_TIMEOUT}s')
    try:
        body = json.loads(p.stdout)
    except json.JSONDecodeError:
        body = None
    if not isinstance(body, dict):
        return BbResult(offline=True, error=clip(p.stderr or p.stdout, 300) or f'bb exited {p.returncode}')
    if p.returncode == 0 and 'error' not in body:
        return BbResult(value=body)
    code = body.get('code') if isinstance(body.get('code'), str) and re.match(r'^[a-z0-9_]{1,64}$',
                                                                              body.get('code') or '') else 'lease_error'
    return BbResult(code=code, error=clip(body.get('error', f'bb exited {p.returncode}'), 300))


def lease_show(lease_id):
    res = bb('k8s', 'lease', 'show', lease_id)
    if res.ok:
        v = res.value
        shape = {'state': str, 'cluster': str, 'namespace': str, 'uid': str, 'thread': str, 'gpu_type': str,
                 'gpus': int, 'expires_at': str, 'multi_node': bool}
        for key, kind in shape.items():
            if not isinstance(v.get(key), kind) or (kind is int and isinstance(v.get(key), bool)):
                raise Refusal('lease_invalid', f'bb k8s lease show {lease_id}: {key} is missing or not a {kind.__name__}')
        if v['state'] not in LEASE_STATES:
            raise Refusal('lease_invalid', f'lease {lease_id} has an unknown state {v["state"]!r}')
    return res


def lease_unavailable(res, what):
    return Refusal('lease_unavailable', f'cannot reach the k8s-leases plugin for {what}: {res.error}')


# --- the guard's context ------------------------------------------------------------

class Guard:
    def __init__(self, profiles, context, namespace):
        self.profiles = profiles
        self.bot = profiles['bot']
        if not context:
            raise Refusal('context_required', 'pass --context <kube context> on every command')
        matches = [(n, p) for n, p in profiles['clusters'].items() if p['context'] == context]
        if not matches:
            raise Refusal('unknown_context', f'no cluster profile has context {context!r}; the guard refuses it')
        if len(matches) > 1:
            raise Refusal('profiles_invalid', f'{len(matches)} profiles share context {context!r}')
        self.cluster, self.profile = matches[0]
        self.context = context
        if self.profile['allowed'] == 'never':
            raise Refusal('cluster_never', f'{self.cluster} is marked never: agents must not touch it')
        self.namespace = namespace
        self.thread = os.environ.get('BB_THREAD_ID') or None
        self.kc = None
        # The one namespace of ours ops made where the bot cannot create namespaces, or None.
        self.premade = self.bot.get('premade_namespace')

    def check_identity(self):
        # The parser resolved bot.kubeconfig and allows it only under tbot's directory in the
        # account's home, never in a .kube or .tsh directory. KUBECONFIG must name that file, so
        # the caller meant it; kubectl itself gets the pinned file and no KUBECONFIG.
        bot_path = self.bot['kubeconfig']
        value = os.environ.get('KUBECONFIG')
        if not value:
            raise Refusal('kubeconfig_not_bot', 'KUBECONFIG is unset; export the bot kubeconfig')
        if os.pathsep in value:
            raise Refusal('kubeconfig_not_bot', 'KUBECONFIG lists more than one file; name only the bot kubeconfig')
        if os.path.realpath(value) != bot_path:
            raise Refusal('kubeconfig_not_bot', f'KUBECONFIG is {value}, not the bot kubeconfig {bot_path}')
        self.kc = Kubectl(self.bot, self.context)

    def require_writable(self):
        if not self.profile.get('bot_can_write'):
            raise Refusal('cluster_read_only', f'{self.cluster} is read only for the bot')

    def require_thread(self):
        if not self.thread:
            raise Refusal('thread_required', 'BB_THREAD_ID is unset; only a bb thread can own a namespace')
        if not LABEL_VALUE.match(self.thread):
            raise Refusal('thread_required', f'BB_THREAD_ID {self.thread!r} is not a valid label value')
        return self.thread

    def ns_name(self, positional=None):
        ns = positional or self.namespace
        if positional and self.namespace and positional != self.namespace:
            raise Refusal('usage', f'-n {self.namespace} and {positional} disagree', status=2)
        if not ns:
            raise Refusal('namespace_required', 'name the namespace with -n')
        prefix = self.bot['namespace_prefix']
        if not ns.startswith(prefix) or not DNS_LABEL.match(ns) or len(ns) > 63:
            raise Refusal('namespace_not_ours', f'{ns} is not one of our namespaces ({prefix}*)')
        return ns

    def ledger_namespaces(self):
        """This thread's live namespaces on this cluster, name to UID, from its own ledger."""
        storage = os.environ.get('BB_THREAD_STORAGE')
        if not storage:
            raise Refusal('ledger_required', 'BB_THREAD_STORAGE is unset; the thread ledger names its namespaces')
        live = {}
        try:
            lines = (Path(storage) / 'k8s-ledger.jsonl').read_text().splitlines()
        except FileNotFoundError:
            lines = []
        for text in lines:
            try:
                line = json.loads(text)
            except json.JSONDecodeError:
                continue
            if (not isinstance(line, dict) or line.get('thread') != self.thread or line.get('cluster') != self.cluster
                    or line.get('object') != f'Namespace/{line.get("namespace")}'):
                continue
            if line.get('direction') == 'up' and line.get('created'):
                live[line['namespace']] = line.get('uid')
            elif line.get('direction') == 'down' and line.get('deleted'):
                live.pop(line['namespace'], None)
        return live

    def ledger_lines(self):
        storage = os.environ.get('BB_THREAD_STORAGE')
        if not storage:
            raise Refusal('ledger_required', 'BB_THREAD_STORAGE is unset; the thread ledger names its namespaces')
        try:
            text = (Path(storage) / 'k8s-ledger.jsonl').read_text().splitlines()
        except FileNotFoundError:
            return []
        out = []
        for line in text:
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(obj, dict) and obj.get('thread') == self.thread and obj.get('cluster') == self.cluster:
                out.append(obj)
        return out

    def claim_lines(self, ns):
        """This thread's claim lines for a namespace, oldest first: requests, grants and refusals."""
        return [l for l in self.ledger_lines() if l.get('object') == f'Claim/{ns}']

    def claimed_lease(self, ns):
        """The lease and UID this thread's latest granted claim of ns names, or (None, None). Only a pointer:
        the k8s-leases row decides."""
        for line in reversed(self.claim_lines(ns)):
            if line.get('direction') == 'claim' and LEASE_ID.match(str(line.get('lease'))):
                return line['lease'], line.get('uid')
        return None, None

    def owned_claimed(self, name):
        self.require_thread()
        lease_id, uid = self.claimed_lease(name)
        view = NsView(self, name, claimed=True, lease_id=lease_id)
        if lease_id is None:
            raise Refusal('namespace_not_claimed', f'{name} is the pre-made namespace and this thread holds no claim '
                                                   f'of it; run `k8s-guard -n {name} ns claim --gpus <n> --hours <h>`')
        if view.uid != uid:
            raise Refusal('uid_mismatch', f'{name} has UID {view.uid}, not {uid} from the claim: it was re-created')
        return name, view

    def owned(self):
        """The caller's namespace and the UID it was created with, from the thread's ledger.

        Names are never reused (ns create adds a random suffix), and a caller-given -n is accepted only
        when it is one of the thread's own namespaces. With no -n, the thread's only live namespace.
        """
        self.require_thread()
        if self.premade and self.namespace == self.premade:
            return self.owned_claimed(self.premade)
        live = self.ledger_namespaces()
        if self.namespace is None and not live and self.premade and self.claimed_lease(self.premade)[0]:
            return self.owned_claimed(self.premade)
        if self.namespace is None:
            if len(live) != 1:
                raise Refusal('namespace_required', 'name the namespace with -n; this thread has '
                                                    f'{", ".join(sorted(live)) or "none"} on {self.cluster}')
            name = self.ns_name(next(iter(live)))
        else:
            name = self.ns_name()
        if name not in live:
            # Read the label first, for a clearer refusal when the namespace belongs to another thread.
            NsView(self, name).require_owner(self)
            raise Refusal('namespace_not_in_ledger', f'{name} is not in this thread\'s ledger; the guard writes '
                                                     'only in namespaces this thread created')
        view = NsView(self, name)
        view.require_owner(self)
        if view.uid != live[name]:
            raise Refusal('uid_mismatch', f'{name} has UID {view.uid}, not {live[name]} from the ledger: it was '
                                          're-created; left alone')
        return name, view

    # --- reads ---

    def get_namespace(self, ns):
        obj = self.kc.json('get', 'namespace', ns, '-o', 'json', not_found=MISSING)
        if obj is MISSING:
            raise Refusal('not_found', f'namespace {ns} not found')
        return obj

    def lease_record(self, ns):
        cm = self.kc.json('get', 'configmap', LEASE_RECORD, '-n', ns, '-o', 'json', not_found=MISSING)
        return None if cm is MISSING else cm

    def dgds(self, ns):
        return self.kc.json('get', DGD_RESOURCE, '-n', ns, '-o', 'json').get('items') or []

    def pods(self, ns):
        return self.kc.json('get', 'pods', '-n', ns, '-o', 'json').get('items') or []

    # --- ledger ---

    def record(self, ns, obj, gpus, direction, uid=None, lease=None, issue=None, **extra):
        line = {'time': rfc3339(now()), 'thread': self.thread, 'cluster': self.cluster, 'context': self.context,
                'namespace': ns, 'uid': uid, 'object': obj, 'gpus': gpus, 'direction': direction, 'lease': lease,
                'issue': issue, **extra}
        text = scrub(json.dumps(line)) + '\n'
        state = Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state')
        paths = [state / 'k8s-guard/ledger.jsonl']
        if os.environ.get('BB_THREAD_STORAGE'):
            paths.append(Path(os.environ['BB_THREAD_STORAGE']) / 'k8s-ledger.jsonl')
        for path in paths:
            path.parent.mkdir(parents=True, exist_ok=True)
            with open(path, 'a') as f:
                f.write(text)


class NsView:
    """One read of a namespace: its object, labels and the lease record ConfigMap."""

    def __init__(self, g, ns, claimed=False, lease_id=None):
        self.name = ns
        # A claimed namespace is the profile's pre-made one: the bot cannot label or delete it, it keeps no
        # lease record, and its lease comes from k8s-leases (the thread ledger only points at it).
        self.claimed = claimed
        self.obj = g.get_namespace(ns)
        meta = self.obj.get('metadata') or {}
        self.uid = meta.get('uid')
        self.labels = meta.get('labels') or {}
        self.annotations = meta.get('annotations') or {}
        self.thread = self.labels.get(THREAD_LABEL)
        self.issue = self.labels.get(ISSUE_LABEL)
        self.record = None if claimed else g.lease_record(ns)
        data = (self.record or {}).get('data') or {}
        self.lease_id = lease_id if claimed else (data.get('lease_id') or None)
        # The record's expiry counts only for the namespace it was written in.
        self.record_expires = data.get('expires_at') if data.get('uid') == self.uid else None
        # The record must come from the namespace whose UID was read, not one re-created in between.
        confirm_uid(g, ns, self.uid)

    def expires_at(self):
        return self.record_expires or self.annotations.get(EXPIRES_ANNOTATION)

    def require_owner(self, g):
        me = g.require_thread()
        if self.thread != me:
            raise Refusal('not_your_namespace', f'{self.name} belongs to thread {self.thread or "nobody"}, not {me}')


# --- the lease and its operation slot ----------------------------------------------------

def lease_for_write(g, view):
    res = lease_show(view.lease_id)
    if res.offline:
        raise lease_unavailable(res, f'lease {view.lease_id}')
    if not res.ok:
        raise Refusal(res.code, f'lease {view.lease_id}: {res.error}')
    lease = dict(res.value, lease_id=view.lease_id)
    if lease['state'] != 'active':
        raise Refusal('lease_not_active', f'lease {view.lease_id} is {lease["state"]}')
    wrong = [f'{k} {lease[k]!r}, not {want!r}' for k, want in (
        ('thread', g.thread), ('cluster', g.cluster), ('namespace', view.name), ('uid', view.uid),
        ('gpu_type', g.profile['gpu_type'])) if lease[k] != want]
    if wrong:
        raise Refusal('lease_mismatch', f'lease {view.lease_id} does not cover this write: ' + '; '.join(wrong))
    return lease


class Slot:
    def __init__(self, lease_id, token, deadline):
        self.lease_id, self.token, self.deadline = lease_id, token, deadline

    def left(self):
        return (self.deadline - now()).total_seconds()

    def timeout(self):
        """How long one kubectl call may run: it is stopped before the slot ends."""
        return max(1, min(APPLY_REQUEST_TIMEOUT + 15, self.left() - 2))

    def check(self):
        left = self.left()
        if left < SLOT_MARGIN:
            raise Refusal('slot_expired', f'the operation slot of {self.lease_id} has {max(left, 0):.0f}s left, '
                                          f'less than the {SLOT_MARGIN}s an apply may take; try again')


# --- write attempts -------------------------------------------------------------------
#
# A write whose reply never came may still land: a slot that expired, a client that exited and a list that
# reads empty prove nothing about it. So every write under a lease is an attempt with its own id, recorded
# in k8s-leases before the write is sent and resolved after it: by the server's answer, by observing the
# id stamped on the object, or by proof that the write's precondition can no longer hold. An attempt
# nobody can resolve keeps the lease's GPUs charged and blocks its next write (references/k8s-guard.md).

def new_attempt_id():
    return 'att_' + secrets.token_hex(10)


def resolve_attempt(g, ns, a):
    """What storage shows about attempt `a`: committed, failed, superseded, or None (it may still land)."""
    kind, name = a.get('kind'), a.get('name')
    if kind not in KINDS or not isinstance(name, str) or not DNS_SUBDOMAIN.match(name):
        return None
    live = get_object(g, ns, kind, name)
    meta = (live or {}).get('metadata') or {}
    stamp = (meta.get('annotations') or {}).get(ATTEMPT_ANNOTATION)
    verb = a.get('verb')
    if verb == 'create':
        # A create's only precondition is that the name is absent, and that can hold again: a 404 or another
        # object holding the name proves nothing about a create still in flight. Only its own stamp does
        # (or the server's definite answer, which Attempts.run takes when it comes).
        return 'committed' if live is not None and stamp == a['attempt'] else None
    if verb == 'patch':
        if live is None or meta.get('uid') != a.get('uid'):
            return 'superseded'
        if stamp == a['attempt']:
            return 'committed'
        return 'superseded' if meta.get('resourceVersion') != a.get('rv') else None
    if verb == 'delete':
        if live is None or meta.get('uid') != a.get('uid'):
            return 'committed'
        return 'superseded' if meta.get('resourceVersion') != a.get('rv') else None
    return None


class Attempts:
    """The attempts of one fenced run, under its slot's token."""

    def __init__(self, g, ns, lease_id, token):
        self.g, self.ns, self.lease_id, self.token = g, ns, lease_id, token

    def begin(self, attempt, verb, kind, name, uid=None, rv=None):
        args = ['k8s', 'lease', 'attempt', 'begin', self.lease_id, self.token, '--attempt', attempt, '--verb', verb,
                '--kind', kind, '--name', name]
        if uid:
            args += ['--uid', uid]
        if rv:
            args += ['--rv', rv]
        res = bb(*args)
        if res.offline:
            raise lease_unavailable(res, 'attempt begin')
        if not res.ok:
            raise Refusal(res.code, f'attempt begin for {verb} {kind}/{name}: {res.error}')

    def resolve(self, attempt, outcome):
        # A lost report leaves the attempt open; the next run resolves it again from storage.
        return bb('k8s', 'lease', 'attempt', 'resolve', self.lease_id, attempt, '--outcome', outcome).ok

    def run(self, attempt, verb, kind, name, uid, rv, send):
        """Record, send, resolve. Returns send()'s result, or None when an unknown outcome proved committed."""
        self.begin(attempt, verb, kind, name, uid, rv)
        try:
            result = send()
        except Refusal as e:
            if isinstance(e, WriteConflict) or definite(getattr(e, 'raw', '') or ''):
                self.resolve(attempt, 'failed')
                raise
            outcome = resolve_attempt(self.g, self.ns, {'attempt': attempt, 'verb': verb, 'kind': kind, 'name': name,
                                                        'uid': uid, 'rv': rv})
            if outcome is None:
                raise Refusal('write_unresolved', f'{verb} {kind}/{name} may still land: its outcome is unknown ({e}). '
                                                  'The lease keeps its GPUs, and its next write waits until k8s-guard '
                                                  'observes this one', attempt=attempt)
            self.resolve(attempt, outcome)
            if outcome == 'committed':
                return None
            raise
        self.resolve(attempt, 'committed')
        return result


def settle_attempts(g, view, lease):
    """Resolve the lease's open attempts from storage before a new write; refuse while one stays unknown."""
    left = []
    for a in lease.get('open_attempts') or []:
        outcome = resolve_attempt(g, view.name, a)
        if outcome is None:
            left.append(f'{a.get("verb")} {a.get("kind")}/{a.get("name")}')
            continue
        bb('k8s', 'lease', 'attempt', 'resolve', view.lease_id, a['attempt'], '--outcome', outcome)
    if left:
        raise Refusal('attempt_unresolved', f'lease {view.lease_id} has a write whose outcome is still unknown '
                                            f'({", ".join(left)}); it may land, so no new write starts until it is '
                                            'observed')


def fenced(g, view, body):
    """Run body(lease, slot) inside the lease's one operation slot; with no lease, body(None, None)."""
    if not view.lease_id:
        if view.claimed:
            raise Refusal('namespace_not_claimed', f'{view.name} has no claim: no writes, CPU-only included')
        return body(None, None)
    lease = lease_for_write(g, view)
    settle_attempts(g, view, lease)
    res = bb('k8s', 'lease', 'op', 'begin', view.lease_id)
    if res.offline:
        raise lease_unavailable(res, 'op begin')
    if not res.ok:
        raise Refusal(res.code, f'op begin on {view.lease_id}: {res.error}')
    token, deadline = res.value.get('token'), res.value.get('deadline')
    if not isinstance(token, str) or not isinstance(deadline, str):
        raise Refusal('lease_invalid', 'op begin returned no token or deadline')
    slot = Slot(view.lease_id, token, parse_time(deadline, 'the slot deadline'))
    slot.attempts = Attempts(g, view.name, view.lease_id, token)
    error = None
    try:
        result = body(lease, slot)
    except Exception as e:  # end the slot whatever happened
        error, result = e, None
    end = bb('k8s', 'lease', 'op', 'end', view.lease_id, token)
    state = end.value.get('state') if end.ok else None
    if state is not None and state != 'active':
        # The lease was revoked while we held the slot. A failed or timed-out apply may still have
        # landed, so undo at once whatever the write's own outcome, then say so.
        try:
            expired = do_expire(g, view.name, uid=view.uid, lease_id=view.lease_id)
            detail = f'scaled {len(expired["scaled"])} DGDs to 0'
        except Refusal as e:
            detail = f'expire failed ({e.code}): {e}'
        if error is not None:
            detail += f'; the write itself failed ({getattr(error, "code", type(error).__name__)}): {error}'
        raise Refusal('lease_revoked', f'lease {view.lease_id} is {state} after the write; {detail}',
                      result=result)
    if error is not None:
        raise error
    if not end.ok:
        raise Refusal('op_end_failed', f'the write landed, but op end failed: {end.error}; the slot frees at its '
                                       'deadline', result=result)
    return result


# --- teardown authority -----------------------------------------------------------------

def teardown_authority(g, view, uid_arg, lease_arg):
    """expire and down by anyone: (a) the plugin says revoking or releasing; (b) offline, past expires-at.

    A claimed namespace has only (a): it keeps no expiry of its own, and no offline path may destroy in it.
    """
    lease_id = lease_arg or view.lease_id
    if view.claimed:
        if not lease_id:
            raise Refusal('lease_required', f'{view.name} is claimed: teardown names its lease with --lease')
        res = lease_show(lease_id)
        if res.offline:
            raise lease_unavailable(res, f'lease {lease_id}; a claimed namespace has no offline teardown')
    if lease_id:
        res = lease_show(lease_id)
        if res.ok:
            lease = res.value
            wrong = [f'{k} {lease[k]!r}, not {want!r}' for k, want in (
                ('cluster', g.cluster), ('namespace', view.name), ('uid', view.uid)) if lease[k] != want]
            if wrong:
                raise Refusal('lease_mismatch', f'lease {lease_id} is not this namespace\'s: ' + '; '.join(wrong))
            if lease['state'] in LIVE:
                return f'lease {lease_id} is {lease["state"]}'
            if lease['state'] == 'active':
                raise Refusal('lease_active', f'lease {lease_id} is active; only its owner\'s down may end it')
            # released or torn-down: the plugin answered, so rule (b), which is for an unreachable plugin,
            # does not apply, and the plugin no longer vouches for this namespace.
            raise Refusal('lease_ended', f'lease {lease_id} is {lease["state"]}; the plugin gives no teardown '
                                         'authority for it')
        elif not res.offline:
            raise Refusal(res.code, f'lease {lease_id}: {res.error}')
    if not uid_arg:
        raise Refusal('uid_required', 'without the plugin\'s word, teardown needs --uid from the ledger')
    expires = view.expires_at()
    if not expires:
        raise Refusal('not_expired', f'{view.name} has no expiry')
    if parse_time(expires, 'expires-at') > now():
        raise Refusal('not_expired', f'{view.name} expires at {expires}')
    return f'{view.name} expired at {expires}'


def check_uid(view, uid_arg):
    if uid_arg and uid_arg != view.uid:
        raise Refusal('uid_mismatch', f'{view.name} has UID {view.uid}, not {uid_arg}: it was re-created')



# --- writes that carry their ownership checks ------------------------------------------
#
# A read before a write proves nothing about the object the write reaches: it can change in between.
# So every write carries its checks to the server (references/k8s-guard.md, "Ownership on the mutation"):
# absence is a create-only POST, which the server refuses with AlreadyExists if anything took the name;
# presence is a JSON Patch whose first operations test the UID, the resourceVersion and the identity
# label read; a delete carries both UID and resourceVersion in DeleteOptions.preconditions. kubectl
# apply is never a write: its merge patch omits an unchanged resourceVersion, so it fences nothing.

class WriteConflict(Refusal):
    """The server refused a write because the object is no longer the one read. Re-read and re-check."""

    def __init__(self, what, err):
        super().__init__('write_conflict', f'{what} changed under the write: {clip(err, 300)}')


CONFLICTS = ('AlreadyExists', 'Conflict', 'testing value', 'test operation', 'the object has been modified',
             'Precondition failed')


def is_conflict(err):
    return any(m in err for m in CONFLICTS) or is_not_found(err)


def esc(name):
    return str(name).replace('~', '~0').replace('/', '~1')


def get_object(g, ns, kind, name):
    resource = KINDS[kind][0]
    obj = g.kc.json('get', f'{resource}/{name}', '-n', ns, '-o', 'json', not_found=MISSING)
    return None if obj is MISSING else obj


def rest_path(obj, ns):
    plural = KINDS[obj['kind']][1]
    api = obj.get('apiVersion') or 'v1'
    base = '/api/v1' if api == 'v1' else f'/apis/{api}'
    return f'{base}/namespaces/{ns}/{plural}/{obj["metadata"]["name"]}'


def patch_target(obj):
    plural = KINDS[obj['kind']][1]
    api = obj.get('apiVersion') or 'v1'
    if api == 'v1':
        return f'{plural}/{obj["metadata"]["name"]}'
    group, _, version = api.partition('/')
    return f'{plural}.{version}.{group}/{obj["metadata"]["name"]}'


def labels_of(obj):
    return (obj.get('metadata') or {}).get('labels') or {}


def owns(live, lease_id, uid, claimed, unstamped=False):
    """Whether the live object is one this write may change, and the label its patch tests to prove it.

    In a claimed namespace only an object stamped with this lease is ours. In a namespace the guard
    created, an object stamped with this lease, or with this namespace instance and no lease. With
    `unstamped` (owner deletes in a namespace the guard created, for the leftovers a DGD delete leaves),
    also an object with no stamp at all. A patch never adopts an unstamped object: a controller may own it.
    """
    labels = labels_of(live)
    have = labels.get(LEASE_LABEL)
    if claimed or (lease_id and have is not None):
        return (have == lease_id, LEASE_LABEL)
    if have is not None:
        return (False, LEASE_LABEL)
    if NS_UID_LABEL in labels:
        return (labels[NS_UID_LABEL] == uid, NS_UID_LABEL)
    return (unstamped, None)


def identity_tests(live, label):
    meta = live['metadata']
    ops = [{'op': 'test', 'path': '/metadata/uid', 'value': meta['uid']},
           {'op': 'test', 'path': '/metadata/resourceVersion', 'value': meta['resourceVersion']}]
    if label is not None:
        ops.append({'op': 'test', 'path': '/metadata/labels/' + esc(label), 'value': labels_of(live)[label]})
    return ops


def edit_ops(live, item):
    """The patch's edits: every label and annotation the manifest names, and each field it gives.

    Under spec, each top-level field is replaced on its own, so fields the server assigned (a Service's
    clusterIP) stay. Fields the manifest drops are not removed.
    """
    ops = []
    meta = item.get('metadata') or {}
    for section in ('labels', 'annotations'):
        want = meta.get(section) or {}
        have = (live.get('metadata') or {}).get(section)
        if not want:
            continue
        if not isinstance(have, dict):
            ops.append({'op': 'add', 'path': f'/metadata/{section}', 'value': want})
            continue
        ops += [{'op': 'add', 'path': f'/metadata/{section}/{esc(k)}', 'value': v} for k, v in want.items()]
    for field, value in item.items():
        if field in ('apiVersion', 'kind', 'metadata', 'status'):
            continue
        if field == 'spec' and isinstance(value, dict) and isinstance(live.get('spec'), dict):
            ops += [{'op': 'add', 'path': f'/spec/{esc(k)}', 'value': v} for k, v in value.items()]
        else:
            ops.append({'op': 'add', 'path': f'/{esc(field)}', 'value': value})
    return ops


class Write:
    """One planned write: a create of `item`, or a patch of `live` with `ops`."""

    def __init__(self, item, live, ops):
        self.item, self.live, self.ops = item, live, ops
        self.attempt = None
        self.name = f'{item["kind"]}/{item["metadata"]["name"]}'

    def args(self, ns, dry):
        extra = ['--dry-run=server'] if dry else [f'--request-timeout={APPLY_REQUEST_TIMEOUT}s']
        if self.live is None:
            return ['create', '-f', '-', '-n', ns, '-o', 'json', *extra], json.dumps(self.item)
        return (['patch', patch_target(self.live), '-n', ns, '--type=json', '-p', json.dumps(self.ops), '-o', 'json',
                 *extra], None)

    def send(self, g, ns, dry, timeout=KUBECTL_TIMEOUT):
        args, body = self.args(ns, dry)
        rc, out, err = g.kc.run(*args, input=body, timeout=timeout)
        if rc != 0:
            if is_conflict(err):
                raise WriteConflict(self.name, err)
            raise kubectl_error(tuple(args[:2]) + (self.name,), rc, err)
        try:
            return json.loads(out)
        except json.JSONDecodeError:
            raise Refusal('kubectl_error', f'kubectl {args[0]} {self.name} printed no JSON')


def plan_write(g, ns, item, lease_id, uid, claimed):
    live = get_object(g, ns, item['kind'], item['metadata']['name'])
    if live is None:
        return Write(item, None, None)
    ok, label = owns(live, lease_id, uid, claimed)
    if not ok:
        raise Refusal('object_not_yours', f'{item["kind"]}/{item["metadata"]["name"]} exists and is not this '
                                          f'lease\'s ({LEASE_LABEL}={labels_of(live).get(LEASE_LABEL) or "none"}); '
                                          'left alone')
    return Write(item, live, identity_tests(live, label) + edit_ops(live, item))


def delete_owned(g, ns, obj, still_ours, timeout=KUBECTL_TIMEOUT, attempts=None):
    """Delete `obj`, the object as it was listed or read, if it is still that object and still ours.

    Its identity is the UID it was listed with. Before every send, not only after a conflict, the object
    is read again and must still have that UID and pass still_ours (its lease label): DeleteOptions can
    test a UID and a resourceVersion but no label, and a fresh read is never trusted as the identity.
    The delete then carries the listed UID and the resourceVersion just read, so a change after the read
    is refused by the server. On a conflict, read and check again, a bounded number of times.

    Returns 'deleted' or 'gone' (nothing left to delete), or raises object_not_yours when it changed
    hands. Under a slot each delete is an attempt.
    """
    kind, name = obj['kind'], obj['metadata']['name']
    listed_uid = obj['metadata']['uid']
    for _ in range(WRITE_ROUNDS):
        live = get_object(g, ns, kind, name)
        if live is None:
            return 'gone'
        if live['metadata'].get('uid') != listed_uid or not still_ours(live):
            raise Refusal('object_not_yours', f'{kind}/{name} changed hands after it was listed (UID '
                                              f'{live["metadata"].get("uid")}, {LEASE_LABEL}='
                                              f'{labels_of(live).get(LEASE_LABEL) or "none"}); left alone')
        version = live['metadata']['resourceVersion']
        options = {'kind': 'DeleteOptions', 'apiVersion': 'v1',
                   'preconditions': {'uid': listed_uid, 'resourceVersion': version}}
        if kind == 'Job':
            # Otherwise the Job's Pods are orphaned; they carry the lease label, so teardown would wait
            # for the Job's 24-hour retention before the namespace could be called done.
            options['propagationPolicy'] = 'Background'
        body = json.dumps(options)

        def send(body=body):
            rc, out, err = g.kc.run('delete', '--raw', rest_path(obj, ns), '-f', '-', input=body, timeout=timeout)
            if rc != 0:
                if is_not_found(err) or is_conflict(err):
                    raise WriteConflict(f'{kind}/{name}', err)
                raise kubectl_error(('delete', kind, name), rc, err)
            return 'deleted'

        try:
            if attempts:
                attempts.run(new_attempt_id(), 'delete', kind, name, listed_uid, version, send)
            else:
                send()
            return 'deleted'
        except WriteConflict:
            continue  # read and check again
    raise Refusal('write_conflict', f'{kind}/{name} changed under every delete; try again')


# --- commands -----------------------------------------------------------------------

def cmd_inspect(g, a):
    ns = g.ns_name(a.namespace)
    view = NsView(g, ns)
    dgds, pods = g.dgds(ns), g.pods(ns)
    pod_total, gpu_pods = gpu_pod_summary(pods)
    return {'namespace': ns, 'uid': view.uid, 'thread': view.thread, 'expires_at': view.expires_at(),
            'dgd_gpus': sum(dgd_gpus(d) for d in dgds), 'pod_gpus': pod_total,
            'gpu_type': g.profile.get('gpu_type'), 'gpu_pods_left': gpu_pods,
            'allocation': allocation(dgds, pods), 'lease_id': view.lease_id, 'cluster': g.cluster,
            'developer': view.labels.get(DEVELOPER_LABEL), 'agent_rbac': view.labels.get(AGENT_RBAC_LABEL)}


def cmd_ns_create(g, a):
    g.require_writable()
    thread = g.require_thread()
    if not DNS_LABEL.match(a.purpose):
        raise Refusal('usage', f'purpose {a.purpose!r} must be lower-case letters, digits and -', status=2)
    if not re.match(r'^[0-9]{1,10}$', a.issue):
        raise Refusal('usage', f'--issue {a.issue!r} must be the issue number', status=2)
    hours = hours_arg(a.hours, MAX_NS_HOURS)
    # A random suffix from the CSPRNG: a name is never made twice, so no namespace is ever re-created
    # under a name an earlier one had, and a name identifies one namespace instance.
    suffix = ''.join(secrets.choice('abcdefghijklmnopqrstuvwxyz0123456789') for _ in range(10))
    ns = f'{g.bot["namespace_prefix"]}{a.issue}-{a.purpose}-{suffix}'
    if len(ns) > 63:
        raise Refusal('usage', f'{ns} is longer than 63 characters; shorten the purpose', status=2)
    developer = g.bot['developer']
    expires = rfc3339(now() + timedelta(hours=hours))
    manifest = {'apiVersion': 'v1', 'kind': 'Namespace', 'metadata': {
        'name': ns,
        'labels': {'owner': developer, 'dynamo.nvidia.com/developer': developer,
                   'dynamo.nvidia.com/developer-agent-rbac': 'true', THREAD_LABEL: thread, ISSUE_LABEL: a.issue},
        'annotations': {EXPIRES_ANNOTATION: expires}}}
    # create, never apply: the server refuses a name that exists, so a namespace is never adopted.
    rc, out, err = g.kc.run('create', '-f', '-', '-o', 'json', input=json.dumps(manifest))
    if rc != 0:
        if 'AlreadyExists' in err:
            raise Refusal('namespace_exists', f'{ns} already exists; namespaces are never adopted')
        if 'Forbidden' in err and 'namespaces' in err:
            # The bot's grant ends at its RoleBindings inside our namespaces: it cannot create one.
            premade = g.bot.get('premade_namespace')
            hint = (f'claim the pre-made namespace with `k8s-guard --context {g.context} -n {premade} ns claim '
                    '--gpus <n> --hours <h>`' if premade else
                    'this cluster needs a pre-made namespace: set bot.premade_namespace in the profiles and use '
                    '`k8s-guard ns claim`')
            raise Refusal('namespace_create_denied', f'the bot may not create namespaces on {g.cluster}; {hint}')
        raise kubectl_error(('create', 'namespace', ns), rc, err)
    uid = json.loads(out)['metadata']['uid']
    g.record(ns, f'Namespace/{ns}', 0, 'up', uid=uid, issue=a.issue, created=True)
    return {'namespace': ns, 'uid': uid, 'expires_at': expires, 'cluster': g.cluster}


def cmd_ns_claim(g, a):
    """Claim the profile's pre-made namespace for this thread with a k8s-leases lease.

    The bot cannot create, label or delete it, so the lease's row in k8s-leases is the only authority:
    the plugin takes the owner from the calling thread and checks the exact profile name, both labels
    and the live UID on a trusted host. The request id is kept in the thread ledger before the call, so
    a retry after a lost reply gets the same outcome. Only --gpus and --hours are terms the caller can
    change, so a pending request blocks a retry only when one of them differs. The claim is recorded
    against the UID its request named, so a namespace re-created under the same name is left alone.
    Nothing here writes to the cluster.
    """
    g.require_writable()
    g.require_thread()
    if not g.premade:
        raise Refusal('premade_namespace_unset', f'the profiles name no pre-made namespace (bot.premade_namespace); '
                                                 f'there is nothing to claim on {g.cluster}')
    ns = g.ns_name()
    if ns != g.premade:
        raise Refusal('namespace_not_premade', f'{ns} is not the pre-made namespace {g.premade}; only it is claimed')
    if not re.match(r'^[1-9][0-9]{0,3}$', a.gpus):
        raise Refusal('usage', '--gpus must be a whole number from 1', status=2)
    hours_arg(a.hours, math.inf)  # the plugin holds the limit
    view = NsView(g, ns, claimed=True)
    if view.labels.get(DEVELOPER_LABEL) != g.bot['developer'] or view.labels.get(AGENT_RBAC_LABEL) != 'true':
        raise Refusal('namespace_not_ours', f'{ns} lacks {DEVELOPER_LABEL}={g.bot["developer"]} or '
                                            f'{AGENT_RBAC_LABEL}=true')
    # Only what the caller can set can make its retry ask with other terms: the UID is not a term, and ops
    # re-creating the namespace must not strand a pending request no flag value could clear.
    terms = {'claim_gpus': a.gpus, 'claim_hours': a.hours}
    lines = g.claim_lines(ns)
    last = lines[-1] if lines else {}
    pending = last.get('direction') == 'claim-request' and REQUEST_ID.match(str(last.get('request')))
    if pending and not all(last.get(k) == v for k, v in terms.items()):
        # That request may have committed. Asking with other terms would make a new request the plugin
        # refuses while this thread's own lease may stand unnamed in its ledger.
        raise Refusal('claim_pending', f'the last claim of {ns} (request {last["request"]}: --gpus '
                                       f'{last.get("claim_gpus")} --hours {last.get("claim_hours")}) has no known '
                                       'outcome; run ns claim again with those --gpus and --hours to learn it')
    if pending:
        # The last request has no known outcome (its reply was lost, or an error came after it): ask again
        # with it. That is the one call that learns the outcome, whether or not the namespace was
        # re-created since, and the plugin replays a claim it committed.
        request_uid, request, replaces = last.get('uid'), last['request'], last.get('replaces') or 'none'
    else:
        request_uid = view.uid
        request, replaces = new_claim_request(g, ns, request_uid, a.gpus, a.hours)
    # A pending request is replayed with the UID it named. The plugin replays a committed request before it
    # looks at the UID; one it never committed gets a full fresh claim and must see that old UID, so it is
    # refused instead of granting a lease this ledger's claim line would then make unwritable.
    res = ask_claim(g, ns, request, replaces, request_uid or view.uid, a.gpus, a.hours)
    if not res.ok and res.code in CLAIM_REFUSALS and pending:
        # The replay answered: the pending request was refused, so this thread holds no lease of ns. One
        # fresh request may follow in the same run, naming the live UID.
        g.record(ns, f'Claim/{ns}', 0, 'claim-refused', request=request, code=res.code)
        request_uid = view.uid
        request, replaces = new_claim_request(g, ns, request_uid, a.gpus, a.hours)
        res = ask_claim(g, ns, request, replaces, view.uid, a.gpus, a.hours)
    if not res.ok:
        if res.code in CLAIM_REFUSALS:
            g.record(ns, f'Claim/{ns}', 0, 'claim-refused', request=request, code=res.code)
            raise Refusal(res.code, f'the plugin refused the claim: {res.error}')
        # Any other error may have come after the claim committed: keep the request, so a retry learns it.
        raise Refusal(res.code, f'the claim\'s outcome is unknown ({res.error}); run ns claim again with the same '
                                '--gpus and --hours, which asks with the same request')
    lease_id, expires = res.value.get('lease_id'), res.value.get('expires_at')
    if not isinstance(lease_id, str) or not LEASE_ID.match(lease_id) or not isinstance(expires, str):
        raise Refusal('lease_invalid', 'acquire returned no lease id or expiry')
    g.record(ns, f'Claim/{ns}', 0, 'claim', uid=request_uid, lease=lease_id, request=request)
    return {'lease_id': lease_id, 'expires_at': expires, 'namespace': ns, 'claimed': True,
            'state': res.value.get('state', 'active'), 'pod_label': {LEASE_LABEL: lease_id},
            'pod_affinity': {'podAffinity': {'requiredDuringSchedulingIgnoredDuringExecution': [{
                'labelSelector': {'matchLabels': {LEASE_LABEL: lease_id}}, 'topologyKey': HOSTNAME_TOPOLOGY}]}}}


def new_claim_request(g, ns, uid, gpus, hours):
    """One new claim request for ns, recorded in the ledger before any call: its id and its predecessor."""
    latest = bb('k8s', 'lease', 'latest', '--cluster', g.cluster, '--namespace', ns)
    if latest.offline:
        raise lease_unavailable(latest, 'lease latest')
    if not latest.ok:
        raise Refusal(latest.code, f'lease latest: {latest.error}')
    prior = latest.value.get('lease_id')
    replaces = prior if isinstance(prior, str) and LEASE_ID.match(prior) else 'none'
    request = 'req_' + secrets.token_hex(12)
    g.record(ns, f'Claim/{ns}', 0, 'claim-request', request=request, replaces=replaces, uid=uid,
             claim_gpus=gpus, claim_hours=hours)
    return request, replaces


def ask_claim(g, ns, request, replaces, uid, gpus, hours):
    """Ask the plugin for one claim, once: the request it names decides a replay's answer."""
    res = bb('k8s', 'lease', 'acquire', '--claim', '--request', request, '--replaces', replaces, '--cluster',
             g.cluster, '--namespace', ns, '--uid', uid, '--gpu-type', g.profile['gpu_type'], '--gpus', gpus,
             '--hours', hours)
    if res.offline:
        raise lease_unavailable(res, 'acquire')
    return res


def hours_arg(text, maximum):
    try:
        hours = float(text)
    except ValueError:
        hours = math.nan
    if not math.isfinite(hours) or hours <= 0 or hours > maximum:
        raise Refusal('usage', f'--hours must be more than 0 and at most {maximum}', status=2)
    return hours


def cmd_lease_acquire(g, a):
    g.require_writable()
    ns, view = g.owned()
    if view.record is not None:
        raise Refusal('lease_exists', f'{ns} already has a lease record ({view.lease_id}); a namespace gets one lease')
    if not re.match(r'^[1-9][0-9]{0,3}$', a.gpus):
        raise Refusal('usage', '--gpus must be a whole number from 1', status=2)
    hours_arg(a.hours, math.inf)  # the plugin holds the limit
    res = bb('k8s', 'lease', 'acquire', '--cluster', g.cluster, '--namespace', ns, '--uid', view.uid,
             '--thread', g.thread, '--gpu-type', g.profile['gpu_type'], '--gpus', a.gpus, '--hours', a.hours)
    if res.offline:
        raise lease_unavailable(res, 'acquire')
    if not res.ok:
        raise Refusal(res.code, f'the plugin refused the lease: {res.error}')
    lease_id, expires = res.value.get('lease_id'), res.value.get('expires_at')
    if not isinstance(lease_id, str) or not LEASE_ID.match(lease_id) or not isinstance(expires, str):
        raise Refusal('lease_invalid', 'acquire returned no lease id or expiry')
    parse_time(expires, 'the lease expiry')
    cm = {'apiVersion': 'v1', 'kind': 'ConfigMap',
          'metadata': {'name': LEASE_RECORD, 'namespace': ns, 'labels': {NS_UID_LABEL: view.uid}},
          'data': {'lease_id': lease_id, 'expires_at': expires, 'thread': g.thread, 'uid': view.uid}}
    try:
        confirm_uid(g, ns, view.uid)
        rc, out, err = g.kc.run('create', '-f', '-', '-n', ns, '-o', 'json', input=json.dumps(cm))
    except Refusal as e:
        rc, err = 1, f'{e.code}: {e}'
    if rc != 0:
        raise Refusal('lease_record_failed', f'lease {lease_id} is granted, but its record could not be written '
                                             f'({clip(err, 300)}); run `bb k8s lease release {lease_id}`, '
                                             'which tears the namespace down', lease_id=lease_id)
    g.record(ns, f'ConfigMap/{LEASE_RECORD}', 0, 'up', uid=view.uid, lease=lease_id, issue=view.issue)
    return {'lease_id': lease_id, 'expires_at': expires, 'namespace': ns,
            'pod_label': {LEASE_LABEL: lease_id},
            'pod_affinity': {'podAffinity': {'requiredDuringSchedulingIgnoredDuringExecution': [{
                'labelSelector': {'matchLabels': {LEASE_LABEL: lease_id}}, 'topologyKey': HOSTNAME_TOPOLOGY}]}}}


def cmd_secret(g, a):
    g.require_writable()
    # The push credential is readable by everyone in Access-dynamo-clusters-dev once it is in the namespace,
    # so creating it is a stated step (--exposure-accepted), not something a thread does because it holds a
    # claim. The flag is a tripwire, not an authority check: the exposure's acceptance is the owner's, and a
    # cluster policy is the boundary (a follow-up, not this guard).
    if a.which == 'ngc-push' and not a.exposure_accepted:
        raise Refusal('push_not_approved', 'nvcr-push puts the push credential in the namespace, where every member '
                                           'of Access-dynamo-clusters-dev can read it; pass --exposure-accepted only '
                                           'after the owner has accepted that exposure')
    if a.exposure_accepted and a.which != 'ngc-push':
        raise Refusal('usage', '--exposure-accepted is only for `secret ngc-push`', status=2)
    if a.which == 'git':
        if not a.repo:
            raise Refusal('usage', 'secret git needs --repo <owner>/<repo>', status=2)
        spec = git_secret_spec(a.repo)
    else:
        if a.repo:
            raise Refusal('usage', f'--repo is only for `secret git`, not `secret {a.which}`', status=2)
        spec = SECRETS[a.which]
    ns, view = g.owned()

    def body(lease, slot):
        if lease is None and allocation(g.dgds(ns), g.pods(ns)) > 0:
            raise Refusal('lease_required', f'{ns} holds GPUs but has no lease')
        try:
            p = subprocess.run(['fleet', 'secret', 'get', spec['ref']], capture_output=True, text=True,
                               stdin=subprocess.DEVNULL, timeout=FLEET_TIMEOUT)
        except (FileNotFoundError, subprocess.TimeoutExpired) as e:
            raise Refusal('secret_unavailable', f'fleet secret get failed: {type(e).__name__}')
        # A token is stored without its one trailing newline. An OpenSSH private key needs the newline that
        # ends its last line, or ssh refuses it (`error in libcrypto`), so git keys keep exactly one.
        raw = p.stdout
        if a.which == 'git':
            value = raw.rstrip('\n') + '\n' if raw.strip() else ''
        else:
            value = raw[:-1] if raw.endswith('\n') else raw
        if value:
            remember_secret(value)
            remember_secret(value.rstrip('\n'))
        if p.returncode != 0 or not value:
            raise Refusal('secret_unavailable', f'fleet secret get exited {p.returncode}: {clip(p.stderr, 200)}')
        if a.which in ('ngc', 'ngc-push'):
            auth = base64.b64encode(f'$oauthtoken:{value}'.encode()).decode()
            payload = json.dumps({'auths': {'nvcr.io': {'username': '$oauthtoken', 'password': value, 'auth': auth}}})
            remember_secret(payload)
        else:
            payload = value
        labels = {NS_UID_LABEL: view.uid, **({LEASE_LABEL: lease['lease_id']} if lease else {})}
        attempt = new_attempt_id() if slot else None
        # Each object carries its own attempt id: a create resolves only from the stamp it was recorded
        # with, so a ConfigMap that inherited the Secret's id could never resolve.
        cm_attempt = new_attempt_id() if (slot and a.which == 'git') else None

        def metadata(name, attempt_id):
            meta = {'name': name, 'namespace': ns, 'labels': labels}
            if attempt_id:
                meta['annotations'] = {ATTEMPT_ANNOTATION: attempt_id}
            return meta

        obj = {'apiVersion': 'v1', 'kind': 'Secret', 'type': spec.get('type', 'Opaque'),
               'metadata': metadata(spec['name'], attempt),
               'stringData': {spec['key']: payload}}
        # The pinned host key travels beside the key: the clone's UserKnownHostsFile needs it, and ssh
        # refuses a host it cannot verify.
        known_hosts = {'apiVersion': 'v1', 'kind': 'ConfigMap',
                       'metadata': metadata(KNOWN_HOSTS_CONFIGMAP, cm_attempt),
                       'data': {'known_hosts': GITHUB_KNOWN_HOSTS}} if a.which == 'git' else None
        confirm_uid(g, ns, view.uid)
        if slot:
            slot.check()

        def create(item, attempt_id):
            def send():
                # Create, never apply: the server refuses a name that exists. The value goes on stdin only.
                rc, out, err = g.kc.run('create', '-f', '-', '-n', ns, '-o', 'json', input=json.dumps(item))
                if rc != 0:
                    if 'AlreadyExists' in err:
                        code = 'secret_exists' if item['kind'] == 'Secret' else 'object_exists'
                        e = Refusal(code, f'{item["kind"].lower()} {item["metadata"]["name"]} already exists '
                                          f'in {ns}')
                        e.raw = err
                        raise e
                    raise kubectl_error(('create', item['kind'].lower(), item['metadata']['name']), rc, err)
            if attempt_id:
                slot.attempts.run(attempt_id, 'create', item['kind'], item['metadata']['name'], None, None, send)
            else:
                send()

        create(obj, attempt)
        extra = {'exposure_accepted': True} if a.which == 'ngc-push' else {}
        g.record(ns, f'Secret/{spec["name"]}', 0, 'up', uid=view.uid, lease=view.lease_id, issue=view.issue, **extra)
        result = {'secret': spec['name'], 'namespace': ns}
        if known_hosts is not None:
            create(known_hosts, cm_attempt)
            g.record(ns, f'ConfigMap/{KNOWN_HOSTS_CONFIGMAP}', 0, 'up', uid=view.uid, lease=view.lease_id,
                     issue=view.issue)
            result['known_hosts'] = KNOWN_HOSTS_CONFIGMAP
        return result

    return fenced(g, view, body)


def stamp(g, manifest, uid, lease_id):
    """The manifest as one JSON List, each object labelled as `apply` writes it. Local: no API call.

    Every object carries the namespace instance's UID and, when the write runs under a lease, that
    lease. Teardown selects DGDs by the lease label; the UID is only an instance check.
    """
    labels = [f'{NS_UID_LABEL}={uid}'] + ([f'{LEASE_LABEL}={lease_id}'] if lease_id else [])
    rc, out, err = g.kc.run('label', '--local', '-f', '-', *labels, '--overwrite', '-o', 'json',
                            input=manifest)
    if rc != 0:
        raise Refusal('usage', f'kubectl could not read the manifest: {clip(err, 300)}', status=2)
    items, dec, i = [], json.JSONDecoder(), 0
    out = out.strip()
    try:
        while i < len(out):
            obj, i = dec.raw_decode(out, i)
            while i < len(out) and out[i].isspace():
                i += 1
            items.extend(obj.get('items') or [] if obj.get('kind') == 'List' else [obj])
    except (json.JSONDecodeError, AttributeError):
        raise Refusal('usage', 'kubectl label --local printed no JSON objects', status=2)
    if not items:
        raise Refusal('usage', 'the manifest holds no objects', status=2)
    return json.dumps({'apiVersion': 'v1', 'kind': 'List', 'items': items})


def cmd_apply(g, a):
    g.require_writable()
    try:
        manifest = Path(a.filename).read_bytes().decode()
    except (OSError, UnicodeDecodeError) as e:
        raise Refusal('usage', f'cannot read {a.filename}: {e}', status=2)
    ns, view = g.owned()

    def plan(lease_id):
        """Read each object, plan its write, dry-run that exact request, and admit what the server returned."""
        writes, objects = [], []
        for item in json.loads(stamp(g, manifest, view.uid, lease_id))['items']:
            meta = item.setdefault('metadata', {})
            where = f'{item.get("kind")}/{meta.get("name")}'
            if meta.get('namespace', ns) != ns:
                raise Refusal('kind_refused', f'{where} is not a namespaced object in {ns}')
            if (item.get('kind'), item.get('apiVersion')) not in APPLY_KINDS:
                raise Refusal('kind_refused', f'{where} ({item.get("apiVersion")}) is not an admitted kind; admitted: '
                                              'DynamoGraphDeployment, ConfigMap, ClusterIP Service')
            if not isinstance(meta.get('name'), str) or not DNS_SUBDOMAIN.match(meta['name']):
                raise Refusal('usage', f'{where} has no valid name', status=2)
            meta['namespace'] = ns
            attempt = new_attempt_id() if lease_id else None
            if attempt:
                meta.setdefault('annotations', {})[ATTEMPT_ANNOTATION] = attempt
            w = plan_write(g, ns, item, lease_id, view.uid, view.claimed)
            w.attempt = attempt
            writes.append(w)
            objects.append(w.send(g, ns, dry=True))
        if not objects:
            raise Refusal('usage', f'{a.filename} holds no objects', status=2)
        return writes, admit(objects, ns, view.uid, lease_id)

    def body(lease, slot):
        # kubectl, run locally, parses the file and stamps every object with the namespace's UID and the
        # lease it is written under; teardown of that lease selects by the lease label. Each object's write
        # is planned from a fresh read (create when absent, a tested JSON Patch when present), that same
        # request is dry-run on the server, and the checks run on what the server returned.
        lease_id = lease['lease_id'] if lease else None
        names = []
        for _ in range(WRITE_ROUNDS):
            writes, new = plan(lease_id)
            total = budget(lease, writes, new)
            confirm_uid(g, ns, view.uid)
            # One request per object, each started only with time left in the slot and stopped before it
            # ends. Any subset may land: the budget counts every subset.
            try:
                for w in writes:
                    if slot:
                        slot.check()

                    def send(w=w):
                        return w.send(g, ns, dry=False, timeout=slot.timeout() if slot else APPLY_REQUEST_TIMEOUT + 15)

                    if slot and w.attempt:
                        live = (w.live or {}).get('metadata') or {}
                        slot.attempts.run(w.attempt, 'create' if w.live is None else 'patch', w.item['kind'],
                                          w.item['metadata']['name'], live.get('uid'), live.get('resourceVersion'), send)
                    else:
                        send()
                    gpus = dgd_gpus(w.item) if w.item.get('kind') == DGD_KIND else 0
                    g.record(ns, w.name, gpus, 'up', uid=view.uid, lease=lease_id, issue=view.issue)
                    if w.name not in names:
                        names.append(w.name)
            except WriteConflict:
                continue  # something changed an object after its read: read again, admit again, budget again
            except Refusal as e:
                if names:
                    e.extra.setdefault('applied', names)
                    e.args = (f'{e}; already applied: {", ".join(names)}',)
                raise
            return {'applied': names, 'namespace': ns, 'allocation': total, 'lease': lease_id}
        raise Refusal('write_conflict', f'an object changed under each of {WRITE_ROUNDS} tries; nothing more was '
                                        'written', applied=names)

    def budget(lease, writes, new):
        current = g.dgds(ns)
        pods = g.pods(ns)
        # kubectl writes the objects one at a time and goes on after a failure, so any subset of the
        # file may land: each DGD counts at the larger of its old and new spec.
        total = budget_allocation(current, new, pods)
        state = {(d.get('metadata') or {}).get('name'): d for d in current}
        state.update({d['metadata']['name']: d for d in new})
        after = list(state.values())
        if lease is None:
            if total > 0:
                raise Refusal('lease_required', f'{ns} would hold {total} GPUs and has no lease; '
                                                'run `k8s-guard lease acquire` first', allocation=total)
        else:
            if total > lease['gpus']:
                raise Refusal('over_lease', f'{ns} would hold {total} GPUs (spec or pods, terminating included), more '
                                            f'than lease {lease["lease_id"]} grants ({lease["gpus"]})',
                              allocation=total)
            if not lease['multi_node'] and total > g.profile['gpus_per_node']:
                raise Refusal('one_node_required', f'{total} GPUs do not fit one {g.profile["gpu_type"]} node '
                                                   f'({g.profile["gpus_per_node"]}) without multi-node approval',
                              allocation=total)
            check_lease_label(new, lease)
            check_one_node(after, lease, g.profile)
            check_gpu_product(after, g.profile)
        return total

    return fenced(g, view, body)


def cmd_delete(g, a):
    g.require_writable()
    kind_text, _, name = a.target.partition('/')
    if kind_text.lower() not in DELETABLE:
        raise Refusal('kind_refused', f'{kind_text} is not a kind the guard deletes')
    resource, kind = DELETABLE[kind_text.lower()]
    if not name or not DNS_SUBDOMAIN.match(name) or len(name) > 253:
        raise Refusal('usage', f'{a.target!r} is not <kind>/<name>', status=2)
    protected = {('ConfigMap', LEASE_RECORD)}
    if g.profile.get('model_cache'):
        protected.add(('PersistentVolumeClaim', g.profile['model_cache']))
    if g.profile.get('pull_secret'):
        protected.add(('Secret', g.profile['pull_secret']))
    if (kind, name) in protected:
        raise Refusal('object_protected', f'{kind}/{name} is not deleted on its own (runbook section 10)')
    ns, view = g.owned()

    def body(lease, slot):
        # Like every owner write: an active lease and its slot, or a namespace that holds no GPUs.
        # Teardown of a namespace without that is `down` or `expire`, under their own authority.
        if lease is None and allocation(g.dgds(ns), g.pods(ns)) > 0:
            raise Refusal('lease_required', f'{ns} holds GPUs but has no lease; use `k8s-guard down`')
        lease_id = lease['lease_id'] if lease else None
        obj = get_object(g, ns, kind, name)
        if obj is None:
            raise Refusal('not_found', f'{kind}/{name} not found in {ns}')
        obj.setdefault('kind', kind)

        def mine(live):
            return owns(live, lease_id, view.uid, view.claimed, unstamped=True)[0]

        if not mine(obj):
            raise Refusal('object_not_yours', f'{kind}/{name} is not this lease\'s '
                                              f'({LEASE_LABEL}={labels_of(obj).get(LEASE_LABEL) or "none"}); left alone')
        gpus = dgd_gpus(obj) if kind == DGD_KIND else 0
        confirm_uid(g, ns, view.uid)
        if slot:
            slot.check()
        if delete_owned(g, ns, obj, mine, timeout=slot.timeout() if slot else KUBECTL_TIMEOUT,
                        attempts=slot.attempts if slot else None) == 'gone':
            raise Refusal('not_found', f'{kind}/{name} not found in {ns}')
        g.record(ns, f'{kind}/{name}', gpus, 'down', uid=view.uid, lease=view.lease_id, issue=view.issue)
        return {'deleted': f'{kind}/{name}', 'namespace': ns}

    return fenced(g, view, body)


def dgd_path(dgd, ns):
    group, _, version = dgd['apiVersion'].partition('/')
    return f'/apis/{group}/{version}/namespaces/{ns}/dynamographdeployments/{dgd["metadata"]["name"]}'


def confirm_uid(g, ns, uid):
    """Read the namespace again: the DGDs just listed must belong to the namespace whose UID was checked."""
    current = (g.get_namespace(ns).get('metadata') or {}).get('uid')
    if current != uid:
        raise Refusal('uid_mismatch', f'{ns} now has UID {current}, not {uid}: it was re-created; left alone')


def lease_dgds(g, ns, lease_id):
    """The DGDs `apply` stamped with this lease, and why there are none when there is no lease.

    apply labels every object with the lease it was written under, so teardown selects by that label.
    The namespace UID is never a selector: in a long-lived namespace it is the same for every task
    that ever applied there, so selecting by it picks up a colleague's DGD as well. The UID stays an
    instance check (confirm_uid), and each DGD's own UID is the fence its delete or patch carries.

    The lease id is the effective one: what the caller passed, else what the namespace's record says.
    The plugin's own lease state is the authority; the record is the guard's copy of it.
    """
    if not lease_id:
        return [], (f'{ns} has no lease id (no --lease and no lease record), so teardown selects no DGD')
    query = ['get', DGD_RESOURCE, '-n', ns, '-l', f'{LEASE_LABEL}={lease_id}', '-o', 'json']
    return g.kc.json(*query).get('items') or [], None


def delete_lease_dgd(g, ns, lease_id, dgd):
    """Delete one DGD of this lease, and say whether it is gone.

    DeleteOptions can test only the object's UID and resourceVersion, not a label. So the object is
    read again, its UID is checked against the one the list gave (a replacement with the same name is
    not this object, whatever its labels), its lease label is checked, and only then is the delete
    sent, under that listed UID and the resourceVersion just read. A label removed, a replacement, or
    a change between the read and the delete is refused rather than taking effect. On a conflict the
    object is read and checked again, a bounded number of times, so an unrelated status write does
    not stop a teardown that is still this lease's.

    False means the object changed into something else. `down` leaves it, and the namespace delete
    ends it with the rest.
    """
    name, listed_uid = dgd['metadata']['name'], dgd['metadata']['uid']
    for _ in range(DGD_DELETE_ATTEMPTS):
        fresh = g.kc.json('get', f'{DGD_RESOURCE}/{name}', '-n', ns, '-o', 'json', not_found=MISSING)
        if fresh is MISSING:
            return True
        meta = fresh.get('metadata') or {}
        if meta.get('uid') != listed_uid:
            return False
        if (meta.get('labels') or {}).get(LEASE_LABEL) != lease_id:
            return False
        pre = {'uid': listed_uid, 'resourceVersion': meta['resourceVersion']}
        body = {'kind': 'DeleteOptions', 'apiVersion': 'v1', 'preconditions': pre}
        rc, out, err = g.kc.run('delete', '--raw', dgd_path(fresh, ns), '-f', '-', input=json.dumps(body))
        if rc == 0 or is_not_found(err):
            return True
        if 'Precondition failed' not in err and 'Conflict' not in err:
            raise kubectl_error(('delete', 'dgd', name), rc, err)
    return False


def do_expire(g, ns, uid, lease_id):
    scaled, before = [], 0
    dgds, why_none = lease_dgds(g, ns, lease_id)
    confirm_uid(g, ns, uid)
    for d in dgds:
        try:
            before += dgd_gpus(d)
        except Refusal:
            pass  # scale it down even when it cannot be counted
        if scale_to_zero(g, ns, d, lease_id):
            scaled.append(d['metadata']['name'])
    _, left = gpu_pod_summary(g.pods(ns))
    g.record(ns, f'Namespace/{ns}', before, 'down', uid=uid, lease=lease_id)
    result = {'namespace': ns, 'scaled': scaled, 'gpu_pods_left': left}
    if why_none:
        # Nothing could be selected: say so, so an empty `scaled` is not read as success.
        result['dgds_skipped'] = why_none
    return result


def scale_to_zero(g, ns, d, lease_id):
    """Patch every replica count of `d` to 0 under its UID, version and lease label. True if a patch landed.

    A version change alone is re-read and retried; a DGD that lost the lease label or was replaced is
    no longer this lease's, and the server's refusal stands.
    """
    name = d['metadata']['name']
    for _ in range(WRITE_ROUNDS):
        ops = zero_patch(d, lease_id)
        if ops is None:
            return False
        group, _, version = d['apiVersion'].partition('/')
        res = f'dynamographdeployments.{version}.{group}/{name}'
        rc, out, err = g.kc.run('patch', res, '-n', ns, '--type=json', '-p', json.dumps(ops))
        if rc == 0:
            return True
        if is_not_found(err):
            return False
        if not is_conflict(err):
            raise kubectl_error(('patch', res), rc, err)
        live = get_object(g, ns, DGD_KIND, name)
        if live is None:
            return False
        if live['metadata'].get('uid') != d['metadata']['uid'] or labels_of(live).get(LEASE_LABEL) != lease_id:
            raise Refusal('uid_mismatch', f'{res} is no longer the object the guard read: {clip(err, 200)}')
        d = live
    raise Refusal('write_conflict', f'DGD {name} changed under every scale-to-zero; try again')


def namespace_view(g, ns, lease_arg):
    """The namespace as a teardown sees it: the pre-made one is claimed, and its lease comes from --lease."""
    if g.premade and ns == g.premade:
        return NsView(g, ns, claimed=True, lease_id=lease_arg)
    return NsView(g, ns)


def cmd_expire(g, a):
    g.require_writable()
    ns = g.ns_name(a.namespace)
    view = namespace_view(g, ns, a.lease)
    check_uid(view, a.uid)
    why = teardown_authority(g, view, a.uid, a.lease)
    return dict(do_expire(g, ns, view.uid, a.lease or view.lease_id), authority=why)


# Teardown of a claimed namespace: the roots it deletes, and everything it reads again before it says complete.
ROOT_KINDS = (DGD_KIND, 'Job', 'PodCliqueSet', 'Service', 'ConfigMap', 'Secret', 'PersistentVolumeClaim')
CHILD_RESOURCES = ('pods', 'podcliques.grove.io', 'deployments.apps', 'statefulsets.apps')


def labelled(g, ns, resource, lease_id):
    """The objects of one resource carrying this lease's label: a list, or None when it could not be read."""
    rc, out, err = g.kc.run('get', resource, '-n', ns, '-l', f'{LEASE_LABEL}={lease_id}', '-o', 'json')
    if rc != 0:
        # A resource type the server does not serve can hold nothing; any other failure is an incomplete list.
        return [] if "doesn't have a resource type" in err else None
    try:
        return json.loads(out).get('items') or []
    except json.JSONDecodeError:
        return None


def claimed_teardown(g, view, lease_id, lease):
    """Resolve the lease's open attempts, delete its roots, and read its inventory again.

    Complete only when every attempt is resolved, every root is gone or was never there, and a read made
    after the last resolution finds nothing of the lease: no root, no generated child, no pod, terminating
    or not. Otherwise teardown_incomplete, and k8s-leases keeps the GPUs charged. No Namespace request.
    """
    ns = view.name
    resolutions, unresolved = [], []
    for a in lease.get('open_attempts') or []:
        outcome = resolve_attempt(g, ns, a)
        if outcome is None:
            unresolved.append(f'{a.get("verb")} {a.get("kind")}/{a.get("name")} ({a.get("attempt")})')
        else:
            resolutions.append({'attempt': a['attempt'], 'outcome': outcome})
    protected = {(k, n) for k, n in (('PersistentVolumeClaim', g.profile.get('model_cache')),
                                      ('Secret', g.profile.get('pull_secret'))) if n}
    confirm_uid(g, ns, view.uid)
    deleted, changed_hands, unreadable = [], [], []

    def ours(live):
        return labels_of(live).get(LEASE_LABEL) == lease_id

    for kind in ROOT_KINDS:
        items = labelled(g, ns, KINDS[kind][0], lease_id)
        if items is None:
            unreadable.append(KINDS[kind][0])
            continue
        for obj in items:
            obj.setdefault('kind', kind)
            name = obj['metadata']['name']
            if (kind, name) in protected:
                continue
            try:
                if kind == DGD_KIND:
                    scale_to_zero(g, ns, obj, lease_id)
                # The listed object stays the identity; delete_owned reads it again only for its version.
                if delete_owned(g, ns, obj, ours) == 'deleted':
                    deleted.append(f'{kind}/{name}')
            except Refusal as e:
                if e.code not in ('object_not_yours', 'uid_mismatch', 'write_conflict'):
                    raise
                changed_hands.append(f'{kind}/{name}')
    left = {}
    for resource in [KINDS[k][0] for k in ROOT_KINDS] + list(CHILD_RESOURCES):
        items = labelled(g, ns, resource, lease_id)
        if items is None:
            if resource not in unreadable:
                unreadable.append(resource)
            continue
        names = [o['metadata']['name'] + (' (terminating)' if o['metadata'].get('deletionTimestamp') else '')
                 for o in items if (KINDS.get(o.get('kind'), (None,))[0], o['metadata']['name']) not in
                 {(KINDS[k][0], n) for k, n in protected}]
        if names:
            left[resource] = names
    g.record(ns, f'Claim/{ns}', 0, 'down', uid=view.uid, lease=lease_id, deleted=deleted)
    if unresolved or changed_hands or unreadable or left:
        why = '; '.join(filter(None, [
            unresolved and f'{len(unresolved)} write(s) whose outcome is unknown',
            changed_hands and f'{", ".join(changed_hands)} changed hands under the delete',
            unreadable and f'could not list {", ".join(unreadable)}',
            left and f'still there: {json.dumps(left)}']))
        raise Refusal('teardown_incomplete', f'lease {lease_id} in {ns} is not torn down: {why}; its GPUs stay '
                                             'charged and the next teardown goes on', resolutions=resolutions,
                      unresolved=unresolved, changed_hands=changed_hands, unreadable=unreadable, left=left,
                      deleted=deleted)
    return {'namespace': ns, 'lease_id': lease_id, 'complete': True, 'namespace_kept': True, 'deleted': deleted,
            'resolutions': resolutions}


def claimed_down(g, view, a):
    ns = view.name
    check_uid(view, a.uid)
    mine, _ = g.claimed_lease(ns) if (g.thread and os.environ.get('BB_THREAD_STORAGE')) else (None, None)
    lease_id = a.lease or mine
    if not lease_id:
        raise Refusal('lease_required', f'{ns} is claimed: down names its lease with --lease, or runs in the '
                                        'claiming thread')
    res = lease_show(lease_id)
    if res.offline:
        raise lease_unavailable(res, f'lease {lease_id}; a claimed namespace has no offline teardown')
    if not res.ok:
        raise Refusal(res.code, f'lease {lease_id}: {res.error}')
    lease = res.value
    wrong = [f'{k} {lease[k]!r}, not {want!r}' for k, want in (
        ('cluster', g.cluster), ('namespace', ns), ('uid', view.uid)) if lease[k] != want]
    if wrong:
        raise Refusal('lease_mismatch', f'lease {lease_id} is not this namespace\'s: ' + '; '.join(wrong))
    if lease_id == mine and lease['thread'] == g.thread and lease['state'] in ('active',) + LIVE:
        # The owner returns the lease. k8s-leases runs the teardown on a trusted host and completes it there;
        # only that completion returns the GPUs.
        state = lease['state']
        if state == 'active':
            rel = bb('k8s', 'lease', 'release', lease_id)
            if not rel.ok:
                raise Refusal('lease_release_failed', f'could not release {lease_id}: {rel.error}')
            state = rel.value.get('state', 'releasing')
        return {'namespace': ns, 'lease_id': lease_id, 'state': state, 'namespace_kept': True,
                'authority': f'owner; released {lease_id}',
                'teardown': 'complete' if state == 'released' else 'k8s-leases tears the lease down and returns '
                                                                   'its GPUs when nothing of it is left'}
    if lease['state'] == 'active':
        raise Refusal('lease_active', f'lease {lease_id} is active; only its owner\'s down may end it')
    if lease['state'] not in LIVE:
        raise Refusal('lease_ended', f'lease {lease_id} is {lease["state"]}; the plugin gives no teardown authority')
    return claimed_teardown(g, view, lease_id, lease)


def cmd_down(g, a):
    g.require_writable()
    ns = g.ns_name(a.namespace)
    view = namespace_view(g, ns, a.lease)
    if view.claimed:
        return claimed_down(g, view, a)
    check_uid(view, a.uid)
    lease_id = a.lease or view.lease_id
    owner = False
    if g.thread and view.thread == g.thread and os.environ.get('BB_THREAD_STORAGE'):
        # The owner is the thread whose label the namespace carries and whose ledger created it
        # with this UID. Anyone else, the owner without its ledger included, needs teardown authority.
        owner = g.ledger_namespaces().get(ns) == view.uid
    if owner:
        why = 'owner'
        if lease_id:
            res = lease_show(lease_id)
            if res.ok:
                lease = res.value
                if (lease['cluster'], lease['namespace'], lease['uid']) != (g.cluster, ns, view.uid):
                    raise Refusal('lease_mismatch', f'lease {lease_id} is not this namespace\'s')
                if lease['state'] == 'active':
                    rel = bb('k8s', 'lease', 'release', lease_id)
                    if not rel.ok:
                        raise Refusal('lease_release_failed', f'could not release {lease_id}: {rel.error}')
                    why = f'owner; released {lease_id}'
            elif res.offline:
                # The owner cannot release offline; it may still tear down a namespace past its expiry (4b).
                try:
                    why = offline_owner(view)
                except Refusal as e:
                    raise Refusal('lease_release_failed', f'cannot reach the plugin to release {lease_id} ({res.error}),'
                                                          f' and {e}')
            else:
                raise Refusal(res.code, f'lease {lease_id}: {res.error}')
    else:
        why = teardown_authority(g, view, a.uid, a.lease)
    dgds, why_none = lease_dgds(g, ns, lease_id)
    confirm_uid(g, ns, view.uid)
    # The ledger line counts what this down ends: the lease's DGDs, or, with no lease to select by,
    # every DGD in the namespace, which the namespace delete below removes with it.
    counted = g.dgds(ns) if why_none else dgds
    before = 0
    for d in counted:
        try:
            before += dgd_gpus(d)
        except Refusal:
            pass
    deleted, kept = [], []
    for d in dgds:
        name = d['metadata']['name']
        if delete_lease_dgd(g, ns, lease_id, d):
            deleted.append(name)
        else:
            kept.append(name)
    wait = float(os.environ.get('K8S_GUARD_DOWN_WAIT_SECONDS', '300'))
    poll = float(os.environ.get('K8S_GUARD_POLL_SECONDS', '5'))
    give_up = time.monotonic() + wait
    # Wait, bounded, for every GPU pod in the namespace, then delete the namespace whatever is left.
    # The delete carries the UID precondition, so it can remove only this namespace instance; it stops
    # the remaining pods, including those of a stray DGD from the accepted F14 residual. Pods are not
    # matched to DGDs: names can be reused, and pods carry no reliable link to their DGD. k8s-leases
    # keeps the GPUs charged until a host reports the namespace gone.
    while True:
        _, left = gpu_pod_summary(g.pods(ns))
        remaining = give_up - time.monotonic()
        if left == 0 or remaining <= 0:
            break
        time.sleep(min(poll, remaining))  # never past the bound
    if (view.obj.get('metadata') or {}).get('deletionTimestamp'):
        # Already being deleted (an earlier down): a second delete would only be refused.
        g.record(ns, f'Namespace/{ns}', before, 'down', uid=view.uid, lease=lease_id, issue=view.issue,
                 gpu_pods_left=left)
        return down_result(ns, deleted, kept, why, left, why_none, terminating=True)
    body = json.dumps({'kind': 'DeleteOptions', 'apiVersion': 'v1', 'preconditions': {'uid': view.uid}})
    rc, out, err = g.kc.run('delete', '--raw', f'/api/v1/namespaces/{ns}', '-f', '-', input=body)
    if rc != 0 and not is_not_found(err):
        if 'Precondition failed' in err or 'UID in precondition' in err:
            raise Refusal('uid_mismatch', f'{ns} was re-created; the new namespace is left alone')
        raise kubectl_error(('delete', 'namespace', ns), rc, err)
    g.record(ns, f'Namespace/{ns}', before, 'down', uid=view.uid, lease=lease_id, issue=view.issue, deleted=True,
             gpu_pods_left=left)
    return down_result(ns, deleted, kept, why, left, why_none)


def down_result(ns, deleted, kept, why, left, why_none, terminating=False):
    """What `down` reports. `kept` names DGDs that changed away from the lease, which the namespace
    delete ends with the rest; `dgds_skipped` names why nothing was selected at all."""
    result = {'namespace': ns, 'deleted': True, 'terminating': terminating or bool(left), 'authority': why,
              'gpu_pods_left': left, 'dgds_deleted': deleted}
    if kept:
        result['dgds_kept'] = kept
    if why_none:
        result['dgds_skipped'] = why_none
    return result


def offline_owner(view):
    expires = view.expires_at()
    if not expires or parse_time(expires, 'expires-at') > now():
        raise Refusal('not_expired', f'{view.name} has not expired')
    return f'owner; plugin unreachable; {view.name} expired at {expires}'


def cmd_extend(g, a):
    g.require_writable()
    ns = g.ns_name(a.namespace)
    view = NsView(g, ns)
    check_uid(view, a.uid)
    lease_id = a.lease or view.lease_id
    if not lease_id:
        raise Refusal('lease_required', f'{ns} has no lease to extend from')
    res = lease_show(lease_id)
    if res.offline:
        raise lease_unavailable(res, f'lease {lease_id}')
    if not res.ok:
        raise Refusal(res.code, f'lease {lease_id}: {res.error}')
    lease = res.value
    if lease['state'] != 'active':
        raise Refusal('lease_not_active', f'lease {lease_id} is {lease["state"]}; it cannot be extended')
    wrong = [f'{k} {lease[k]!r}, not {want!r}' for k, want in (
        ('cluster', g.cluster), ('namespace', ns), ('uid', view.uid)) if lease[k] != want]
    if wrong:
        raise Refusal('lease_mismatch', f'lease {lease_id} is not this namespace\'s: ' + '; '.join(wrong))
    expires = lease['expires_at']
    parse_time(expires, 'the lease expiry')
    # extend only ever replaces the record `lease acquire` wrote, under the resourceVersion read
    # above. A create could land in a namespace re-created in between; a replace cannot.
    if view.record is None:
        raise Refusal('lease_record_missing', f'{ns} has no lease record; `lease acquire` writes it')
    if ((view.record.get('data') or {}).get('uid') != view.uid
            or ((view.record.get('metadata') or {}).get('labels') or {}).get(NS_UID_LABEL) != view.uid):
        raise Refusal('lease_record_mismatch', f'{ns}\'s lease record was not written for UID {view.uid}')
    if view.lease_id != lease_id:
        raise Refusal('lease_record_mismatch', f'{ns}\'s lease record names {view.lease_id}, not {lease_id}')
    stored = view.record_expires
    if stored and parse_time(stored, 'the stored expiry') >= parse_time(expires, 'the lease expiry'):
        # Monotonic: an extend that timed out can land after a later one; it must not pull the expiry back.
        # (extend refuses a revoking lease above, so it never needs to move the expiry earlier.)
        return {'namespace': ns, 'lease_id': lease_id, 'expires_at': stored, 'unchanged': True}
    cm = copy.deepcopy(view.record)
    cm['data'] = dict(cm.get('data') or {}, expires_at=expires, uid=view.uid)
    # replace carries the resourceVersion read above: a concurrent change fails with a conflict.
    confirm_uid(g, ns, view.uid)
    rc, out, err = g.kc.run('replace', '-f', '-', '-n', ns, '-o', 'json', input=json.dumps(cm))
    if rc != 0:
        code = 'record_conflict' if ('Conflict' in err or is_not_found(err)) else 'kubectl_error'
        raise Refusal(code, f'could not update {LEASE_RECORD}: {clip(err, 300)}')
    g.record(ns, f'ConfigMap/{LEASE_RECORD}', 0, 'extend', uid=view.uid, lease=lease_id, issue=view.issue)
    return {'namespace': ns, 'lease_id': lease_id, 'expires_at': expires}


WRONG_UID = '00000000-0000-4000-8000-000000000000'
# A resourceVersion no live object has: etcd revisions this low were compacted long ago.
STALE_VERSION = '1'
# What the API server says when each fence refuses a request. Any other error (Forbidden, an
# unsupported media type, a timeout) says nothing about the fence, so it does not count as held.
FENCE_REFUSALS = {
    'patch test': ('testing value', 'test operation'),
    'delete precondition': ('Precondition failed', 'UID in precondition'),
    'stale resourceVersion': ('the object has been modified',),
}


def cmd_selftest_fences(g, a):
    """Send each teardown fence once with a wrong UID or version, and report what the server said.

    For the first run on a cluster: the fakes model the server's checks; this shows the real ones.
    Every request carries a payload that changes nothing even if the server ignored its fence, and
    the guard reads the objects again afterwards to prove nothing changed.
    """
    g.require_writable()
    ns, view = g.owned()

    def body(lease, slot):
        if lease is None and allocation(g.dgds(ns), g.pods(ns)) > 0:
            raise Refusal('lease_required', f'{ns} holds GPUs but has no lease')
        dgds, why_none = lease_dgds(g, ns, view.lease_id)
        if why_none:
            raise Refusal('lease_required', f'{why_none}; the selftest needs a DGD of the lease')
        if not dgds:
            raise Refusal('selftest_needs_dgd', f'{ns} has no DGD applied under lease {view.lease_id}; '
                                                'apply one first')
        d = dgds[0]
        name, dgd_uid = d['metadata']['name'], d['metadata']['uid']
        group, _, version = d['apiVersion'].partition('/')
        res = f'dynamographdeployments.{version}.{group}/{name}'
        label_path = '/metadata/labels/' + LEASE_LABEL.replace('~', '~0').replace('/', '~1')
        # A no-op payload: write back the replica count the first component already has.
        spec = d.get('spec') or {}
        if d['apiVersion'] == 'nvidia.com/v1beta1' and spec.get('components'):
            path, current = '/spec/components/0/replicas', spec['components'][0].get('replicas', 1)
        elif d['apiVersion'] == 'nvidia.com/v1alpha1' and spec.get('services'):
            svc = next(iter(spec['services']))
            path = '/spec/services/' + svc.replace('~', '~0').replace('/', '~1') + '/replicas'
            current = (spec['services'][svc] or {}).get('replicas', 1)
        else:
            raise Refusal('selftest_needs_dgd', f'DGD {name} has no component to write back')
        noop = {'op': 'add', 'path': path, 'value': current}
        dgd_rv = d['metadata']['resourceVersion']
        uid_test = {'op': 'test', 'path': '/metadata/uid', 'value': dgd_uid}
        rv_test = {'op': 'test', 'path': '/metadata/resourceVersion', 'value': dgd_rv}

        def delete_options(uid, version):
            return json.dumps({'kind': 'DeleteOptions', 'apiVersion': 'v1',
                               'preconditions': {'uid': uid, 'resourceVersion': version}})

        probes = [
            ('patch: wrong DGD UID', 'patch test', ('patch', res, '-n', ns, '--type=json', '-p', json.dumps(
                [{'op': 'test', 'path': '/metadata/uid', 'value': WRONG_UID}, rv_test, noop])), None),
            ('patch: stale resourceVersion', 'patch test', ('patch', res, '-n', ns, '--type=json', '-p', json.dumps(
                [uid_test, {'op': 'test', 'path': '/metadata/resourceVersion', 'value': STALE_VERSION}, noop])),
             None),
            ('patch: wrong lease label', 'patch test', ('patch', res, '-n', ns, '--type=json', '-p', json.dumps(
                [uid_test, rv_test, {'op': 'test', 'path': label_path, 'value': WRONG_UID}, noop])), None),
            ('delete DGD: wrong UID precondition', 'delete precondition',
             ('delete', '--raw', dgd_path(d, ns), '-f', '-'), delete_options(WRONG_UID, dgd_rv)),
            ('delete DGD: stale resourceVersion precondition', 'delete precondition',
             ('delete', '--raw', dgd_path(d, ns), '-f', '-'), delete_options(dgd_uid, STALE_VERSION)),
        ]
        if not view.claimed:
            # A claimed namespace gets no Namespace request at all, not even one that must fail.
            probes.append(('delete namespace: wrong UID precondition', 'delete precondition',
                           ('delete', '--raw', f'/api/v1/namespaces/{ns}', '-f', '-'),
                           json.dumps({'kind': 'DeleteOptions', 'apiVersion': 'v1',
                                       'preconditions': {'uid': WRONG_UID}})))
        if view.record is not None:
            stale = copy.deepcopy(view.record)
            stale['metadata']['resourceVersion'] = '1'
            probes.append(('replace lease record: stale resourceVersion', 'stale resourceVersion',
                           ('replace', '-f', '-', '-n', ns, '-o', 'json'), json.dumps(stale)))
        results = []
        for label, fence, args, stdin in probes:
            confirm_uid(g, ns, view.uid)
            if slot:
                slot.check()
            rc, out, err = g.kc.run(*args, input=stdin)
            # Held only when the server refused it for this fence's reason.
            results.append({'fence': label, 'refused': rc != 0, 'exit': rc,
                            'held': rc != 0 and any(m in err for m in FENCE_REFUSALS[fence]),
                            'response': clip(err if rc else out, 600)})
        # Prove nothing changed: the namespace, the DGD and the record, read again.
        after_ns = g.kc.json('get', 'namespace', ns, '-o', 'json', not_found=MISSING)
        after_dgd = g.kc.json('get', f'{DGD_RESOURCE}/{name}', '-n', ns, '-o', 'json', not_found=MISSING)
        unchanged = {
            'namespace': after_ns is not MISSING and after_ns['metadata'].get('uid') == view.uid,
            'dgd': after_dgd is not MISSING and after_dgd['metadata'].get('uid') == dgd_uid
            and after_dgd.get('spec') == d.get('spec'),
        }
        if view.record is not None:
            after_rec = g.lease_record(ns)
            unchanged['lease_record'] = after_rec is not None and after_rec.get('data') == view.record.get('data')
        held = all(r['held'] for r in results) and all(unchanged.values())
        g.record(ns, f'selftest/fences on {name}', 0, 'selftest', uid=view.uid, lease=view.lease_id, issue=view.issue)
        report = {'namespace': ns, 'dgd': name, 'probes': results, 'unchanged': unchanged, 'all_held': held}
        if not held:
            raise Refusal('fence_failed', 'a fence did not prove itself: the server accepted a request, refused it '
                                          'for another reason, or something changed', **report)
        return report

    return fenced(g, view, body)


# --- build Jobs ------------------------------------------------------------------------
#
# One Job rendered from the fixed template in k8s_guard_rules, under this thread's claim: the tag
# check, the clone, the build and its push, then (for a multi-arch image) an index Job that appends
# both per-arch tags. Every check runs on the rendered object and again on the server's dry-run
# answer, so a webhook cannot add a field the guard did not render. No caller-supplied manifest.

def create_job(g, ns, job, dry, timeout=KUBECTL_TIMEOUT):
    args = ['create', '-f', '-', '-n', ns, '-o', 'json'] + (['--dry-run=server'] if dry else [])
    rc, out, err = g.kc.run(*args, input=json.dumps(job), timeout=timeout)
    if rc != 0:
        if 'AlreadyExists' in err:
            e = Refusal('job_exists', f'{job["kind"]}/{job["metadata"]["name"]} already exists in {ns}; '
                                      '`k8s-guard build show` it, then `build delete` it')
            e.raw = err
            raise e
        raise kubectl_error(('create', 'job', job['metadata']['name']), rc, err)
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        raise Refusal('kubectl_error', f'kubectl create Job/{job["metadata"]["name"]} printed no JSON')


def submit_job(g, ns, view, lease, slot, job, expect, charge):
    """Dry-run, admit, create as an attempt under the slot, and append one ledger line."""
    name = job['metadata']['name']
    lid = lease['lease_id']
    if get_object(g, ns, 'Job', name) is not None:
        raise Refusal('job_exists', f'Job/{name} exists; `k8s-guard build show {name}` it, then `build delete` '
                                    'it before another build of the same commit and arch')
    check_job(job, lid, expect, rendered=True)
    confirm_uid(g, ns, view.uid)
    if slot:
        slot.check()
    check_job(create_job(g, ns, job, dry=True), lid, expect)
    confirm_uid(g, ns, view.uid)
    if slot:
        slot.check()
    attempt = job['metadata']['annotations'][ATTEMPT_ANNOTATION]

    def send():
        return create_job(g, ns, job, dry=False, timeout=slot.timeout() if slot else APPLY_REQUEST_TIMEOUT + 15)

    if slot:
        slot.attempts.run(attempt, 'create', 'Job', name, None, None, send)
    else:
        send()
    # The Job requests no GPU; the claim is what costs one, so the ledger records the claim's charge.
    g.record(ns, f'Job/{name}', charge, 'up', uid=view.uid, lease=view.lease_id, issue=view.issue)
    return name


def build_prerequisites(g, ns, lease, ssh):
    if lease is None:
        raise Refusal('lease_required', f'{ns} has no live lease; a build Job runs under this thread\'s claim')
    if ssh and (get_object(g, ns, 'Secret', GIT_SECRET) is None
                or get_object(g, ns, 'ConfigMap', KNOWN_HOSTS_CONFIGMAP) is None):
        raise Refusal('secret_unavailable', f'the ssh source needs Secret/{GIT_SECRET} and '
                                            f'ConfigMap/{KNOWN_HOSTS_CONFIGMAP}; run `k8s-guard -n {ns} secret '
                                            'git --repo <owner>/<repo>` first')
    if get_object(g, ns, 'Secret', PUSH_SECRET) is None:
        raise Refusal('secret_unavailable', f'the build pushes with Secret/{PUSH_SECRET}; run `k8s-guard -n {ns} '
                                            'secret ngc-push` first')


def cmd_build_run(g, a):
    g.require_writable()
    commit = commit_arg(a.commit)
    image = image_arg(a.image)
    dockerfile = dockerfile_arg(a.dockerfile)
    repo = repo_arg(a.repo)
    arch = arch_arg(a.arch, g.profile)
    ssh = repo_is_ssh(repo)
    ns, view = g.owned()

    def body(lease, slot):
        build_prerequisites(g, ns, lease, ssh)
        attempt = new_attempt_id()
        job = build_job(ns, view.uid, lease['lease_id'], attempt, repo, commit, dockerfile, image, arch, ssh)
        expect = {'kind': 'run', 'image': image, 'commit': commit, 'arch': arch, 'repo': repo, 'ssh': ssh}
        return {'job': submit_job(g, ns, view, lease, slot, job, expect, max(int(lease['gpus']), 1))}

    return fenced(g, view, body)


def cmd_build_index(g, a):
    g.require_writable()
    commit = commit_arg(a.commit)
    image = image_arg(a.image)
    arch = arch_arg(None, g.profile)
    ns, view = g.owned()

    def body(lease, slot):
        build_prerequisites(g, ns, lease, ssh=False)
        attempt = new_attempt_id()
        job = index_job(ns, view.uid, lease['lease_id'], attempt, image, commit, arch)
        expect = {'kind': 'index', 'image': image, 'commit': commit, 'arch': arch, 'uid': 65532}
        return {'job': submit_job(g, ns, view, lease, slot, job, expect, max(int(lease['gpus']), 1))}

    return fenced(g, view, body)


def cmd_build_show(g, a):
    """Read only: the Job's state and the last 200 log lines, with the credential's shapes redacted."""
    ns = g.ns_name()
    name = a.name or ''
    if not DNS_SUBDOMAIN.match(name) or len(name) > 63:
        raise Refusal('usage', f'{name!r} is not a Job name', status=2)
    job = get_object(g, ns, 'Job', name)
    if job is None:
        raise Refusal('not_found', f'Job/{name} not found in {ns}')
    state = job_state(job)
    # --all-containers so the tag-check and clone initContainers' lines are in the tail too, and
    # --ignore-errors because a container that never started would otherwise end the call: its log is
    # exactly the marker this command exists to report. Keep stdout on a non-zero exit for the same reason.
    rc, out, err = g.kc.run('logs', f'job/{name}', '-n', ns, '--tail=200', '--all-containers=true',
                            '--ignore-errors=true')
    tail = redact_build_log(out if out.strip() else (err if rc != 0 else ''))
    if state == 'failed':
        code = build_verdict(tail)
        detail = next((line for line in reversed(tail.splitlines()) if line.strip()), '')
        raise Refusal(code, f'build {name} failed' + (f': {detail}' if detail else ''), build=name, state=state,
                      tail=tail)
    return {'build': name, 'state': state, 'tail': tail}


def cmd_build_delete(g, a):
    g.require_writable()
    ns, view = g.owned()
    name = a.name or ''
    if not DNS_SUBDOMAIN.match(name) or len(name) > 63:
        raise Refusal('usage', f'{name!r} is not a Job name', status=2)

    def body(lease, slot):
        if lease is None and allocation(g.dgds(ns), g.pods(ns)) > 0:
            raise Refusal('lease_required', f'{ns} holds GPUs but has no lease; use `k8s-guard down`')
        lease_id = lease['lease_id'] if lease else None
        obj = get_object(g, ns, 'Job', name)
        if obj is None:
            raise Refusal('not_found', f'Job/{name} not found in {ns}')

        def mine(live):
            return owns(live, lease_id, view.uid, view.claimed, unstamped=True)[0]

        if not mine(obj):
            raise Refusal('object_not_yours', f'Job/{name} is not this lease\'s '
                                              f'({LEASE_LABEL}={labels_of(obj).get(LEASE_LABEL) or "none"}); '
                                              'left alone')
        confirm_uid(g, ns, view.uid)
        if slot:
            slot.check()
        if delete_owned(g, ns, obj, mine, timeout=slot.timeout() if slot else KUBECTL_TIMEOUT,
                        attempts=slot.attempts if slot else None) == 'gone':
            raise Refusal('not_found', f'Job/{name} not found in {ns}')
        g.record(ns, f'Job/{name}', 0, 'down', uid=view.uid, lease=view.lease_id, issue=view.issue)
        return {'deleted': f'Job/{name}', 'namespace': ns}

    return fenced(g, view, body)


# --- argv ----------------------------------------------------------------------------

class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise Refusal('usage', f'{self.prog}: {message}', status=2)


def parser(prog, *specs):
    p = Parser(prog=f'k8s-guard {prog}', allow_abbrev=False, add_help=False)
    for args, kw in specs:
        p.add_argument(*args, **kw)
    return p


TEARDOWN = ((('namespace',), {}), (('--uid',), {}), (('--lease',), {}))
COMMANDS = {
    ('inspect',): (cmd_inspect, ((('namespace',), {}),)),
    ('ns', 'create'): (cmd_ns_create, ((('purpose',), {}), (('--issue',), {'required': True}),
                                       (('--hours',), {'required': True}))),
    ('ns', 'claim'): (cmd_ns_claim, ((('--gpus',), {'required': True}), (('--hours',), {'required': True}))),
    ('lease', 'acquire'): (cmd_lease_acquire, ((('--gpus',), {'required': True}),
                                               (('--hours',), {'required': True}))),
    ('secret',): (cmd_secret, ((('which',), {'choices': sorted(SECRETS) + ['git']}), (('--repo',), {}),
                               (('--exposure-accepted',), {'action': 'store_true'}))),
    ('build', 'run'): (cmd_build_run, ((('--repo',), {'required': True}), (('--commit',), {'required': True}),
                                       (('--dockerfile',), {'required': True}), (('--image',), {'required': True}),
                                       (('--arch',), {}))),
    ('build', 'index'): (cmd_build_index, ((('--commit',), {'required': True}), (('--image',), {'required': True}))),
    ('build', 'show'): (cmd_build_show, ((('name',), {}),)),
    ('build', 'delete'): (cmd_build_delete, ((('name',), {}),)),
    ('apply',): (cmd_apply, ((('-f', '--filename'), {'required': True}),)),
    ('delete',): (cmd_delete, ((('target',), {}),)),
    ('down',): (cmd_down, TEARDOWN),
    ('expire',): (cmd_expire, TEARDOWN),
    ('extend',): (cmd_extend, TEARDOWN),
    ('selftest', 'fences'): (cmd_selftest_fences, ()),
}


def split_globals(argv):
    """Take --context and -n from anywhere; refuse -A outright."""
    context = namespace = None
    rest, i = [], 0
    while i < len(argv):
        a = argv[i]
        if a in ('-A', '--all-namespaces') or a.startswith('--all-namespaces='):
            raise Refusal('command_refused', 'all-namespace operations are refused', status=2)
        for flag, short in (('--context', None), ('--namespace', '-n')):
            if a == flag or (short and a == short):
                if i + 1 >= len(argv):
                    raise Refusal('usage', f'{a} needs a value', status=2)
                value, i = argv[i + 1], i + 2
                break
            if a.startswith(flag + '='):
                value, i = a.split('=', 1)[1], i + 1
                break
        else:
            rest.append(a)
            i += 1
            continue
        if flag == '--context':
            if context is not None and context != value:
                raise Refusal('usage', 'two different --context values', status=2)
            context = value
        else:
            if namespace is not None and namespace != value:
                raise Refusal('usage', 'two different -n values', status=2)
            namespace = value
    return context, namespace, rest


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        context, namespace, rest = split_globals(argv)
        key = tuple(rest[:2]) if tuple(rest[:2]) in COMMANDS else tuple(rest[:1])
        if key not in COMMANDS:
            word = ' '.join(rest[:2]) or '(nothing)'
            raise Refusal('command_refused', f'{word} is not a k8s-guard command; the commands are: '
                                             + ', '.join(' '.join(k) for k in COMMANDS), status=2)
        func, specs = COMMANDS[key]
        args = parser(' '.join(key), *specs).parse_args(rest[len(key):])
        try:
            profiles = load_profiles()
        except ProfileError as e:
            raise Refusal(e.code, str(e))
        g = Guard(profiles, context, namespace)
        g.check_identity()
        return emit(func(g, args))
    except Refusal as e:
        return emit(dict(e.extra, error=str(e), code=e.code), status=e.status)
    except Exception as e:  # still one JSON object, never a traceback that could carry a value
        return emit({'error': f'internal error: {type(e).__name__}: {e}', 'code': 'internal_error'}, status=1)


if __name__ == '__main__':
    sys.exit(main())
