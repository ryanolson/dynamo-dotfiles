    LEASE_LABEL, LEASE_RECORD, NS_UID_LABEL, PUSH_SECRET, Refusal, admit, allocation, arch_arg,
    budget_allocation, build_job, build_verdict, check_gpu_product, check_job, check_lease_label, check_one_node,
    commit_arg, dgd_gpus, dockerfile_arg, git_secret_spec, gpu_pod_summary, image_arg, index_job, job_state,
    redact_build_log, repo_arg, repo_is_ssh, zero_patch)

