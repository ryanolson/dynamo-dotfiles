#!/usr/bin/env python3
"""The only write path agents have to a shared Kubernetes cluster, as the agents' bot.

Usage (every command takes --context <kube context>; -n may come anywhere):
  k8s-guard ns create <purpose> --issue <n> --hours <h>      a new namespace, never an existing one
  k8s-guard -n <ns> lease acquire --gpus <n> --hours <h>      a k8s-leases lease for the namespace
  k8s-guard -n <ns> secret hf|ngc                              a secret piped from `fleet secret get`
  k8s-guard -n <ns> apply -f <file>                            DGDs, ConfigMaps, ClusterIP Services
  k8s-guard -n <ns> delete <kind>/<name>                       one object
  k8s-guard down <ns> [--uid <uid>] [--lease <id>]             tear down and delete the namespace
  k8s-guard expire <ns> [--uid <uid>] [--lease <id>]           scale every DGD to 0
  k8s-guard extend <ns> [--uid <uid>] [--lease <id>]           copy the lease's expiry into the namespace
  k8s-guard inspect <ns>                                       read only

Every command prints one JSON object on stdout. Failures exit non-zero with
{"error": ..., "code": ...}. The rules and the reasons for them are in
references/k8s-guard.md. Profiles come from the shared parser (k8s_profiles.py).

The guard parses no YAML. Each manifest is read once and sent, as the same
bytes, first to a server-side dry run and then to the apply, and every check
runs on the JSON the dry run returns, so defaults and webhook mutations are
checked too.
"""
import argparse
import base64
import copy
from datetime import datetime, timedelta, timezone
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import time

# -I drops the script directory from sys.path; the shared parser lives next to this script.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from k8s_profiles import ProfileError, load_profiles  # noqa: E402

