#!/usr/bin/env python3
"""The only write path agents have to a shared Kubernetes cluster, as the agents' bot.

Usage (every command takes --context <kube context>; -n may come anywhere):
  k8s-guard ns create <purpose> --issue <n> --hours <h>      a new namespace, never an existing one
  k8s-guard -n <premade> ns claim --gpus <n> --hours <h>      claim the profile's pre-made namespace
  k8s-guard -n <ns> lease acquire --gpus <n> --hours <h>      a k8s-leases lease for the namespace
  k8s-guard -n <ns> secret hf|ngc|ngc-push                    a secret piped from `fleet secret get`
  k8s-guard -n <ns> secret git --repo <owner>/<repo>           the read-only deploy key and the pinned host key
  k8s-guard -n <ns> apply -f <file>                            DGDs, ConfigMaps, ClusterIP Services
  k8s-guard -n <ns> build run --repo <url> --commit <40 hex> --dockerfile <path> --image <name> [--arch ...]
                                                               one image-build Job, from the fixed template
  k8s-guard -n <ns> build show <job>                           its state and the last 200 log lines, read only
  k8s-guard -n <ns> build index --commit <40 hex> --image <name>
                                                               the manifest-list Job over both per-arch tags
  k8s-guard -n <ns> build delete <job>                         end a Job now, Pods included
  k8s-guard -n <ns> delete <kind>/<name>                       one object
  k8s-guard down <ns> [--uid <uid>] [--lease <id>]             delete the lease's DGDs, then the namespace
  k8s-guard expire <ns> [--uid <uid>] [--lease <id>]           scale the lease's DGDs to 0
  k8s-guard extend <ns> [--uid <uid>] [--lease <id>]           copy the lease's expiry into the namespace
  k8s-guard inspect <ns>                                       read only
  k8s-guard -n <ns> selftest fences                            send each fence with a wrong UID; change nothing

Every command prints one JSON object on stdout. Failures exit non-zero with
{"error": ..., "code": ...}. The rules and the reasons for them are in
references/k8s-guard.md. Profiles come from the shared parser (k8s_profiles.py); the
admission and GPU-counting rules are in k8s_guard_rules.py.

The guard parses no YAML. Each manifest is read once and sent, as the same
bytes, first to a server-side dry run and then to the apply, and every check
runs on the JSON the dry run returns, so defaults and webhook mutations are
checked too.
"""
import argparse
import base64
import copy
from datetime import datetime, timedelta, timezone
import json
import math
import os
from pathlib import Path
import re
import secrets
import subprocess
import sys
import time

