{{- $name := promptStringOnce . "name" "Your full name" -}}
{{- $email := promptStringOnce . "email" "Your email address" -}}
{{/* bootstrap.sh exports DOTFILES_MACHINE_CLASS when it detects no usable sudo.
     When set it is AUTHORITATIVE (not just a prompt default), so re-running
     bootstrap on a node with a stale machine_class self-corrects. */}}
{{- $envClass := env "DOTFILES_MACHINE_CLASS" -}}
{{- $machineClass := "" -}}
{{- if ne $envClass "" -}}
{{-   $machineClass = $envClass -}}
{{- else -}}
{{-   $machineClass = promptChoiceOnce . "machine_class" "Machine class" (list "headless-sudo" "headless-nosudo" "primary") "headless-sudo" -}}
{{- end -}}
{{- $machineSeed := promptChoiceOnce . "machine_seed" "Per-machine fish seed (creates conf.d/local.fish once, then unsynced)" (list "blank" "cuda") "blank" -}}
{{- $defaultHost := .chezmoi.hostname -}}
{{- $cursorSSHHost := promptStringOnce . "cursor_ssh_host" (printf "SSH hostname for Cursor deep links [leave blank to use: %s]" $defaultHost) -}}
{{- if eq $cursorSSHHost "" -}}{{- $cursorSSHHost = $defaultHost -}}{{- end -}}
{{/* Derived capabilities — primary is the only class with 1Password + commit signing. */}}
{{- $isPrimary := eq $machineClass "primary" -}}
{{- $opSigningKey := "" -}}
{{- if $isPrimary -}}
{{-   $opSigningKey = promptStringOnce . "onepassword.signing_public_key" "SSH signing public key (from 1Password item public key field; empty to skip signing)" -}}
{{- end -}}

# sourceDir intentionally omitted — chezmoi defaults to ~/.local/share/chezmoi,
# which adapts to whatever $HOME is (login nodes are rarely /home/<user>).

# Global settings
progress: true
color: true

# Git settings
git:
  autoCommit: false
  autoPush: false

# Merge strategy
merge:
  command: "hx"

# CD hook
cd:
  command: "fish"

# Personal config (set during chezmoi init)
data:
  name: {{ $name | quote }}
  email: {{ $email | quote }}
  # Machine class: headless-sudo | headless-nosudo | primary
  #   headless-nosudo => no sudo, everything installs into $HOME (SLURM login node)
  #   primary         => 1Password CLI + commit signing enabled
  machine_class: {{ $machineClass | quote }}
  # Per-machine fish seed picked at init; materialized once into conf.d/local.fish
  machine_seed: {{ $machineSeed | quote }}
  cursor_ssh_host: {{ $cursorSSHHost | quote }}
  onepassword:
    # Auto-enabled on primary machines; override in ~/.config/chezmoi/chezmoi.yaml
    enabled: {{ $isPrimary }}
    ssh_agent: {{ $isPrimary }}
    signing_public_key: {{ $opSigningKey | quote }}
    vault: "Development"
    # secrets: override in ~/.config/chezmoi/chezmoi.yaml
    # defaults from .chezmoidata/team.yaml
