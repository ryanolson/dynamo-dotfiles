#!/bin/bash
# Services such as the bb host daemon run npm without the shell's NPM_CONFIG_PREFIX.
# Without this line, their `npm install -g` writes to npm's default prefix, and the
# copy in ~/.npm-global that PATH finds stays old. Keep every other line.
set -euo pipefail
awk '!/^[[:space:]]*prefix[[:space:]]*=/'
printf 'prefix=%s\n' "$HOME/.npm-global"
