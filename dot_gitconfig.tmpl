# Git configuration - Dynamo team setup

[user]
    name = {{ .name | default "Your Name" }}
    email = {{ .email | default "your.email@company.com" }}
{{- if and (hasKey . "onepassword") .onepassword.enabled .onepassword.ssh_agent .onepassword.signing_public_key }}
    signingkey = {{ .onepassword.signing_public_key | trim | quote }}
{{- end }}

[core]
    editor = vi
    autocrlf = input
    safecrlf = true
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = "main"

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = current

[rebase]
    autostash = true

[merge]
    tool = vi
    conflictstyle = diff3

[diff]
    algorithm = histogram
    colorMoved = default

[log]
    date = relative

[format]
    pretty = format:%C(yellow)%h%Creset -%C(red)%d%Creset %s %C(dim green)(%an %ar)%Creset

[alias]
    # Team-standard aliases
    st = status
    co = checkout
    br = branch
    ci = commit
    df = diff
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

    # Useful shortcuts
    unstage = reset HEAD --
    last = log -1 HEAD
    visual = !gitk

    # Branch management
    delete-merged = "!git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d"
{{- if and (hasKey . "onepassword") .onepassword.enabled .onepassword.ssh_agent }}

# GitHub auth policy: never a personal access token. On this machine git reaches
# GitHub over SSH through the 1Password agent, so no HTTPS credential is ever
# requested. Authenticate the CLI with `gh auth login -p ssh`.
#
# Do not add the inverse rewrite (`[url "https://github.com/"] insteadOf = git@github.com:`).
# It forces HTTPS, which is the one transport that needs a credential, and is how
# a PAT gets reintroduced. If you find one in ~/.gitconfig, something ran
# `git config --global` outside chezmoi -- `chezmoi apply` removes it.
[url "git@github.com:"]
    insteadOf = "https://github.com/"

[gpg]
    format = ssh

[gpg "ssh"]
{{- if eq .chezmoi.os "darwin" }}
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- end }}
{{- if .onepassword.signing_public_key }}
    allowedSignersFile = ~/.ssh/allowed_signers
{{- end }}

{{- if .onepassword.signing_public_key }}
[commit]
    gpgsign = true
{{- end }}
{{- else }}

# No 1Password SSH agent on this machine, so git talks to GitHub over HTTPS.
# Broker that through `gh` rather than a personal access token: `gh auth login`
# stores an OAuth credential in the system keyring and this helper reads it.
# Declared here so `gh auth setup-git` never needs to mutate this file behind
# chezmoi's back. Never set GITHUB_TOKEN or GH_TOKEN instead.
[credential "https://github.com"]
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper = !gh auth git-credential
{{- end }}
