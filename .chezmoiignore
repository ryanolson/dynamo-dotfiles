# Files to ignore when applying dotfiles
# These files won't be managed by chezmoi

README.md
LICENSE
.git/

# Development files
.chezmoi*
.tool-versions
.mise.toml

# OS-specific files
{{- if ne .chezmoi.os "darwin" }}
# Ignore macOS-specific files on non-macOS systems
.DS_Store
.macos
{{- end }}

{{- if ne .chezmoi.os "linux" }}
# Ignore Linux-specific files on non-Linux systems  
.linux
{{- end }}

# Personal files that shouldn't be managed
.ssh/id_*
.ssh/known_hosts
.aws/credentials
.docker/config.json

# Local development files
node_modules/
.env
.env.local
*.log

# IDE-specific files (user preference)
.vscode/
.idea/
*.sublime-*

# Temporary files
*.tmp
*.swp
*.swo
*~
.#*

# OS cache files
Thumbs.db
Desktop.ini

# NOTE: .chezmoiignore matches TARGET paths (relative to $HOME), not source
# filenames. Use .config/..., .local/bin/..., NOT dot_config/executable_...
#
# Agent infrastructure — on any machine with sudo (headless-sudo + primary),
# excluded only on no-sudo login nodes.
{{- if eq .machine_class "headless-nosudo" }}
.local/bin/wt
.local/bin/agent-spawn
.local/bin/agent-status
.local/bin/osc8-link
.config/zellij/layouts/agents.kdl
.config/systemd
.config/fish/conf.d/agent-aliases.fish
.config/fish/conf.d/ssh-auth-sock.fish
{{- end }}

# systemd only on Linux
{{- if ne .chezmoi.os "linux" }}
.config/systemd
{{- end }}

# NOTE: no .claude/hooks rule here on purpose. The GSD hook scripts this used to
# guard no longer exist, and settings.json referencing missing hook commands makes
# every Bash/Edit/Write call fail with a node module-not-found error. If hooks come
# back, add the source under dot_claude/hooks/ and restore the machine_class guard.

# Shared cache symlinks — only where /opt/shared-cache exists
{{- if not (stat "/opt/shared-cache") }}
.cache/huggingface
.cache/llama.cpp
{{- end }}
