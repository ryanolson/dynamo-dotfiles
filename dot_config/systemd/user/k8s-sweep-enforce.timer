# Managed by chezmoi (dot_config/systemd/user/k8s-sweep-enforce.timer). Never enabled by chezmoi.
[Unit]
Description=Run k8s-sweep --enforce every 15 minutes

[Timer]
OnCalendar=*:0/15
# A run missed while the host was off runs at the next boot.
Persistent=true
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
