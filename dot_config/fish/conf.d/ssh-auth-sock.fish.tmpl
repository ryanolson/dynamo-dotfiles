# Stable SSH_AUTH_SOCK for forwarded agents.
# Managed by chezmoi. Do not edit directly.
# Pin a stable symlink so long-lived sessions survive SSH reconnects.
if status is-login; and set -q SSH_CONNECTION
    if set -q SSH_AUTH_SOCK
        set -l _real (readlink -f "$SSH_AUTH_SOCK" 2>/dev/null; or echo "$SSH_AUTH_SOCK")
        set -l _stable (readlink -f "$HOME/.ssh/auth_sock" 2>/dev/null; or echo "")
        if test "$_real" != "$_stable"
            ln -sf "$_real" "$HOME/.ssh/auth_sock"
        end
    end
end
if test -e "$HOME/.ssh/auth_sock"
    set -gx SSH_AUTH_SOCK "$HOME/.ssh/auth_sock"
end
