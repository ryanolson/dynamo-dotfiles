#!/bin/bash
# Package installation script - runs when package configuration changes
# This script installs all the tools defined in the team configuration.
#
# Branches on machine_class (templated by chezmoi):
#   headless-sudo / primary  -> apt + /usr/local/bin (sudo)
#   headless-nosudo          -> everything into $HOME, pixi for fish+node (no sudo)

set -euo pipefail

MACHINE_CLASS="{{ .machine_class }}"
# target-arch: {{ .chezmoi.arch }}
# ^ embeds the rendering machine's arch so run_onchange's content hash differs
#   per architecture. $HOME (and chezmoi's state) is shared across the x86_64
#   login node and aarch64 compute nodes; without this the installer would be
#   considered "already run" on the second arch and skipped.

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "${BLUE}[INFO]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Detect OS
case "$OSTYPE" in
    darwin*)  OS="macOS" ;;
    linux*)   OS="Linux" ;;
    *)        error "Unsupported OS: $OSTYPE" ;;
esac

# Detect architecture and the name that kubectl downloads use for it
ARCH="$(uname -m)"
case "$ARCH" in
    x86_64)
        ARCH_ALT="amd64"
        ;;
    aarch64|arm64)
        ARCH="aarch64"
        ARCH_ALT="arm64"
        ;;
    *)
        error "Unsupported architecture: $ARCH"
        exit 1
        ;;
esac
log "Detected architecture: $ARCH ($ARCH_ALT)"

# No-sudo install is arch-namespaced under ~/.local/<arch> because $HOME is
# shared across the x86_64 login node and aarch64 compute nodes. sudo classes
# use /usr/local/bin (single-arch boxes).
ARCH_RAW="$(uname -m)"          # x86_64 | aarch64
BIN_DIR="/usr/local/bin"
ARCH_ROOT=""
if [[ "$MACHINE_CLASS" == "headless-nosudo" ]]; then
    ARCH_ROOT="$HOME/.local/$ARCH_RAW"
    BIN_DIR="$ARCH_ROOT/bin"
    export PIXI_HOME="$ARCH_ROOT/pixi"
    export NPM_CONFIG_PREFIX="$ARCH_ROOT/npm"
    export PATH="$BIN_DIR:$PIXI_HOME/bin:$NPM_CONFIG_PREFIX/bin:$PATH"
    mkdir -p "$BIN_DIR" "$PIXI_HOME" "$NPM_CONFIG_PREFIX"
fi
mkdir -p "$BIN_DIR" 2>/dev/null || true

# Install packages on macOS via Homebrew
install_macos_packages() {
    if ! command -v brew &> /dev/null; then
        error "Homebrew not installed. Run bootstrap.sh first."
    fi

    log "📦 Installing packages via Homebrew..."

    local packages=(
        bat eza ripgrep fd zoxide dust procs
        helix fish starship zellij
        yazi broot
        lazygit gh
        1password-cli
        just watchexec hyperfine tokei kondo uv
        kubectl
        protobuf
        jq tree htop wget
        rclone age zstd
    )

    for package in "${packages[@]}"; do
        if brew list "$package" &>/dev/null; then
            log "✓ $package already installed"
        else
            log "Installing $package..."
            brew install "$package" || warn "Failed to install $package"
        fi
    done

    local fish_path
    fish_path="$(brew --prefix)/bin/fish"
    if [[ -x "$fish_path" ]]; then
        if ! grep -qxF "$fish_path" /etc/shells; then
            log "Adding $fish_path to /etc/shells..."
            echo "$fish_path" | sudo tee -a /etc/shells > /dev/null
            success "✓ $fish_path added to /etc/shells"
        fi
    fi

    if ! command -v cargo &>/dev/null; then
        log "Installing Rust toolchain via rustup..."
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path \
            || warn "Failed to install Rust"
    fi

    success "✅ macOS packages installed"
}

# uv and rustup keep their own installers, because each updates itself (`uv self
# update`, `rustup update`).
install_curl_tools() {
    if ! command -v uv &> /dev/null; then
        log "Installing uv..."
        curl -LsSf https://astral.sh/uv/install.sh | sh || warn "Failed to install uv"
    fi
    if ! command -v cargo &>/dev/null; then
        log "Installing Rust toolchain via rustup..."
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
            || warn "Failed to install Rust"
        # shellcheck disable=SC1090
        source "$HOME/.cargo/env" 2>/dev/null || true
    fi
}

# Claude Code CLI (native installer, $HOME-scoped)
install_claude() {
    # Single-arch / sudo box: the native installer (launcher + shell integration
    # in ~/.local/bin) is fine.
    if [[ -z "$ARCH_ROOT" ]]; then
        if ! command -v claude &> /dev/null; then
            log "Installing Claude Code CLI..."
            curl -fsSL https://claude.ai/install.sh | bash || warn "Failed to install Claude Code"
        fi
        return
    fi

    # No-sudo multi-arch: the native installer hardcodes ~/.local/bin, which is
    # shared across architectures — the x86 launcher can't exec on aarch64. So
    # fetch the arch-correct claude binary straight into the arch bin (first on
    # PATH). The downloaded file IS the full CLI (it has an `install` subcommand).
    if [[ -x "$BIN_DIR/claude" ]]; then
        log "✓ claude already present in $BIN_DIR"; return
    fi
    local aarch plat base ver
    case "$ARCH_RAW" in
        x86_64) aarch="x64" ;;
        aarch64|arm64) aarch="arm64" ;;
        *) warn "claude: unsupported arch $ARCH_RAW"; return ;;
    esac
    if [ -f /lib/libc.musl-x86_64.so.1 ] || [ -f /lib/libc.musl-aarch64.so.1 ] || ldd /bin/ls 2>&1 | grep -q musl; then
        plat="linux-${aarch}-musl"
    else
        plat="linux-${aarch}"
    fi
    base="https://downloads.claude.ai/claude-code-releases"
    ver=$(curl -fsSL "$base/latest" 2>/dev/null)
    if [[ ! "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+ ]]; then
        warn "claude: could not resolve latest version"; return
    fi
    log "Installing claude $ver ($plat) into $BIN_DIR..."
    if curl -fsSL "$base/$ver/$plat/claude" -o "$BIN_DIR/claude"; then
        chmod +x "$BIN_DIR/claude"
        success "✓ claude installed (arch $ARCH_RAW)"
    else
        warn "claude: download failed for $plat"
        rm -f "$BIN_DIR/claude"
    fi
}

# Codex CLI via npm (needs node >= 18.18). Node comes from pixi (current, sudo-free)
# on every class — apt's node is usually too old.
# Resolve the pixi binary to use. CRITICAL on multi-arch shared $HOME: a stale
# x86 ~/.pixi/bin/pixi is often on PATH on the aarch64 node, so we must NOT rely
# on `command -v pixi`. Prefer the arch-namespaced one ($PIXI_HOME/bin/pixi).
pixi_cmd() {
    # When PIXI_HOME is set (no-sudo, arch slot) ONLY the arch pixi is valid —
    # never fall back to a PATH pixi, which may be the wrong architecture.
    if [[ -n "${PIXI_HOME:-}" ]]; then
        [[ -x "$PIXI_HOME/bin/pixi" ]] && echo "$PIXI_HOME/bin/pixi"
    elif command -v pixi >/dev/null 2>&1; then
        command -v pixi
    elif [[ -x "$HOME/.pixi/bin/pixi" ]]; then
        # ensure_pixi installs here, and this script's PATH does not contain it yet.
        echo "$HOME/.pixi/bin/pixi"
    fi
}

# Install pixi into PIXI_HOME (the pixi installer honors $PIXI_HOME). On no-sudo
# nodes PIXI_HOME is the arch slot, so this yields an arch-correct pixi even when
# a stale wrong-arch pixi sits on PATH.
ensure_pixi() {
    if [[ -n "${PIXI_HOME:-}" ]]; then
        [[ -x "$PIXI_HOME/bin/pixi" ]] && return 0
    else
        [[ -n "$(pixi_cmd)" ]] && return 0
    fi
    log "Installing pixi${PIXI_HOME:+ into $PIXI_HOME}..."
    curl -fsSL https://pixi.sh/install.sh | PIXI_NO_PATH_UPDATE=1 bash || warn "Failed to install pixi"
}

# Codex CLI via npm (needs node >= 18.18). Node comes from pixi (current, sudo-free)
# on every class — apt's node is usually too old.
install_codex() {
    export NPM_CONFIG_PREFIX="${NPM_CONFIG_PREFIX:-$HOME/.npm-global}"
    mkdir -p "$NPM_CONFIG_PREFIX"
    if ! command -v npm &> /dev/null; then
        ensure_pixi
        local PIXI; PIXI="$(pixi_cmd)"
        if [[ -n "$PIXI" && -x "$PIXI" ]]; then
            log "Installing nodejs via pixi (for codex)..."
            "$PIXI" global install nodejs || warn "Failed to install nodejs via pixi"
            export PATH="$(dirname "$PIXI"):$PATH"
        else
            warn "No npm and pixi unavailable — skipping codex install"
            return
        fi
    fi
    if command -v codex &> /dev/null; then
        log "✓ codex already installed"
        return
    fi
    log "Installing codex (@openai/codex)..."
    npm install -g @openai/codex || warn "Failed to install codex"
    log "👉 Run 'codex login' to authenticate. The Claude Code plugin is a separate"
    log "   manual step: /plugin marketplace add openai/codex-plugin-cc"
}

# Command-line tools from conda-forge through `pixi global`, on every Linux class.
# Each entry is <conda-forge package>:<binary>[:<version>]. conda-forge's `fd` is a
# different package (a LIGO frame library); the file finder is `fd-find`.
#
# A version marks a critical tool. Each machine installs exactly that version, and a
# change to it reaches every machine on its next chezmoi update; zellij, for example,
# attaches only to a server of the same version. A critical tool that fails makes this
# script fail. The other tools float: run_after_update-pixi-tools updates them weekly,
# and a failure only warns.
PIXI_TOOLS=(
    gh:gh:2.102.0 zellij:zellij:0.45.1 rclone:rclone:1.75.1
    bat:bat eza:eza ripgrep:rg fd-find:fd zoxide:zoxide dust:dust procs:procs
    helix:hx lazygit:lazygit yazi:yazi broot:broot just:just
    watchexec:watchexec hyperfine:hyperfine tokei:tokei starship:starship
)
# headless-nosudo has no apt and no shared uv, so pixi also provides these there.
NOSUDO_PIXI_TOOLS=(fish:fish nodejs:node git:git uv:uv age:age zstd:zstd)
# apt installed these on the sudo classes. Remove the apt package once pixi provides
# the tool and ~/.local/bin links to it.
APT_REPLACED=(gh rclone)
# A release binary here stays stale for every caller without ~/.pixi/bin in PATH.
# Remove it once ~/.local/bin links to the pixi tool.
SYSTEM_BIN_DIR="${SYSTEM_BIN_DIR:-/usr/local/bin}"
# The cli.github.com apt repository failed its signature check (NO_PUBKEY
# 5612B36462313325), so apt kept Ubuntu's much older gh.
GH_APT_LIST="${GH_APT_LIST:-/etc/apt/sources.list.d/github-cli.list}"
GH_APT_KEYRING="${GH_APT_KEYRING:-/usr/share/keyrings/githubcli-archive-keyring.gpg}"

# Remove the repository before `apt-get update`, so apt stops reporting its failure.
remove_gh_apt_repository() {
    if [[ -e "$GH_APT_LIST" || -e "$GH_APT_KEYRING" ]]; then
        log "Removing the GitHub CLI apt repository..."
        sudo rm -f "$GH_APT_LIST" "$GH_APT_KEYRING"
    fi
}

# Link ~/.local/bin/<bin> to the pixi binary. Services, cron jobs, and the agents that
# a bb server starts often have ~/.local/bin but not ~/.pixi/bin in PATH, and git's
# HTTPS credential helper runs `gh` from PATH. Return 1 if the link failed, and 2 if a
# file that is not a link is in the way; that file stays.
link_pixi_tool() {
    local bin="$1" expose_dir="$2" link="$HOME/.local/bin/$1"
    if [[ -e "$link" && ! -L "$link" ]]; then
        warn "$link is not a link; leaving it in place"
        return 2
    fi
    mkdir -p "$(dirname "$link")" && ln -sfn "$expose_dir/$bin" "$link"
}

# Return 1 if a critical tool failed. chezmoi then does not record this run_onchange
# script as done, and runs it again on the next apply, so a machine that updates
# headless gets there in the end instead of keeping a half-done migration.
install_pixi_tools() {
    ensure_pixi
    local PIXI; PIXI="$(pixi_cmd)"
    if [[ -z "$PIXI" || ! -x "$PIXI" ]]; then
        error "pixi unavailable — cannot install tools"
        return 1
    fi
    # `pixi global` exposes binaries here, wherever the pixi executable itself is.
    local expose_dir="${PIXI_HOME:-$HOME/.pixi}/bin"
    local failed=0 linked entry package bin version critical
    local tools=("${PIXI_TOOLS[@]}")
    if [[ "$MACHINE_CLASS" == "headless-nosudo" ]]; then
        tools+=("${NOSUDO_PIXI_TOOLS[@]}")
    fi
    for entry in "${tools[@]}"; do
        IFS=: read -r package bin version <<< "$entry"
        critical=0
        [[ -n "$version" ]] && critical=1
        log "pixi global install $package${version:+==$version}..."
        if ! "$PIXI" global install "$package${version:+==$version}" || [[ ! -x "$expose_dir/$bin" ]]; then
            warn "Failed to pixi-install $package"
            failed=$((failed | critical))
            continue
        fi
        # On headless-nosudo, ~/.local/bin is shared across architectures, and nothing
        # was installed with sudo.
        [[ "$MACHINE_CLASS" == "headless-nosudo" ]] && continue
        # Link before removal, so a caller always finds one copy.
        linked=0
        link_pixi_tool "$bin" "$expose_dir" || linked=$?
        if [[ $linked -eq 1 ]]; then
            warn "Failed to link $HOME/.local/bin/$bin"
            failed=$((failed | critical))
            continue
        fi
        if [[ -e "$SYSTEM_BIN_DIR/$bin" ]]; then
            log "Removing $SYSTEM_BIN_DIR/$bin (pixi provides $bin)..."
            if ! sudo rm -f "$SYSTEM_BIN_DIR/$bin"; then
                warn "Failed to remove $SYSTEM_BIN_DIR/$bin"
                failed=$((failed | critical))
            fi
        fi
        if [[ $linked -eq 0 && " ${APT_REPLACED[*]} " == *" $bin "* ]] \
            && command -v dpkg &> /dev/null && dpkg -s "$bin" &> /dev/null; then
            log "Removing the apt $bin package (pixi provides $bin)..."
            if ! sudo apt-get remove -y -qq "$bin"; then
                warn "Failed to remove the apt $bin package"
                failed=$((failed | critical))
            fi
        fi
    done
    return "$failed"
}

# Linux path WITH sudo (headless-sudo / primary)
install_linux_sudo() {
    log "📦 Installing packages on Linux (sudo)..."
    if command -v apt-get &> /dev/null; then
        remove_gh_apt_repository
        sudo apt-get update -qq
        local apt_packages=(htop tree jq build-essential pkg-config libssl-dev fish unzip protobuf-compiler age zstd)
        for package in "${apt_packages[@]}"; do
            if dpkg -l | grep -q "^ii  $package "; then
                log "✓ $package already installed"
            else
                log "Installing $package..."
                sudo apt-get install -y -qq "$package" || warn "Failed to install $package"
            fi
        done
    fi

    local status=0
    install_pixi_tools || status=1
    install_curl_tools

    # kubectl
    if ! command -v kubectl &> /dev/null; then
        log "Installing kubectl..."
        curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/${ARCH_ALT}/kubectl"
        sudo install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl
        rm -f kubectl
    fi

    # 1Password CLI — primary machines only
    if [[ "$MACHINE_CLASS" == "primary" ]] && ! command -v op &> /dev/null; then
        log "Installing 1Password CLI..."
        curl -sS https://downloads.1password.com/linux/keys/1password.asc | \
            sudo gpg --dearmor --output /usr/share/keyrings/1password-archive-keyring.gpg
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/1password-archive-keyring.gpg] https://downloads.1password.com/linux/debian/$(dpkg --print-architecture) stable main" | \
            sudo tee /etc/apt/sources.list.d/1password.list > /dev/null
        sudo mkdir -p /etc/debsig/policies/AC2D62742012EA22/
        curl -sS https://downloads.1password.com/linux/debian/debsig/1password.pol | \
            sudo tee /etc/debsig/policies/AC2D62742012EA22/1password.pol > /dev/null
        sudo mkdir -p /usr/share/debsig/keyrings/AC2D62742012EA22
        curl -sS https://downloads.1password.com/linux/keys/1password.asc | \
            sudo gpg --dearmor --output /usr/share/debsig/keyrings/AC2D62742012EA22/debsig.gpg
        sudo apt-get update -qq
        sudo apt-get install -y 1password-cli || warn "Failed to install 1Password CLI"
    fi

    install_claude
    install_codex
    if [[ $status -ne 0 ]]; then
        error "A critical pixi tool failed; chezmoi runs this script again on the next apply"
        return 1
    fi
    success "✅ Linux packages installed"
}

# No-sudo path is PIXI-CENTRIC: conda-forge has nearly the whole tool list, pixi
# does arch detection for free, and its bundled libs sidestep glibc/ABI issues
# that hand-grabbed release binaries hit on these kernels. Everything lands under
# one arch-namespaced root ($ARCH_ROOT). Only claude (proprietary) and codex (npm)
# are special. Override PIXI_HOME to scratch before bootstrap if $HOME is quota-capped.
install_linux_nosudo() {
    log "📦 Installing packages into $ARCH_ROOT (no sudo, arch=$ARCH_RAW)"
    command -v curl >/dev/null || { error "curl is required but not found"; return 1; }

    # pixi_cmd uses only the arch pixi in $PIXI_HOME. A stale x86 ~/.pixi/bin/pixi is
    # often on PATH on the aarch64 node.
    local status=0
    install_pixi_tools || status=1
    install_claude     # native installer; per-arch (launcher in ~/.local/bin, store in ~/.claude)
    install_codex      # npm -g under the arch-namespaced NPM prefix
    if [[ $status -ne 0 ]]; then
        error "A critical pixi tool failed; chezmoi runs this script again on the next apply"
        return 1
    fi
    success "✅ No-sudo packages installed under $ARCH_ROOT"
}

main() {
    log "🚀 Installing team packages for $OS (class: $MACHINE_CLASS)..."
    case "$OS" in
        "macOS") install_macos_packages ;;
        "Linux")
            if [[ "$MACHINE_CLASS" == "headless-nosudo" ]]; then
                install_linux_nosudo
            else
                install_linux_sudo
            fi
            ;;
    esac
    success "🎉 Package installation complete!"
    log "💡 Restart your terminal or run 'exec \$SHELL' to use new tools"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
