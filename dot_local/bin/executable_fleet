#!/usr/bin/env bash
# Keep tokens and keys out of shell traces.
set +x
set -euo pipefail
umask 077

STEP_VERSION=0.31.0
STEP_SHA256_amd64=2bc654b26ca467848edb764620d6f17febea9d7d3629368b76dd20ce40c6ef32
STEP_SHA256_arm64=3252032aded050abe93a642681995d3e36c66eaf1979da1980bf71b5e8973516
# pylon from agentic-control, served by the broker at /v1/artifacts/pylon/VERSION/TARGET.
# fleet-config/artifacts/publish prints these values.
PYLON_VERSION=0.2.0
PYLON_SHA256_darwin_arm64=fa1fdecfe66ecb805ab81826c1bca6c80b3a82d1ae2f23861c0d58a45235b79a
PYLON_SHA256_linux_aarch64=1c5b04b76d8fd57a0178ad3fa5cb8f82ec1eb7794fec021ffdd7d36fc27f03b3
PYLON_SHA256_linux_x86_64=e709cacffbf78057249cfaa13bcb6f5a20e904c58cba6e5a4060707206f695d7

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fleet"
CONFIG="$CONFIG_DIR/config"
STATE="${FLEET_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/fleet}"
# FLEET_STATE_DIR keeps the identity on node-local disk when the home is shared (Slurm). Services get
# it in their unit files, so it must be absolute and hold no character a unit, plist, or crontab
# line would read as syntax.
if [[ -n "${FLEET_STATE_DIR:-}" && ! "$FLEET_STATE_DIR" =~ ^/[A-Za-z0-9/._-]+$ ]]; then
    printf 'fleet: FLEET_STATE_DIR must be an absolute path of letters, digits, and /._-: %s\n' "$FLEET_STATE_DIR" >&2
    exit 1
fi
SSH_FLEET="$HOME/.ssh/fleet"
SELF="$HOME/.local/bin/fleet"
X509_RENEW_BEFORE=16h
TOKEN_TTL=5m
# Laptops share 1Password, so a new laptop reads the deployment values from this item.
CONFIG_ITEM="${FLEET_CONFIG_ITEM:-op://Personal/Fleet config}"
ENROLL_QUIET=0
SSH_RENEW_BEFORE=8h

CLEANUP=()
cleanup() { rm -rf "${CLEANUP[@]+"${CLEANUP[@]}"}"; }
trap cleanup EXIT
fail() { printf 'fleet: %s\n' "$*" >&2; exit 1; }
# Sets SCRATCH in the caller; a $(...) subshell would lose the cleanup entry.
scratch() { SCRATCH=$(mktemp -d "${1:-${TMPDIR:-/tmp}}/.fleet.XXXXXX"); CLEANUP+=("$SCRATCH"); }

usage() {
    cat <<'EOF'
Usage: fleet <command> [options]

Laptop (has 1Password):
  init --ca-url URL --fingerprint SHA256 [--enroll-item op://VAULT/ITEM] [--admin-item op://VAULT/ITEM]
       [--broker-url URL] [--principal NAME]
  list [-a] [--json]                    List active machines; -a adds expired and revoked ones.
                                        Needs a certificate from fleet login.
  token NAME [--san NAME]...            Print a 5-minute enrollment token.
  enroll-remote HOST NAME [--san NAME]... [--no-trust] [--principal NAME]
                                        Mint a token and enroll HOST over SSH.
  invite NAME [--san NAME]... [--dotfiles] [--ephemeral] [--no-trust] [--principal NAME]
                                        Print a curl command that enrolls a new machine.
  login [NAME]                          Enroll this laptop as an admin, without login trust, and
                                        schedule renewal. Without fleet init, read the settings
                                        from op://Personal/Fleet config. Run it again after the
                                        certificate expired.
  revoke SERIAL                         Revoke a client certificate. Renewal and new SSH
                                        certificates stop within 24 hours.

Any machine:
  enroll NAME [--ca-url URL --fingerprint SHA256] [--token TOKEN] [--no-trust] [--principal NAME]
                                        Without --token, read the token from stdin.
  ephemeral NAME [--ca-url URL --fingerprint SHA256] [--no-trust] [--principal NAME]
                                        Enroll in memory-backed storage and renew in the
                                        foreground. On exit, revoke and remove everything.
  renew [--loop]                        Renew certificates that are close to expiry.
  agent [run|install|remove]            Bridge a local ssh-agent socket to the broker (pylon, else socat).
                                        install runs it as a launchd or systemd user service.
  tunnel add NAME --mode client|server|gate --listen HOST:PORT --to HOST:PORT [--peer NAME] [--allow CIDR]
       [--via HOST:PORT --via-peer NAME]
                                        Carry a TCP service over fleet mTLS and run it as a service.
                                        client: loopback -> server; server: fleet certificates only;
                                        gate: fleet certificates in, ciphertext through. --via sends a
                                        client through a gate with TLS inside TLS. --allow limits sources.
  tunnel run NAME | remove NAME | list
  door install [--listen HOST:PORT] [--to HOST:PORT] [--per-source N] [--max N] [--handshake-timeout S]
                                        Linux, sudo: run a public mTLS listener for fleet machines in front of a
                                        local service (nginx stream, a root system service). Defaults: 0.0.0.0:8461
                                        -> 127.0.0.1:38886, 64 connections per address, 1024 in all, 10 s to finish
                                        the TLS handshake. Each certificate renewal reloads it.
  door render DIR [same options] | door remove
  secret get NAME                       Print a secret from the broker, if the policy allows this machine.
  secret env VAR=NAME... -- CMD...      Run CMD with secrets in its environment. Values are not printed.
                                        NAME can be an op://VAULT/ITEM/[SECTION/]FIELD reference: pylon
                                        answers it from its cache, else the broker looks it up.
  secret flush                          Empty the secrets cache of the local pylon.
  claude [ARGS...]                      Run claude with CLAUDE_CODE_OAUTH_TOKEN from the secret claude-oauth-token.
  codex [ARGS...]                       Run codex with CODEX_ACCESS_TOKEN from the secret codex-access-token.
  trust [--principal NAME] | untrust    Add or remove the CA line in ~/.ssh/authorized_keys.
  timer install | timer remove          Schedule renew every hour.
  status
  doctor                                Print the state directory and its file system type. Warn when it is
                                        on a network file system (NFS, Lustre, GPFS, SMB, BeeGFS).
                                        FLEET_STATE_DIR moves the state directory (default
                                        ~/.local/state/fleet) to node-local disk; services get it too.
  uninstall [--yes] [--keep-cert]       Revoke this machine's certificate, stop the fleet services
                                        (renew, agent, tunnels, door), remove the authorized_keys CA line,
                                        and delete the fleet keys and settings. Alias: remove.
  install-step                          Linux: install the pinned step CLI into ~/.local/bin (~/.local/<arch>/bin on no-sudo hosts).
  install-pylon                         Install the pinned pylon from the broker into the same folder, and restart
                                        the agent, also when the binary was current. Fails when the restart fails.

EOF
}

valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$ ]]; }
# An SSH destination. A leading - would make ssh read it as an option, so callers also pass --.
valid_ssh_host() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9@._-]*$ ]]; }
valid_url() { [[ "$1" =~ ^https://[A-Za-z0-9.:-]+(/[A-Za-z0-9._/-]*)?$ ]]; }
valid_fingerprint() { [[ "$1" =~ ^[0-9a-f]{64}$ ]]; }
valid_principal() { [[ "$1" =~ ^[a-z_][a-z0-9_.-]{0,31}$ ]]; }
valid_item() { [[ "$1" =~ ^op://[A-Za-z0-9\ ._-]+/[A-Za-z0-9\ ._-]+$ ]]; }
valid_token() { [[ "$1" =~ ^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$ ]]; }

declare ca_url="" fingerprint="" name="" enroll_item="" admin_item="" broker_url="" principal=""

load_config() {
    [[ -f "$CONFIG" ]] || return 0
    local key value
    while IFS='=' read -r key value; do
        case "$key" in
            ca_url) valid_url "$value" && ca_url="$value" ;;
            fingerprint) valid_fingerprint "$value" && fingerprint="$value" ;;
            name) valid_name "$value" && name="$value" ;;
            enroll_item) valid_item "$value" && enroll_item="$value" ;;
            admin_item) valid_item "$value" && admin_item="$value" ;;
            broker_url) valid_url "$value" && broker_url="$value" ;;
            principal) valid_principal "$value" && principal="$value" ;;
        esac
    done < "$CONFIG"
    return 0
}

save_config() {
    mkdir -p "$CONFIG_DIR"
    local tmp
    tmp=$(mktemp "$CONFIG_DIR/.config.XXXXXX")
    {
        [[ -n "$ca_url" ]] && printf 'ca_url=%s\n' "$ca_url"
        [[ -n "$fingerprint" ]] && printf 'fingerprint=%s\n' "$fingerprint"
        [[ -n "$name" ]] && printf 'name=%s\n' "$name"
        [[ -n "$enroll_item" ]] && printf 'enroll_item=%s\n' "$enroll_item"
        [[ -n "$admin_item" ]] && printf 'admin_item=%s\n' "$admin_item"
        [[ -n "$broker_url" ]] && printf 'broker_url=%s\n' "$broker_url"
        [[ -n "$principal" ]] && printf 'principal=%s\n' "$principal"
        true
    } > "$tmp"
    mv "$tmp" "$CONFIG"
}

step_arch() {
    case "$(uname -m)" in
        x86_64|amd64) echo amd64 ;;
        aarch64|arm64) echo arm64 ;;
        *) fail "unsupported architecture $(uname -m)" ;;
    esac
}

# Timers run with a minimal PATH, and no-sudo hosts keep step in an arch directory.
find_step() {
    local candidate
    for candidate in "$(command -v step 2>/dev/null || true)" "$HOME/.local/$(uname -m)/bin/step" "$HOME/.local/bin/step" \
                     /opt/homebrew/bin/step /usr/local/bin/step /usr/bin/step; do
        [[ -n "$candidate" && -x "$candidate" ]] && { STEP="$candidate"; return 0; }
    done
    return 1
}

# The shell profiles turn on the no-sudo layout when ~/.local/<arch> exists. Use it only if it is
# already there: on a no-sudo host ~/.local/bin can be shared by machines of other architectures.
local_bin() {
    if [[ -d "$HOME/.local/$(uname -m)" ]]; then echo "$HOME/.local/$(uname -m)/bin"; else echo "$HOME/.local/bin"; fi
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'; else shasum -a 256 "$1" | awk '{print $1}'; fi
}

install_pylon() {
    local target sum_var sum dir have
    target="$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)"
    sum_var="PYLON_SHA256_${target//-/_}"
    sum="${!sum_var:-}"
    [[ -n "$sum" ]] || fail "no pylon build for $target"
    dir=$(local_bin)
    if [[ -x "$dir/pylon" && "$(sha256_of "$dir/pylon")" == "$sum" ]]; then
        printf 'pylon %s is installed in %s\n' "$PYLON_VERSION" "$dir"
    else
        need_enrollment
        need_broker
        mkdir -p "$dir"
        scratch "$dir"
        curl -fsS --connect-timeout 10 --max-time 300 --cert "$STATE/node.crt" --key "$STATE/node.key" \
            --cacert "$STATE/root_ca.crt" -o "$SCRATCH/pylon" "$broker_url/v1/artifacts/pylon/$PYLON_VERSION/$target" ||
            fail "the broker did not return pylon $PYLON_VERSION for $target"
        [[ "$(sha256_of "$SCRATCH/pylon")" == "$sum" ]] || fail "pylon download checksum mismatch; nothing installed"
        chmod 0755 "$SCRATCH/pylon"
        mv -f "$SCRATCH/pylon" "$dir/pylon"
        printf 'installed pylon %s in %s\n' "$PYLON_VERSION" "$dir"
    fi
    restart_agent
}

# SSH sessions without a login session (Tailscale SSH) have no XDG_RUNTIME_DIR, and
# systemctl --user needs it to find the user manager.
user_bus() {
    if [[ "$(uname -s)" == Linux && -z "${XDG_RUNTIME_DIR:-}" && -d "$(user_runtime_dir)" ]]; then
        XDG_RUNTIME_DIR=$(user_runtime_dir)
        export XDG_RUNTIME_DIR
    fi
}

# wait_seconds NAME DEFAULT: a wait setting of 0 would mean no limit to timeout and perl, so only a
# whole number above 0 is valid.
wait_seconds() {
    local value="${!1:-$2}"
    [[ "$value" =~ ^[1-9][0-9]*$ ]] || fail "$1 must be a whole number of seconds more than 0, not '$value'"
    printf '%s\n' "$value"
}

# bounded SECONDS CMD...: CMD, killed after SECONDS. macOS has no timeout without coreutils; perl's
# alarm survives exec and kills the command the same way.
bounded() {
    local seconds="$1"; shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$seconds" "$@"
    else
        perl -e 'alarm shift; exec @ARGV or exit 127' "$seconds" "$@"
    fi
}

# A running agent keeps the old binary until it restarts. Restart it also when the file was current:
# an earlier install can have replaced the file and then failed to restart.
# The restart has a limit (FLEET_RESTART_WAIT, 120 seconds): systemctl waits for the start job.
restart_agent() {
    local wait
    wait=$(wait_seconds FLEET_RESTART_WAIT 120) || exit 1
    if [[ "$(uname -s)" == Darwin ]]; then
        bounded "$wait" launchctl kickstart -k "gui/$(id -u)/dev.fleet.agent" >/dev/null 2>&1 ||
            fail "could not restart the fleet agent (launchd agent dev.fleet.agent) within $wait seconds. Run: fleet agent install"
    else
        user_bus
        command -v systemctl >/dev/null 2>&1 && bounded "$wait" systemctl --user restart fleet-agent.service ||
            fail "could not restart the fleet agent (systemd user service fleet-agent) within $wait seconds. Run: fleet agent install"
    fi
    printf 'restarted the fleet agent\n'
}

install_step() {
    [[ "$(uname -s)" == Linux ]] || fail 'install step with Homebrew on macOS: brew install step'
    local arch sum_var sum dir work
    arch=$(step_arch)
    sum_var="STEP_SHA256_$arch"; sum="${!sum_var}"
    dir=$(local_bin)
    scratch; work="$SCRATCH"
    curl -fsSL -o "$work/step.tgz" "https://github.com/smallstep/cli/releases/download/v$STEP_VERSION/step_linux_$arch.tar.gz"
    printf '%s  %s\n' "$sum" "$work/step.tgz" | sha256sum -c - >/dev/null || fail 'step download checksum mismatch'
    tar -xzf "$work/step.tgz" -C "$work"
    mkdir -p "$dir"
    install -m 0755 "$work/step_linux_$arch/bin/step" "$dir/step"
    STEP="$dir/step"
    printf 'installed %s\n' "$("$STEP" version | head -1)"
}

need_step() {
    find_step && return 0
    [[ "$(uname -s)" == Linux ]] || fail 'step is missing: brew install step'
    install_step
}

need_enrollment() {
    load_config
    [[ -n "$ca_url" && -n "$name" && -f "$STATE/node.crt" && -f "$STATE/node.key" ]] ||
        fail 'not enrolled: run fleet enroll NAME'
}

ca_flags() { CA=(--ca-url "$ca_url" --root "$STATE/root_ca.crt"); }

issue_ssh() {
    ca_flags
    "$STEP" ssh certificate "$name" "$STATE/id_fleet.pub" --sign --force --provisioner fleet \
        --x5c-cert "$STATE/node.crt" --x5c-key "$STATE/node.key" "${CA[@]}" >/dev/null 2>&1 ||
        fail 'could not get an SSH certificate'
}

# Short SSH names (`ssh bb`) come from the broker, so tailnet host names stay out of this
# public script. A broker outage keeps the last list. Each line is checked again here, so a
# line cannot add other SSH options.
ssh_aliases() {
    local list="$SSH_FLEET/hosts" fresh alias host user
    need_broker
    if fresh=$(curl -fsS --connect-timeout 3 --max-time 5 --cert "$STATE/node.crt" --key "$STATE/node.key" \
            --cacert "$STATE/root_ca.crt" -H 'Accept: text/plain' "$broker_url/v1/ssh-hosts" 2>/dev/null); then
        printf '%s\n' "$fresh" > "$list.tmp" && mv "$list.tmp" "$list"
    fi
    [[ -f "$list" ]] || return 0
    # Fields: alias hostname user [jump or -] [host key alias]. A tailnet IP as the hostname, with
    # the name as the host key alias, works where a corporate DNS agent hides tailnet names.
    local key_alias
    while read -r alias host user jump key_alias _; do
        [[ "$alias" =~ ^[a-z0-9][a-z0-9-]{0,62}$ && "$host" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$ &&
           "$user" =~ ^[a-z_][a-z0-9_.-]{0,31}$ ]] || continue
        [[ "$jump" == - ]] && jump=""
        [[ -z "$jump" || "$jump" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || continue
        [[ -z "$key_alias" || "$key_alias" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$ ]] || continue
        # Port 22 explicitly: SSH takes the first value of each option, and a config included later
        # (~/.brev/ssh_config names spark-p with Port 11009) would otherwise set the port.
        printf 'Host %s\n    HostName %s\n    User %s\n    Port 22\n    StrictHostKeyChecking accept-new\n' \
            "$alias" "$host" "$user"
        # if, not &&: a false test as the loop's last command would fail renew under set -e.
        if [[ -n "$jump" ]]; then printf '    ProxyJump %s\n' "$jump"; fi
        if [[ -n "$key_alias" ]]; then printf '    HostKeyAlias %s\n' "$key_alias"; fi
    done < "$list"
}

write_ssh_config() {
    ca_flags
    local host_ca
    host_ca=$("$STEP" ssh config --host --roots "${CA[@]}") || fail 'could not read the SSH host CA'
    mkdir -p "$SSH_FLEET"
    chmod 700 "$HOME/.ssh" "$SSH_FLEET"
    printf '@cert-authority * %s\n' "$host_ca" > "$SSH_FLEET/known_hosts.tmp"
    mv "$SSH_FLEET/known_hosts.tmp" "$SSH_FLEET/known_hosts"
    # Naming any IdentityFile drops the OpenSSH defaults, so list the ones that exist.
    # A missing IdentityFile makes every ssh command print a warning.
    local identities=("$STATE/id_fleet") key
    for key in id_ed25519 id_ecdsa id_ecdsa_sk id_ed25519_sk id_rsa; do
        [[ -f "$HOME/.ssh/$key" ]] && identities+=("$HOME/.ssh/$key")
    done
    local suffix
    suffix=$(tailnet_suffix)
    {
        # OpenSSH uses the first IdentityAgent, so the GitHub block must precede Host *.
        if [[ -f "$SSH_FLEET/agent" && -f "$SSH_FLEET/agent-auth.pub" ]]; then
            printf '%s\n' 'Host github.com'
            printf '    IdentityAgent %s\n' "$(<"$SSH_FLEET/agent")"
            printf '    IdentityFile %s\n' "$SSH_FLEET/agent-auth.pub"
            printf '    IdentitiesOnly yes\n'
        fi
        ssh_aliases
        # No sshd presents a fleet host certificate yet, so a fleet host is trusted on first use. A
        # changed key still fails. WireGuard already authenticates tailnet peers, which keeps the
        # first connection safe; scoping to the tailnet keeps GitHub and other hosts strict.
        local patterns="*.ts.net" octet
        for ((octet = 64; octet < 128; octet++)); do patterns+=" 100.$octet.*"; done
        printf 'Host %s\n    StrictHostKeyChecking accept-new\n' "$patterns"
        printf '%s\n' 'Host *'
        # A bare tailnet name matches no pattern above until ssh expands it to its ts.net name.
        if [[ -n "$suffix" ]]; then
            printf '    CanonicalizeHostname yes\n    CanonicalDomains %s\n    CanonicalizeMaxDots 0\n' "$suffix"
        fi
        printf '    IdentityFile %s\n' "${identities[@]}"
        printf '    CertificateFile %s\n' "$STATE/id_fleet-cert.pub"
        printf '    UserKnownHostsFile %s %s\n' "$HOME/.ssh/known_hosts" "$SSH_FLEET/known_hosts"
    } > "$SSH_FLEET/config.tmp"
    mv "$SSH_FLEET/config.tmp" "$SSH_FLEET/config"
}

edit_authorized_keys() {
    local block="$1" keys="$HOME/.ssh/authorized_keys" tmp
    [[ ! -L "$HOME/.ssh" && ! -L "$keys" ]] || fail 'refusing a symlink at ~/.ssh or ~/.ssh/authorized_keys'
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    tmp=$(mktemp "$HOME/.ssh/.authorized_keys.XXXXXX")
    if [[ -f "$keys" ]]; then
        awk '/^# BEGIN fleet$/{skip=1; next} /^# END fleet$/{skip=0; next} !skip' "$keys" > "$tmp"
    fi
    if [[ -n "$block" ]]; then
        printf '%s\n' "$block" >> "$tmp"
    fi
    if [[ ! -s "$tmp" && ! -f "$keys" ]]; then
        rm -f "$tmp"
        return 0
    fi
    chmod 600 "$tmp"
    mv "$tmp" "$keys"
}

cmd_trust() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --principal) valid_principal "${2:-}" || fail 'invalid principal'; principal="$2"; shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    local wanted="$principal" user_ca
    need_enrollment
    principal="${wanted:-${principal:-ryan}}"
    local p="$principal"
    need_step
    save_config
    ca_flags
    user_ca=$("$STEP" ssh config --roots "${CA[@]}") || fail 'could not read the SSH user CA'
    edit_authorized_keys "$(printf '# BEGIN fleet\ncert-authority,principals="%s" %s\n# END fleet' "$p" "$user_ca")"
}

cmd_untrust() { edit_authorized_keys ""; }

cmd_init() {
    load_config
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ca-url) valid_url "${2:-}" || fail 'invalid --ca-url (https only)'; ca_url="$2"; shift 2 ;;
            --fingerprint) valid_fingerprint "${2:-}" || fail 'invalid --fingerprint (64 hex digits)'; fingerprint="$2"; shift 2 ;;
            --enroll-item) valid_item "${2:-}" || fail 'invalid --enroll-item (op://VAULT/ITEM)'; enroll_item="$2"; shift 2 ;;
            --admin-item) valid_item "${2:-}" || fail 'invalid --admin-item (op://VAULT/ITEM)'; admin_item="$2"; shift 2 ;;
            --broker-url) valid_url "${2:-}" || fail 'invalid --broker-url (https only)'; broker_url="$2"; shift 2 ;;
            --principal) valid_principal "${2:-}" || fail 'invalid principal'; principal="$2"; shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    [[ -n "$ca_url" && -n "$fingerprint" ]] || fail 'init needs --ca-url and --fingerprint'
    save_config
}

# Sets ENROLL to a scratch directory holding the CA root and the provisioner key and password.
# The enroll provisioner issues machine certificates; the admin provisioner issues laptop certificates.
enroll_secrets() {
    local item="${1:-$enroll_item}"
    PROVISIONER="${2:-enroll}"
    [[ -n "$ca_url" && -n "$fingerprint" && -n "$item" ]] ||
        fail 'run fleet init with --ca-url, --fingerprint, and --enroll-item first'
    command -v op >/dev/null || fail 'op is required on this machine'
    need_step
    scratch; ENROLL="$SCRATCH"
    "$STEP" ca root "$ENROLL/root.crt" --ca-url "$ca_url" --fingerprint "$fingerprint" >/dev/null 2>&1 ||
        fail 'could not fetch and check the CA root'
    op read "$item/jwk_encrypted" > "$ENROLL/key"
    op read "$item/password" > "$ENROLL/password"
}

provisioner_token() {
    "$STEP" ca token "$@" --provisioner "$PROVISIONER" --key "$ENROLL/key" --password-file "$ENROLL/password" \
        --not-after "$TOKEN_TTL" --ca-url "$ca_url" --root "$ENROLL/root.crt" 2>/dev/null || fail 'could not mint a token'
}

mint_token() {
    local subject="$1"; shift
    local san_flags=(--san "$subject")
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --san) valid_name "${2:-}" || fail 'invalid --san'; san_flags+=(--san "$2"); shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    enroll_secrets
    provisioner_token "$subject" "${san_flags[@]}"
}

cmd_revoke() {
    [[ $# -eq 1 && "$1" =~ ^[0-9A-Za-z]{1,30}$ ]] || fail 'usage: fleet revoke SERIAL (base62, from fleet list or fleet status)'
    local serial
    serial=$(base62_to_decimal "$1")
    load_config
    enroll_secrets
    local token
    token=$(provisioner_token "$serial" --revoke)
    "$STEP" ca revoke "$serial" --token "$token" --ca-url "$ca_url" --root "$ENROLL/root.crt" >/dev/null 2>&1 ||
        fail 'the CA did not revoke the certificate'
    printf 'revoked %s\n' "$1"
}

cmd_token() {
    [[ $# -ge 1 ]] || fail 'usage: fleet token NAME [--san NAME]...'
    valid_name "$1" || fail 'invalid NAME'
    load_config
    mint_token "$@"
}

cmd_enroll() {
    [[ $# -ge 1 ]] || fail 'usage: fleet enroll NAME [options]'
    load_config
    valid_name "$1" || fail 'invalid NAME'
    name="$1"; shift
    local token="" trust=1
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ca-url) valid_url "${2:-}" || fail 'invalid --ca-url (https only)'; ca_url="$2"; shift 2 ;;
            --fingerprint) valid_fingerprint "${2:-}" || fail 'invalid --fingerprint (64 hex digits)'; fingerprint="$2"; shift 2 ;;
            --token) token="${2:-}"; shift 2 ;;
            --no-trust) trust=0; shift ;;
            --principal) valid_principal "${2:-}" || fail 'invalid principal'; principal="$2"; shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    [[ -n "$ca_url" && -n "$fingerprint" ]] || fail 'enroll needs --ca-url and --fingerprint'
    if [[ -z "$token" ]]; then
        [[ -t 0 ]] && printf 'Paste the enrollment token: ' >&2
        IFS= read -r token || true
    fi
    valid_token "$token" || fail 'the token is not a valid JWT'
    need_step
    mkdir -p "$STATE"
    chmod 700 "$STATE"
    local stage
    scratch "$STATE"; stage="$SCRATCH"
    "$STEP" ca root "$stage/root_ca.crt" --ca-url "$ca_url" --fingerprint "$fingerprint" >/dev/null 2>&1 ||
        fail 'could not fetch the CA root, or its fingerprint does not match'
    "$STEP" ca certificate "$name" "$stage/node.crt" "$stage/node.key" --token "$token" \
        --ca-url "$ca_url" --root "$stage/root_ca.crt" >/dev/null 2>&1 ||
        fail 'the CA rejected the token'
    chmod 600 "$stage/node.key"
    mv -f "$stage/root_ca.crt" "$stage/node.crt" "$stage/node.key" "$STATE/"
    if [[ ! -f "$STATE/id_fleet" ]]; then
        ssh-keygen -q -t ed25519 -N '' -C "fleet:$name" -f "$STATE/id_fleet"
    fi
    save_config
    issue_ssh
    write_ssh_config
    if [[ "$trust" == 1 ]]; then
        cmd_trust
    fi
    [[ "$ENROLL_QUIET" == 1 ]] || printf 'enrolled %s. Run: fleet timer install\n' "$name"
}

import_config() {
    command -v op >/dev/null || fail 'op is required: install 1Password CLI, or run fleet init'
    local field value
    for field in ca_url fingerprint broker_url enroll_item admin_item; do
        value=$(op read "$CONFIG_ITEM/$field") || fail "could not read $CONFIG_ITEM/$field"
        case "$field" in
            ca_url|broker_url) valid_url "$value" || fail "invalid $field in $CONFIG_ITEM" ;;
            fingerprint) valid_fingerprint "$value" || fail "invalid $field in $CONFIG_ITEM" ;;
            *) valid_item "$value" || fail "invalid $field in $CONFIG_ITEM" ;;
        esac
        printf -v "$field" '%s' "$value"
    done
    save_config
}

cmd_login() {
    load_config
    [[ -n "$ca_url" ]] || import_config
    local node="${1:-${name:-$(hostname -s)}}"
    valid_name "$node" || fail 'usage: fleet login [NAME]'
    [[ -n "$admin_item" ]] || fail 'run fleet init --admin-item op://VAULT/ITEM first'
    enroll_secrets "$admin_item" admin
    local token
    token=$(provisioner_token "$node" --san "$node")
    ENROLL_QUIET=1
    cmd_enroll "$node" --token "$token" --no-trust
    cmd_timer install
    printf 'logged in as %s (admin). Renewal runs every hour.\n' "$node"
}

cmd_invite() {
    [[ $# -ge 1 ]] || fail 'usage: fleet invite NAME [--san NAME]... [--dotfiles] [--ephemeral] [--no-trust] [--principal NAME] [--ref COMMIT]'
    valid_name "$1" || fail 'invalid NAME'
    local node="$1"; shift
    load_config
    local token_args=() join_args=() ref=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --san) token_args+=(--san "${2:-}"); shift 2 ;;
            --dotfiles|--ephemeral|--no-trust) join_args+=("$1"); shift ;;
            --principal) valid_principal "${2:-}" || fail 'invalid principal'; join_args+=(--principal "$2"); shift 2 ;;
            --ref) [[ "${2:-}" =~ ^[0-9a-f]{40}$ ]] || fail 'invalid --ref (full commit SHA)'; ref="$2"; shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    local src origin repo
    src="${FLEET_SOURCE:-$(chezmoi source-path 2>/dev/null || true)}"
    [[ -n "$src" && -d "$src/.git" ]] || fail 'cannot find the dotfiles source; set FLEET_SOURCE'
    origin=$(git -C "$src" remote get-url origin)
    case "$origin" in
        git@github.com:*) repo="${origin#git@github.com:}" ;;
        https://github.com/*) repo="${origin#https://github.com/}" ;;
        *) fail "origin is not a GitHub repository: $origin" ;;
    esac
    repo="${repo%.git}"
    [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fail "cannot parse the GitHub repository from $origin"
    # The join script and fleet come from this commit, so it must be on GitHub.
    if [[ -z "$ref" ]]; then
        ref=$(git -C "$src" rev-parse HEAD)
        git -C "$src" branch -r --contains "$ref" 2>/dev/null | grep -q 'origin/' ||
            fail "commit $ref is not on origin; push it first or pass --ref"
    fi
    TOKEN_TTL=15m
    local out
    scratch; out="$SCRATCH"
    mint_token "$node" "${token_args[@]+"${token_args[@]}"}" > "$out/token"
    printf 'Run this on the new machine within 15 minutes. The token works once.\n\n' >&2
    printf "bash -c 'exec bash <(curl -fsSL \"\$0\") \"\$@\"' %s --repo %s --ref %s --name %s --ca-url %s --fingerprint %s --token %s%s\n" \
        "https://raw.githubusercontent.com/$repo/$ref/join.sh" "$repo" "$ref" "$node" "$ca_url" "$fingerprint" \
        "$(<"$out/token")" "${join_args[*]+ ${join_args[*]}}"
}

ephemeral_exit() {
    local rc=$?
    trap - EXIT INT TERM
    local job
    for job in $(jobs -p); do kill "$job" 2>/dev/null || true; wait "$job" 2>/dev/null || true; done
    if [[ -n "${STEP:-}" && -f "$STATE/node.crt" ]]; then
        "$STEP" ca revoke --cert "$STATE/node.crt" --key "$STATE/node.key" --ca-url "$ca_url" \
            --root "$STATE/root_ca.crt" >/dev/null 2>&1 ||
            printf 'fleet: could not revoke the certificate; it expires within 24 hours\n' >&2
    fi
    if [[ -n "${EPHEMERAL_ROOT:-}" ]]; then
        edit_authorized_keys ""
        rm -rf "$SSH_FLEET" "$EPHEMERAL_ROOT"
    fi
    rm -rf "${CLEANUP[@]+"${CLEANUP[@]}"}"
    exit "$rc"
}

cmd_ephemeral() {
    [[ $# -ge 1 ]] || fail 'usage: fleet ephemeral NAME --ca-url URL --fingerprint SHA256 [--no-trust] [--principal NAME]'
    [[ ! -f "$STATE/node.crt" ]] || fail 'this machine has a persistent enrollment; use it instead'
    [[ ! -e "$SSH_FLEET" ]] || fail '~/.ssh/fleet exists; another fleet identity owns the SSH settings'
    local base
    for base in "${XDG_RUNTIME_DIR:-}" /dev/shm "${TMPDIR:-/tmp}"; do
        [[ -n "$base" && -d "$base" && -w "$base" ]] && break
    done
    EPHEMERAL_ROOT=$(mktemp -d "$base/fleet-ephemeral.XXXXXX")
    STATE="$EPHEMERAL_ROOT/state/fleet"
    CONFIG_DIR="$EPHEMERAL_ROOT/config/fleet"
    CONFIG="$CONFIG_DIR/config"
    trap ephemeral_exit EXIT
    trap 'exit 0' INT TERM
    ENROLL_QUIET=1
    cmd_enroll "$@"
    printf 'ephemeral identity %s is active. Keep this running; Ctrl-C revokes it and removes its files.\n' "$name"
    while true; do
        # A signal can land between the fork and $!, so the sleep must not hold this terminal's pipes.
        sleep 3600 </dev/null >/dev/null 2>&1 &
        wait $! || true
        ( cmd_renew ) || printf 'fleet: renew failed; retrying in 1 hour\n' >&2
    done
}

cmd_enroll_remote() {
    [[ $# -ge 2 ]] || fail 'usage: fleet enroll-remote HOST NAME [--san NAME]... [--no-trust] [--principal NAME]'
    local host="$1" node="$2"; shift 2
    valid_ssh_host "$host" || fail 'invalid HOST'
    valid_name "$node" || fail 'invalid NAME'
    load_config
    local token_args=() remote_args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --san) token_args+=(--san "${2:-}"); shift 2 ;;
            --no-trust) remote_args+=(--no-trust); shift ;;
            --principal) valid_principal "${2:-}" || fail 'invalid principal'; remote_args+=(--principal "$2"); shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    local out
    scratch; out="$SCRATCH"
    mint_token "$node" "${token_args[@]+"${token_args[@]}"}" > "$out/token"
    ssh -- "$host" < "$out/token" "~/.local/bin/fleet enroll $node --ca-url $ca_url --fingerprint $fingerprint ${remote_args[*]-}"
}

cmd_renew() {
    local loop=0
    [[ "${1:-}" == --loop ]] && loop=1
    if [[ "$loop" == 1 ]]; then
        while true; do
            "$SELF" renew || printf 'fleet: renew failed; retrying in 1h\n' >&2
            sleep 3600
        done
    fi
    need_enrollment
    door_ca_check
    need_step
    ca_flags
    # pylon renews both certificates with the same rules, without one step process per call.
    # An older pylon has no renew command, so ask first.
    if find_pylon && "$PYLON" renew --help >/dev/null 2>&1; then
        "$PYLON" renew --ca-url "$ca_url" --state "$STATE" --name "$name" >/dev/null ||
            fail 'renewal failed; the certificate is expired or revoked. Enroll again: fleet login on a laptop, or a new token.'
        write_ssh_config
        return
    fi
    local rc=0 ssh_due=0
    "$STEP" certificate needs-renewal "$STATE/node.crt" --expires-in "$X509_RENEW_BEFORE" >/dev/null 2>&1 || rc=$?
    case "$rc" in
        0) "$STEP" ca renew "$STATE/node.crt" "$STATE/node.key" --force "${CA[@]}" >/dev/null 2>&1 ||
               fail 'renewal failed; the certificate is expired or revoked. Enroll again: fleet login on a laptop, or a new token.'
           ssh_due=1 ;;
        1) ;;
        *) fail 'could not read the client certificate' ;;
    esac
    if [[ "$ssh_due" == 0 && -f "$STATE/id_fleet-cert.pub" ]]; then
        rc=0
        "$STEP" ssh needs-renewal "$STATE/id_fleet-cert.pub" --expires-in "$SSH_RENEW_BEFORE" >/dev/null 2>&1 || rc=$?
        [[ "$rc" == 1 ]] || ssh_due=1
    else
        ssh_due=1
    fi
    if [[ "$ssh_due" == 1 ]]; then
        issue_ssh
    fi
    write_ssh_config
}

# A service starts without the caller's environment, so its unit names FLEET_STATE_DIR when it is set.
state_env_systemd() { [[ -z "${FLEET_STATE_DIR:-}" ]] || printf 'Environment=FLEET_STATE_DIR=%s\n' "$FLEET_STATE_DIR"; }
state_env_launchd() {
    [[ -z "${FLEET_STATE_DIR:-}" ]] ||
        printf '    <key>EnvironmentVariables</key><dict><key>FLEET_STATE_DIR</key><string>%s</string></dict>\n' "$FLEET_STATE_DIR"
}

timer_systemd() {
    local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    mkdir -p "$dir"
    {
        printf '%s\n' '[Unit]' 'Description=Renew fleet certificates' '' '[Service]' 'Type=oneshot'
        state_env_systemd
        printf '%s\n' "ExecStart=$SELF renew"
    } > "$dir/fleet-renew.service"
    printf '%s\n' '[Unit]' 'Description=Renew fleet certificates every hour' '' '[Timer]' 'OnBootSec=2min' \
        'OnUnitActiveSec=1h' 'Persistent=true' '' '[Install]' 'WantedBy=timers.target' > "$dir/fleet-renew.timer"
    systemctl --user daemon-reload
    systemctl --user enable --now fleet-renew.timer
    if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null || true)" != yes ]]; then
        loginctl enable-linger "$USER" 2>/dev/null ||
            printf 'fleet: linger is off, so the timer stops at logout. Ask an admin for: loginctl enable-linger %s\n' "$USER" >&2
    fi
}

timer_launchd() {
    local plist="$HOME/Library/LaunchAgents/dev.fleet.renew.plist"
    mkdir -p "$(dirname "$plist")"
    cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>dev.fleet.renew</string>
    <key>ProgramArguments</key><array><string>$SELF</string><string>renew</string></array>
$(state_env_launchd)
    <key>StartInterval</key><integer>3600</integer>
    <key>RunAtLoad</key><true/>
</dict>
</plist>
EOF
    launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
}

timer_cron() {
    command -v crontab >/dev/null || fail 'no systemd user session, launchd, or crontab. Run: fleet renew --loop'
    { crontab -l 2>/dev/null | grep -v '# fleet-renew$' || true
      printf '17 * * * * %s%s renew >/dev/null 2>&1 # fleet-renew\n' \
          "${FLEET_STATE_DIR:+FLEET_STATE_DIR=$FLEET_STATE_DIR }" "$SELF"; } | crontab -
}

cmd_timer() {
    case "${1:-}" in
        install)
            if [[ "$(uname -s)" == Darwin ]]; then timer_launchd
            elif systemctl --user show-environment >/dev/null 2>&1; then timer_systemd
            else timer_cron
            fi ;;
        remove)
            if [[ "$(uname -s)" == Darwin ]]; then
                launchctl bootout "gui/$(id -u)" "$HOME/Library/LaunchAgents/dev.fleet.renew.plist" 2>/dev/null || true
                rm -f "$HOME/Library/LaunchAgents/dev.fleet.renew.plist"
            fi
            if systemctl --user show-environment >/dev/null 2>&1; then
                systemctl --user disable --now fleet-renew.timer 2>/dev/null || true
                rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/fleet-renew."{service,timer}
            fi
            if command -v crontab >/dev/null && crontab -l 2>/dev/null | grep -q '# fleet-renew$'; then
                crontab -l | grep -v '# fleet-renew$' | crontab -
            fi ;;
        *) fail 'usage: fleet timer install|remove' ;;
    esac
}

B62=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz

# Serials are 128-bit, too large for shell arithmetic.
serial_of() {
    local hex
    hex=$(openssl x509 -noout -serial -in "$1" 2>/dev/null | sed 's/^serial=//') || true
    if [[ -z "$hex" ]]; then echo unknown
    elif command -v python3 >/dev/null; then
        python3 -c 'import sys; n=int(sys.argv[1], 16); d=sys.argv[2]; o=""
while True:
    n, r = divmod(n, 62); o = d[r] + o
    if not n: break
print(o)' "$hex" "$B62"
    else echo "0x$hex (install python3 for the base62 form)"
    fi
}

base62_to_decimal() {
    command -v python3 >/dev/null || fail 'python3 is required to read a base62 serial'
    python3 -c 'import sys; d=sys.argv[2]; n=0
for ch in sys.argv[1]: n = n * 62 + d.index(ch)
print(n)' "$1" "$B62"
}

cmd_list() {
    local accept='text/plain' query=''
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) accept='application/json'; shift ;;
            -a|--all) query='?all=1'; shift ;;
            *) fail "unknown option $1" ;;
        esac
    done
    need_enrollment
    need_broker
    curl -fsS --cert "$STATE/node.crt" --key "$STATE/node.key" --cacert "$STATE/root_ca.crt" \
        -H "Accept: $accept" "$broker_url/v1/machines$query" ||
        fail 'the broker refused the request; fleet list needs a certificate from fleet login'
}

valid_secret() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]]; }

# The broker runs on the CA host, as the agent port does. A saved broker_url overrides this.
need_broker() {
    if [[ -z "$broker_url" ]]; then
        local host="${ca_url#https://}"; host="${host%%/*}"; host="${host%%:*}"
        [[ -n "$host" ]] || fail 'run fleet init --broker-url https://HOST:PORT first'
        broker_url="https://$host:8443"
    fi
}

valid_ref() {
    local part='[A-Za-z0-9 ._-]+'
    [[ "$1" =~ ^op://$part/$part/($part/)?$part$ ]]
}

# The characters that valid_ref allows need only these escapes in a query string.
encode_ref() {
    local s="${1// /%20}"
    s="${s//:/%3A}"; s="${s//\//%2F}"
    printf '%s' "$s"
}

secrets_sock() {
    if [[ -n "${FLEET_SECRETS_SOCK:-}" ]]; then
        printf '%s' "$FLEET_SECRETS_SOCK"
    else
        local agent; agent=$(agent_sock)
        if [[ "$agent" == */fleet-agent.sock ]]; then
            printf '%s' "${agent%/*}/fleet-secrets.sock"
        else
            printf '%s' "$SSH_FLEET/secrets.sock"
        fi
    fi
}

# pylon keeps values in memory for a short time. If it is not running or fails, ask the broker.
ref_value() {
    valid_ref "$1" || fail "invalid secret reference: $1"
    local sock query
    sock=$(secrets_sock)
    query="ref=$(encode_ref "$1")"
    if [[ -S "$sock" ]] && curl -fsS --unix-socket "$sock" "http://pylon/v1/secrets?$query" 2>/dev/null; then
        return 0
    fi
    need_enrollment
    need_broker
    curl -fsS --cert "$STATE/node.crt" --key "$STATE/node.key" --cacert "$STATE/root_ca.crt" \
        -H 'Accept: application/octet-stream' "$broker_url/v1/secrets?$query" ||
        fail "the broker did not return the secret $1"
}

secret_value() {
    if [[ "$1" == op://* ]]; then
        ref_value "$1"
        return
    fi
    valid_secret "$1" || fail "invalid secret name: $1"
    need_enrollment
    need_broker
    curl -fsS --cert "$STATE/node.crt" --key "$STATE/node.key" --cacert "$STATE/root_ca.crt" \
        -H 'Accept: application/octet-stream' "$broker_url/v1/secrets/$1" ||
        fail "the broker did not return the secret $1"
}

cmd_secret() {
    case "${1:-}" in
        get)
            [[ $# -eq 2 ]] || fail 'usage: fleet secret get NAME'
            secret_value "$2" ;;
        env)
            shift
            local pair var value
            local -a pairs=()
            while [[ $# -gt 0 && "$1" != -- ]]; do pairs+=("$1"); shift; done
            [[ "${1:-}" == -- && $# -ge 2 && ${#pairs[@]} -gt 0 ]] || fail 'usage: fleet secret env VAR=NAME... -- CMD...'
            shift
            for pair in "${pairs[@]}"; do
                var="${pair%%=*}"
                [[ "$var" =~ ^[A-Z_][A-Z0-9_]*$ && "$pair" == *=* ]] || fail "invalid VAR=NAME: $pair"
                value=$(secret_value "${pair#*=}") || exit 1
                export "$var=$value"
            done
            exec "$@" ;;
        flush)
            [[ $# -eq 1 ]] || fail 'usage: fleet secret flush'
            local sock; sock=$(secrets_sock)
            [[ -S "$sock" ]] || fail "pylon does not serve secrets on $sock"
            curl -fsS --unix-socket "$sock" -X POST http://pylon/v1/flush >/dev/null || fail 'pylon did not flush its cache'
            echo 'flushed the pylon secrets cache' ;;
        *) fail 'usage: fleet secret get NAME | fleet secret env VAR=NAME... -- CMD... | fleet secret flush' ;;
    esac
}

# The user's runtime folder when XDG_RUNTIME_DIR is unset. FLEET_RUNTIME_BASE lets tests use their
# own folder: a test that falls back to /run/user/UID would reach the host's live sockets.
user_runtime_dir() {
    printf '%s' "${XDG_RUNTIME_DIR:-${FLEET_RUNTIME_BASE:-/run/user}/$(id -u)}"
}

# Unix socket paths are limited to 104 bytes on macOS and 108 on Linux.
agent_sock() {
    if [[ -n "${FLEET_AGENT_SOCK:-}" ]]; then
        printf '%s' "$FLEET_AGENT_SOCK"
    elif [[ "$(uname -s)" == Linux && -d "$(user_runtime_dir)" ]]; then
        # The systemd user service always has XDG_RUNTIME_DIR. Some SSH sessions (Tailscale SSH)
        # do not, so fall back to the same directory, or install looks for the wrong socket.
        printf '%s' "$(user_runtime_dir)/fleet-agent.sock"
    else
        printf '%s' "$SSH_FLEET/agent.sock"
    fi
}

find_pylon() {
    local candidate candidates=("${FLEET_PYLON:-}")
    [[ -n "${FLEET_PYLON:-}" ]] || candidates=("$(command -v pylon 2>/dev/null || true)" "$(local_bin)/pylon")
    for candidate in "${candidates[@]}"; do
        [[ -n "$candidate" && -x "$candidate" ]] && { PYLON="$candidate"; return 0; }
    done
    return 1
}

find_tailscale() {
    local candidate candidates=("${FLEET_TAILSCALE:-}")
    [[ -n "${FLEET_TAILSCALE:-}" ]] || candidates=("$(command -v tailscale 2>/dev/null || true)"
        /Applications/Tailscale.app/Contents/MacOS/Tailscale)
    for candidate in "${candidates[@]}"; do
        [[ -n "$candidate" && -x "$candidate" ]] && { TAILSCALE="$candidate"; return 0; }
    done
    return 1
}

# Print the tailnet's MagicDNS suffix, or nothing when tailscale is missing, stopped, or odd.
tailnet_suffix() {
    local suffix=""
    find_tailscale || return 0
    suffix=$("$TAILSCALE" status --json 2>/dev/null |
        sed -n 's/^ *"MagicDNSSuffix": *"\([^"]*\)".*/\1/p' | head -n 1) || true
    if [[ "$suffix" =~ ^[a-z0-9-]+(\.[a-z0-9-]+)*\.ts\.net$ ]]; then printf '%s\n' "$suffix"; fi
}

find_socat() {
    local candidate candidates=("${FLEET_SOCAT:-}")
    [[ -n "${FLEET_SOCAT:-}" ]] || candidates=("$(command -v socat 2>/dev/null || true)" /opt/homebrew/bin/socat
        /usr/local/bin/socat "$HOME/.pixi/bin/socat" "$HOME/.local/$(uname -m)/pixi/bin/socat" /usr/bin/socat)
    for candidate in "${candidates[@]}"; do
        [[ -n "$candidate" && -x "$candidate" ]] && { SOCAT="$candidate"; return 0; }
    done
    return 1
}

# pylon keeps a warm connection and caches the key list (about 0.15 s per signature). socat opens
# a new mTLS connection for each agent client (about 0.5 s). Both read the renewed certificate.
find_bridge() {
    find_pylon || find_socat || fail 'pylon or socat is required. Run chezmoi apply, or install one of them.'
}

agent_run() {
    need_enrollment
    local sock host addr
    sock=$(agent_sock)
    (( ${#sock} <= 100 )) || fail "the agent socket path is too long (${#sock} bytes): $sock. Set FLEET_AGENT_SOCK."
    find_bridge
    host="${ca_url#https://}"; host="${host%%/*}"; host="${host%%:*}"
    addr="${FLEET_AGENT_ADDR:-$host:8444}"
    mkdir -p "$(dirname "$sock")"
    if [[ -n "${PYLON:-}" ]]; then
        local -a secrets=()
        # An older pylon has no secrets socket. Turn it on only when this pylon has the flag.
        if "$PYLON" agent --help 2>/dev/null | grep -q -- --secrets-socket; then
            need_broker
            secrets=(--secrets-socket "$(secrets_sock)" --broker-url "$broker_url")
        fi
        exec "$PYLON" agent --socket "$sock" --broker "$addr" \
            --cert "$STATE/node.crt" --key "$STATE/node.key" --ca "$STATE/root_ca.crt" ${secrets[@]+"${secrets[@]}"}
    fi
    exec "$SOCAT" "UNIX-LISTEN:$sock,fork,unlink-early,mode=600" \
        "OPENSSL:$addr,cert=$STATE/node.crt,key=$STATE/node.key,cafile=$STATE/root_ca.crt,verify=1"
}

agent_install() {
    need_enrollment
    find_bridge
    local sock
    sock=$(agent_sock)
    if [[ "$(uname -s)" == Darwin ]]; then
        local plist="$HOME/Library/LaunchAgents/dev.fleet.agent.plist"
        mkdir -p "$(dirname "$plist")" "$HOME/Library/Logs"
        cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>dev.fleet.agent</string>
    <key>ProgramArguments</key><array><string>$SELF</string><string>agent</string></array>
$(state_env_launchd)
    <key>KeepAlive</key><true/>
    <key>RunAtLoad</key><true/>
    <key>StandardErrorPath</key><string>$HOME/Library/Logs/fleet-agent.log</string>
</dict>
</plist>
EOF
        launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true
        launchctl bootstrap "gui/$(id -u)" "$plist"
    elif systemctl --user show-environment >/dev/null 2>&1; then
        local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
        mkdir -p "$dir"
        {
            printf '%s\n' '[Unit]' 'Description=Fleet SSH agent bridge' '' '[Service]'
            state_env_systemd
            printf '%s\n' "ExecStart=$SELF agent" 'Restart=always' 'RestartSec=5' '' '[Install]' 'WantedBy=default.target'
        } > "$dir/fleet-agent.service"
        systemctl --user daemon-reload
        systemctl --user enable --now fleet-agent.service
    else
        fail 'no launchd or systemd user session. Run fleet agent in the foreground, for example in a Zellij pane.'
    fi
    wire_agent "$sock"
    printf 'agent running. git signs and GitHub logs in through it. For other tools: export SSH_AUTH_SOCK=%s\n' "$sock"
}

# Point git signing and GitHub SSH at the agent. The signing key comes from the agent itself.
wire_agent() {
    local sock="$1" pub="" auth="" i keys
    for ((i = 0; i < ${FLEET_AGENT_WAIT:-15}; i++)); do
        keys=$(SSH_AUTH_SOCK="$sock" ssh-add -L 2>/dev/null) || true
        pub=$(awk '/ fleet agent-signing$/ {print $1, $2; exit}' <<<"$keys")
        auth=$(awk '/ fleet agent-auth$/ {print; exit}' <<<"$keys")
        [[ -n "$pub" ]] && break
        sleep 1
    done
    [[ -n "$pub" ]] || fail "the agent at $sock does not list the fleet agent-signing key"
    mkdir -p "$SSH_FLEET"
    if [[ -n "$auth" ]]; then
        printf '%s\n' "$auth" > "$SSH_FLEET/agent-auth.pub"
    else
        rm -f "$SSH_FLEET/agent-auth.pub"
    fi
    {
        [[ -f "$HOME/.ssh/allowed_signers" ]] && cat "$HOME/.ssh/allowed_signers"
        printf '* %s\n' "$pub"
    } > "$SSH_FLEET/allowed_signers.tmp"
    mv "$SSH_FLEET/allowed_signers.tmp" "$SSH_FLEET/allowed_signers"
    # A key file rather than key::<key>: git before 2.35 (Ubuntu 22.04 ships 2.34) treats the
    # key:: form as a path and cannot sign.
    printf '%s fleet agent-signing\n' "$pub" > "$SSH_FLEET/agent-signing.pub"
    cat > "$SSH_FLEET/gitconfig.tmp" <<EOF
[user]
    signingkey = $SSH_FLEET/agent-signing.pub
[gpg]
    format = ssh
[gpg "ssh"]
    program = $HOME/.local/bin/fleet-ssh-keygen
    allowedSignersFile = $SSH_FLEET/allowed_signers
[commit]
    gpgsign = true
EOF
    mv "$SSH_FLEET/gitconfig.tmp" "$SSH_FLEET/gitconfig"
    printf '%s\n' "$sock" > "$SSH_FLEET/agent"
    need_step
    write_ssh_config
}

agent_remove() {
    if [[ "$(uname -s)" == Darwin ]]; then
        launchctl bootout "gui/$(id -u)" "$HOME/Library/LaunchAgents/dev.fleet.agent.plist" 2>/dev/null || true
        rm -f "$HOME/Library/LaunchAgents/dev.fleet.agent.plist"
    elif systemctl --user show-environment >/dev/null 2>&1; then
        systemctl --user disable --now fleet-agent.service 2>/dev/null || true
        rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/fleet-agent.service"
    fi
    rm -f "$(agent_sock)" "$SSH_FLEET/agent" "$SSH_FLEET/gitconfig" "$SSH_FLEET/allowed_signers" \
        "$SSH_FLEET/agent-auth.pub" "$SSH_FLEET/agent-signing.pub"
    load_config
    if [[ -n "$ca_url" && -f "$STATE/node.crt" ]] && find_step; then
        write_ssh_config
    fi
}

# Tunnels carry a TCP service between fleet machines, gated by fleet certificates:
#   client  loopback listener -> mTLS to a server, which must present the certificate of --peer
#   server  mTLS listener that accepts only fleet certificates -> a local TCP service
#   gate    mTLS listener (fleet certificates only, optional source allowlist) -> TCP to a server,
#           for a machine on two networks. A client reaches the server through it with --via: the
#           client's TLS to the server runs inside its TLS to the gate, so the gate admits only
#           fleet machines and never sees the traffic, and the server sees the client's own name.
# socat reads the certificate when each client connection opens. A server reads it at start,
# so its service restarts every 6 hours, well inside the 24-hour lifetime.
TUNNELS="$CONFIG_DIR/tunnels"
valid_addr() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*:[0-9]{1,5}$ ]]; }
valid_cidr() { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$ ]]; }

tunnel_unit_install() {
    local tname="$1" mode="$2"
    [[ -n "${FLEET_TUNNEL_NO_SERVICE:-}" ]] && return 0
    if [[ "$(uname -s)" == Darwin ]]; then
        local plist="$HOME/Library/LaunchAgents/dev.fleet.tunnel.$tname.plist"
        mkdir -p "$(dirname "$plist")" "$HOME/Library/Logs"
        cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>dev.fleet.tunnel.$tname</string>
    <key>ProgramArguments</key><array><string>$SELF</string><string>tunnel</string><string>run</string><string>$tname</string></array>
$(state_env_launchd)
    <key>KeepAlive</key><true/>
    <key>RunAtLoad</key><true/>
    <key>StandardErrorPath</key><string>$HOME/Library/Logs/fleet-tunnel-$tname.log</string>
</dict>
</plist>
EOF
        launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true
        launchctl bootstrap "gui/$(id -u)" "$plist"
    elif systemctl --user show-environment >/dev/null 2>&1; then
        local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
        mkdir -p "$dir"
        {
            printf '%s\n' '[Unit]' "Description=Fleet tunnel $tname ($mode)" '' '[Service]'
            state_env_systemd
            printf '%s\n' "ExecStart=$SELF tunnel run $tname" 'Restart=always' 'RestartSec=5'
            [[ "$mode" != client ]] && printf '%s\n' 'RuntimeMaxSec=6h'
            printf '%s\n' '' '[Install]' 'WantedBy=default.target'
        } > "$dir/fleet-tunnel-$tname.service"
        systemctl --user daemon-reload
        systemctl --user enable --now "fleet-tunnel-$tname.service" >/dev/null
        systemctl --user restart "fleet-tunnel-$tname.service"
    else
        fail 'no launchd or systemd user session. Run fleet tunnel run NAME in the foreground.'
    fi
}

cmd_tunnel() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        add)
            local tname="${1:-}" mode="" listen="" to="" peer="" allow="" via="" via_peer=""
            shift || true
            [[ "$tname" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || fail 'usage: fleet tunnel add NAME --mode client|server|gate --listen HOST:PORT --to HOST:PORT [--peer NAME] [--via HOST:PORT --via-peer NAME] [--allow CIDR]'
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --mode) mode="${2:-}"; shift 2 ;;
                    --listen) listen="${2:-}"; shift 2 ;;
                    --to) to="${2:-}"; shift 2 ;;
                    --peer) peer="${2:-}"; shift 2 ;;
                    --allow) allow="${2:-}"; shift 2 ;;
                    --via) via="${2:-}"; shift 2 ;;
                    --via-peer) via_peer="${2:-}"; shift 2 ;;
                    *) fail "unknown option $1" ;;
                esac
            done
            [[ "$mode" =~ ^(client|server|gate)$ ]] || fail '--mode must be client, server, or gate'
            valid_addr "$listen" || fail 'invalid --listen (HOST:PORT)'
            valid_addr "$to" || fail 'invalid --to (HOST:PORT)'
            if [[ "$mode" == client ]]; then
                valid_name "$peer" || fail 'a client tunnel needs --peer: the fleet name of the server'
            fi
            if [[ -n "$via" || -n "$via_peer" ]]; then
                [[ "$mode" == client ]] && valid_addr "$via" && valid_name "$via_peer" ||
                    fail '--via HOST:PORT and --via-peer NAME go together, on a client tunnel'
            fi
            [[ -z "$allow" ]] || valid_cidr "$allow" || fail 'invalid --allow (IPv4 CIDR, for example 10.0.0.9/32)'
            need_enrollment
            mkdir -p "$TUNNELS"
            printf 'mode=%s\nlisten=%s\nto=%s\npeer=%s\nallow=%s\nvia=%s\nvia_peer=%s\n' \
                "$mode" "$listen" "$to" "$peer" "$allow" "$via" "$via_peer" > "$TUNNELS/$tname"
            tunnel_unit_install "$tname" "$mode"
            printf 'tunnel %s: %s %s -> %s\n' "$tname" "$mode" "$listen" "$to" ;;
        run)
            local tname="${1:-}" key value mode="" listen="" to="" peer="" allow="" via="" via_peer=""
            [[ "$tname" =~ ^[a-z0-9][a-z0-9-]{0,30}$ && -f "$TUNNELS/$tname" ]] || fail "no tunnel named ${tname:-?}"
            while IFS='=' read -r key value; do
                case "$key" in mode) mode="$value" ;; listen) listen="$value" ;; to) to="$value" ;; peer) peer="$value" ;; allow) allow="$value" ;; via) via="$value" ;; via_peer) via_peer="$value" ;; esac
            done < "$TUNNELS/$tname"
            valid_addr "$listen" && valid_addr "$to" || fail "tunnel $tname has an invalid address"
            [[ -z "$allow" ]] || valid_cidr "$allow" || fail "tunnel $tname has an invalid allow list"
            local range="${allow:+,range=$allow}"
            find_socat || fail 'socat is required for tunnels'
            local lhost="${listen%:*}" lport="${listen##*:}"
            local tls="cert=$STATE/node.crt,key=$STATE/node.key,cafile=$STATE/root_ca.crt,verify=1"
            case "$mode" in
                client)
                    valid_name "$peer" || fail "tunnel $tname has no valid peer"
                    [[ -n "$via" ]] || exec "$SOCAT" "TCP-LISTEN:$lport,bind=$lhost,reuseaddr,fork" "OPENSSL:$to,$tls,commonname=$peer"
                    valid_addr "$via" && valid_name "$via_peer" || fail "tunnel $tname has an invalid via"
                    # Two socat processes: the inner one speaks TLS to the server through a loopback
                    # hop, and the hop wraps that stream in TLS to the gate. The server's name is
                    # checked on the inner connection, so the gate cannot impersonate it.
                    local hop=$((lport + 1)) a b
                    "$SOCAT" "TCP-LISTEN:$hop,bind=127.0.0.1,reuseaddr,fork" "OPENSSL:$via,$tls,commonname=$via_peer" & b=$!
                    "$SOCAT" "TCP-LISTEN:$lport,bind=$lhost,reuseaddr,fork" "OPENSSL:127.0.0.1:$hop,$tls,commonname=$peer" & a=$!
                    trap 'kill "$a" "$b" 2>/dev/null' EXIT INT TERM
                    # macOS ships bash 3.2, which has no wait -n: poll, and stop when either exits.
                    while kill -0 "$a" 2>/dev/null && kill -0 "$b" 2>/dev/null; do sleep 2; done
                    exit 1 ;;
                server)
                    exec "$SOCAT" "OPENSSL-LISTEN:$lport,bind=$lhost,reuseaddr,fork,$tls$range" "TCP:$to" ;;
                gate)
                    exec "$SOCAT" "OPENSSL-LISTEN:$lport,bind=$lhost,reuseaddr,fork,$tls$range" "TCP:$to" ;;
                *) fail "tunnel $tname has an invalid mode" ;;
            esac ;;
        remove)
            local tname="${1:-}"
            [[ "$tname" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || fail 'usage: fleet tunnel remove NAME'
            if [[ "$(uname -s)" == Darwin ]]; then
                launchctl bootout "gui/$(id -u)" "$HOME/Library/LaunchAgents/dev.fleet.tunnel.$tname.plist" 2>/dev/null || true
                rm -f "$HOME/Library/LaunchAgents/dev.fleet.tunnel.$tname.plist"
            elif systemctl --user show-environment >/dev/null 2>&1; then
                systemctl --user disable --now "fleet-tunnel-$tname.service" 2>/dev/null || true
                rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/fleet-tunnel-$tname.service"
                systemctl --user daemon-reload
            fi
            rm -f "$TUNNELS/$tname" ;;
        list)
            local f
            for f in "$TUNNELS"/*; do [[ -f "$f" ]] && printf '%s: %s\n' "${f##*/}" "$(tr '\n' ' ' < "$f")"; done; true ;;
        *) fail 'usage: fleet tunnel add|run|remove|list' ;;
    esac
}

# The door is the public mTLS listener for fleet machines in front of a local TCP service (bb on
# brev). A tunnel server cannot face the internet: socat forks before the TLS handshake, has no
# handshake deadline (only a per-read timeout, which one byte every few seconds defeats), and so a
# few slow clients fill any child limit (task 030 part 3b). nginx's stream module has a deadline for
# the whole handshake (ssl_handshake_timeout, also in Ubuntu 22.04's 1.18), connection limits
# that apply before the handshake, and event-driven workers. It runs as a root system service and
# reads a root-only copy of this machine's certificate; a path unit and a timer copy each renewal
# and reload nginx, then check the certificate it serves. Fleet clients keep fleet tunnel client
# mode, which checks the door's fleet name.
DOOR_PREFIX="${FLEET_DOOR_PREFIX:-}"
DOOR_NGINX="${FLEET_DOOR_NGINX:-/usr/sbin/nginx}"
DOOR_MODULE="${FLEET_DOOR_MODULE:-/usr/lib/nginx/modules/ngx_stream_module.so}"
DOOR_UNITS="fleet-door.service fleet-door-sync.path fleet-door-sync.timer"
DOOR_USAGE='usage: fleet door render DIR|install [--listen HOST:PORT] [--to HOST:PORT] [--per-source N] [--max N] [--handshake-timeout S] | remove'

door_options() {
    door_listen=0.0.0.0:8461 door_to=127.0.0.1:38886 door_per_source=64 door_max=1024 door_deadline=10
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --listen) door_listen="${2:-}"; shift 2 ;;
            --to) door_to="${2:-}"; shift 2 ;;
            --per-source) door_per_source="${2:-}"; shift 2 ;;
            --max) door_max="${2:-}"; shift 2 ;;
            --handshake-timeout) door_deadline="${2:-}"; shift 2 ;;
            *) fail "$DOOR_USAGE" ;;
        esac
    done
    valid_addr "$door_listen" || fail 'invalid --listen (HOST:PORT)'
    # The sync checks the served certificate over loopback, which the total limit does not count.
    [[ "${door_listen%:*}" == 0.0.0.0 || "${door_listen%:*}" =~ ^127\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] ||
        fail 'invalid --listen: the host is 0.0.0.0 or a 127.x.x.x address'
    valid_addr "$door_to" || fail 'invalid --to (HOST:PORT)'
    [[ "$door_per_source" =~ ^[1-9][0-9]{0,4}$ ]] || fail 'invalid --per-source (connections per address)'
    [[ "$door_max" =~ ^[1-9][0-9]{0,4}$ ]] || fail 'invalid --max (connections in all)'
    [[ "$door_deadline" =~ ^[1-9][0-9]?$ && "$door_deadline" -le 60 ]] || fail 'invalid --handshake-timeout (1 to 60 seconds)'
    # The paths go into nginx and systemd files unquoted.
    [[ "$STATE$DOOR_PREFIX$DOOR_NGINX$DOOR_MODULE" =~ ^[A-Za-z0-9/._-]+$ ]] ||
        fail "the fleet state or door paths have characters the door files cannot hold: $STATE"
}

DOOR_FILES="etc/fleet-door/nginx.conf:644 usr/local/libexec/fleet-door-sync:755
etc/systemd/system/fleet-door.service:644 etc/systemd/system/fleet-door-sync.service:644
etc/systemd/system/fleet-door-sync.path:644 etc/systemd/system/fleet-door-sync.timer:644"

# Print one door file. install pipes it to root, so root never installs a file the user can write.
door_file() {
    local p="$DOOR_PREFIX" tls="$DOOR_PREFIX/etc/fleet-door/tls" sync="$DOOR_PREFIX/usr/local/libexec/fleet-door-sync"
    local check="$door_listen"
    [[ "${check%:*}" == 0.0.0.0 ]] && check="127.0.0.1:${check##*:}"
    case "$1" in
        etc/fleet-door/nginx.conf)
            # worker_connections counts both sides of each connection, so it is above twice --max.
            cat <<EOF
# Rendered by fleet door install. Mutual TLS with fleet certificates in front of $door_to.
load_module $DOOR_MODULE;
user www-data;
worker_processes 2;
worker_rlimit_nofile 16384;
pid $p/run/fleet-door.pid;
# A reload starts new workers; old ones keep their connections, for at most this long.
worker_shutdown_timeout 1h;
error_log stderr notice;
events {
    worker_connections 4096;
}
stream {
    limit_conn_zone \$binary_remote_addr zone=door_source:10m;
    # The sync checks the served certificate over loopback, so a full door does not fail that check.
    # A probe to any 127.x.x.x listener comes from 127.0.0.1. That address keeps the limit per
    # address, shared by every local client.
    map \$remote_addr \$door_all_key {
        127.0.0.1 "";
        default \$server_port;
    }
    limit_conn_zone \$door_all_key zone=door_all:1m;
    server {
        listen $door_listen ssl;
        limit_conn door_source $door_per_source;
        limit_conn door_all $door_max;
        ssl_certificate $tls/current/node.crt;
        ssl_certificate_key $tls/current/node.key;
        ssl_client_certificate $tls/current/root_ca.crt;
        ssl_verify_client on;
        ssl_verify_depth 1;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!eNULL:!PSK;
        ssl_handshake_timeout ${door_deadline}s;
        proxy_connect_timeout 5s;
        proxy_timeout 24h;
        proxy_pass $door_to;
    }
}
EOF
            ;;
        usr/local/libexec/fleet-door-sync)
            printf '#!/bin/bash\n# Rendered by fleet door install.\nset -euo pipefail\n'
            printf 'src=%q\ndst=%q\ncheck=%q\nfingerprint=%s\n' "$STATE" "$tls" "$check" "$fingerprint"
            cat <<'EOF'
# copy: copy this machine's fleet certificate for nginx, which reads it as root at start and reload.
# Without an argument, also reload nginx when the copy changed, then check what the door serves.
# nginx reads $dst/current, a link to a complete version folder, so a reload never sees a key from
# one copy and a certificate from another.
stale=28800
say() { printf 'fleet-door: %s\n' "$*" >&2; }
die() { say "$*"; exit 1; }
serial() { openssl x509 -noout -serial | sed 's/^serial=//'; }
umask 077
mkdir -p "$dst"
chmod 700 "$dst"
if [[ "${1:-}" == --locked-copy ]]; then
    [[ -n "${FLEET_DOOR_LOCKED:-}" ]] || die '--locked-copy runs only under the lock'
    tmp=$(mktemp -d "$dst/v.XXXXXX")
    trap 'rm -rf "$tmp" "$dst/.next"' EXIT
    for f in node.crt node.key root_ca.crt; do
        cp -- "$src/$f" "$tmp/$f" 2>/dev/null || die "cannot read $src/$f; is this machine enrolled?"
    done
    # Anyone who runs as the fleet user can write $src; only the CA that enrollment pinned admits clients.
    [[ "$(openssl x509 -noout -fingerprint -sha256 -in "$tmp/root_ca.crt" | sed 's/^.*=//; s/://g' |
          tr 'A-F' 'a-f')" == "$fingerprint" ]] || die "$src/root_ca.crt is not the fleet CA (fingerprint $fingerprint)"
    # fleet renew writes the certificate and the key one after the other; the path unit runs again.
    [[ "$(openssl x509 -noout -pubkey -in "$tmp/node.crt")" == "$(openssl pkey -pubout -in "$tmp/node.key")" ]] ||
        die "the certificate and key in $src do not match; retrying at the next change or timer"
    openssl verify -CAfile "$tmp/root_ca.crt" -untrusted "$tmp/node.crt" "$tmp/node.crt" >/dev/null 2>&1 ||
        die "the certificate in $src is expired or not issued by the fleet CA"
    changed=unchanged
    for f in node.crt node.key root_ca.crt; do cmp -s "$tmp/$f" "$dst/current/$f" || changed=changed; done
    if [[ "$changed" == changed ]]; then
        chmod 700 "$tmp"
        ln -sfn "${tmp##*/}" "$dst/.next"
        # rename(2) replaces the link in one step; mv would move it into the old version folder.
        perl -e 'rename($ARGV[0], $ARGV[1]) or die "fleet-door: $!\n"' "$dst/.next" "$dst/current"
        for old in "$dst"/v.*; do [[ "${old##*/}" == "${tmp##*/}" ]] || rm -rf "$old"; done
        tmp=""
        say "copied certificate serial $(serial < "$dst/current/node.crt")"
    fi
    # A door from before the version folders kept its files here.
    rm -f "$dst/node.crt" "$dst/node.key" "$dst/root_ca.crt"
    echo "$changed"
    exit 0
fi
# ExecStartPre, the path unit, and the timer can run at once, so the copy and the swap run under a
# lock. The lock ends before the reload: systemctl reload waits for a start in progress, and that
# start's ExecStartPre waits for the lock.
changed=$(FLEET_DOOR_LOCKED=1 perl -MFcntl=:flock -e 'BEGIN { $^F = 255 }
    open(my $lock, ">>", shift) or die "fleet-door: lock: $!\n";
    flock($lock, LOCK_EX) or die "fleet-door: lock: $!\n";
    exec { $ARGV[0] } @ARGV or die "fleet-door: $!\n"' "$dst/.lock" "$0" --locked-copy)
[[ "${1:-}" == copy ]] && exit 0
# Each probe is bounded, and so is the whole check: a door that accepts and never answers fails it.
want=$(serial < "$dst/current/node.crt") served="" served_file=$(mktemp)
trap 'rm -f "$served_file"' EXIT
probe() {
    timeout 5 openssl s_client -connect "$check" -tls1_3 </dev/null 2>/dev/null |
        openssl x509 > "$served_file" 2>/dev/null || true
    served=$(serial < "$served_file" 2>/dev/null || true)
}
# Reload when the copy changed, and also when the door serves another serial: an earlier reload
# may have failed, or an earlier run may have stopped between the swap and the reload. A probe that
# gets no certificate is not another serial: reloading a door that does not answer hides the fault.
if [[ "$changed" == unchanged ]]; then probe; fi
if [[ "$changed" != unchanged || ( -n "$served" && "$served" != "$want" ) ]]; then
    systemctl reload fleet-door.service || die 'could not reload fleet-door.service'
fi
# A reload that nginx rejects keeps the old certificate, so check the served one, not the copy.
end=$((SECONDS + 20))
while [[ "$served" != "$want" ]] && (( SECONDS < end )); do
    sleep 0.5
    probe
done
[[ "$served" == "$want" ]] || die "the door at $check serves serial ${served:-none}, not $want"
openssl x509 -noout -checkend "$stale" -in "$served_file" >/dev/null ||
    die "the served certificate expires within 8 hours; check fleet renew on this machine"
EOF
            ;;
        etc/systemd/system/fleet-door.service)
            # nginx measured on Ubuntu 22.04's 1.18: about 60 KB per connection, so 1024 connections take
            # about 70 MB; a reload can keep a second set of workers for up to an hour. TasksMax and
            # MemoryMax leave room for that and stop a runaway.
            printf '%s\n' '[Unit]' "Description=Fleet door: mTLS on $door_listen to $door_to" \
                'After=network-online.target' 'Wants=network-online.target' 'StartLimitIntervalSec=0' '' '[Service]' \
                "ExecStartPre=$sync copy" "ExecStart=$DOOR_NGINX -c $p/etc/fleet-door/nginx.conf -g 'daemon off;'" \
                'ExecReload=/bin/kill -HUP $MAINPID' 'Restart=always' 'RestartSec=5' 'TasksMax=32' 'MemoryMax=256M' \
                'LimitNOFILE=16384' 'NoNewPrivileges=yes' 'ProtectSystem=full' "ReadWritePaths=$tls" 'PrivateTmp=yes' \
                '' '[Install]' 'WantedBy=multi-user.target' ;;
        etc/systemd/system/fleet-door-sync.service)
            printf '%s\n' '[Unit]' 'Description=Copy the fleet certificate to the fleet door and check what it serves' \
                '' '[Service]' 'Type=oneshot' "ExecStart=$sync" ;;
        etc/systemd/system/fleet-door-sync.path)
            printf '%s\n' '[Unit]' 'Description=Refresh the fleet door when the fleet certificate changes' '' '[Path]' \
                "PathChanged=$STATE/node.crt" "PathChanged=$STATE/node.key" 'Unit=fleet-door-sync.service' '' \
                '[Install]' 'WantedBy=multi-user.target' ;;
        etc/systemd/system/fleet-door-sync.timer)
            printf '%s\n' '[Unit]' 'Description=Retry the fleet door refresh and check for a stale certificate' '' \
                '[Timer]' 'OnBootSec=2min' 'OnUnitActiveSec=15min' '' '[Install]' 'WantedBy=timers.target' ;;
    esac
}

# The sync runs as root but reads the user's state, so it trusts only the CA that enrollment pinned.
door_fingerprint() {
    load_config
    [[ -n "$fingerprint" ]] || fail 'no fleet CA fingerprint in the fleet config; enroll this machine first'
}

door_render() {
    local out="$1" entry rel
    door_fingerprint
    for entry in $DOOR_FILES; do
        rel="${entry%:*}"
        mkdir -p "$out/$(dirname "$rel")"
        door_file "$rel" > "$out/$rel"
        chmod "${entry##*:}" "$out/$rel"
    done
}

# The door copies the CA that enrollment pinned into its sync script. A new fleet CA needs a new install.
door_ca_check() {
    local installed
    installed=$(sed -n 's/^fingerprint=//p' "$DOOR_PREFIX/usr/local/libexec/fleet-door-sync" 2>/dev/null || true)
    [[ -z "$installed" || "$installed" == "$fingerprint" ]] ||
        printf 'fleet: the fleet door trusts CA %s, but this machine is enrolled with CA %s. Run fleet door install again.\n' \
            "$installed" "$fingerprint" >&2
}

door_remove() {
    local p="$DOOR_PREFIX"
    # shellcheck disable=SC2086
    sudo systemctl disable --now $DOOR_UNITS 2>/dev/null || true
    sudo rm -rf "$p/etc/fleet-door" "$p/usr/local/libexec/fleet-door-sync" "$p/etc/systemd/system/fleet-door.service" \
        "$p/etc/systemd/system/fleet-door-sync.service" "$p/etc/systemd/system/fleet-door-sync.path" \
        "$p/etc/systemd/system/fleet-door-sync.timer"
    sudo systemctl daemon-reload 2>/dev/null || true
}

cmd_door() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        render)
            [[ -n "${1:-}" ]] || fail "$DOOR_USAGE"
            local out="$1"; shift
            door_options "$@"
            door_render "$out" ;;
        install)
            door_options "$@"
            need_enrollment
            [[ -x "$DOOR_NGINX" && -f "$DOOR_MODULE" ]] ||
                fail "nginx with the stream module is required: sudo apt-get install nginx-core libnginx-mod-stream"
            door_fingerprint
            local p="$DOOR_PREFIX" entry rel content
            # sudo -v asks for a password when any sudoers rule needs one, even beside a NOPASSWD
            # rule, so try a command without a password first.
            sudo -n true 2>/dev/null || sudo -v
            sudo install -d -m 755 "$p/etc/fleet-door" "$p/usr/local/libexec" "$p/etc/systemd/system"
            sudo install -d -m 700 "$p/etc/fleet-door/tls"
            # Each file goes to root on stdin and lands in a root-owned folder: no file the user can
            # write is installed, so nothing can be swapped in while sudo asks for a password.
            for entry in $DOOR_FILES; do
                rel="${entry%:*}"
                # Render first: a render that fails stops the install before root writes anything.
                content=$(door_file "$rel")
                printf '%s\n' "$content" |
                    sudo sh -c 'umask 077; cat > "$1.new" && chmod "$2" "$1.new" && mv -f "$1.new" "$1"' \
                    sh "$p/$rel" "${entry##*:}"
            done
            sudo systemctl daemon-reload
            # shellcheck disable=SC2086
            sudo systemctl enable $DOOR_UNITS
            sudo systemctl restart fleet-door.service
            sudo systemctl restart fleet-door-sync.path fleet-door-sync.timer
            # The first sync checks that the door serves this machine's certificate.
            sudo systemctl start fleet-door-sync.service
            printf 'fleet door: %s -> %s, %s per address, %s in all, handshake within %ss\n' \
                "$door_listen" "$door_to" "$door_per_source" "$door_max" "$door_deadline" ;;
        remove)
            [[ $# -eq 0 ]] || fail "$DOOR_USAGE"
            door_remove ;;
        *) fail "$DOOR_USAGE" ;;
    esac
}

# Remove everything fleet set up on this machine. The dotfiles still own the fleet script and the
# Include line in ~/.ssh/config, which is harmless once ~/.ssh/fleet is gone.
cmd_uninstall() {
    local yes=0 keep=0 answer f
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes) yes=1; shift ;;
            --keep-cert) keep=1; shift ;;
            *) fail 'usage: fleet uninstall [--yes] [--keep-cert]' ;;
        esac
    done
    load_config
    if [[ "$yes" == 0 ]]; then
        [[ -t 0 ]] || fail 'refusing to uninstall without a terminal to confirm; pass --yes'
        printf 'Remove fleet from this machine%s: revoke its certificate, stop its services, and delete its keys? [y/N] ' \
            "${name:+ ($name)}"
        read -r answer
        [[ "$answer" =~ ^[Yy] ]] || fail 'cancelled'
    fi
    local revoked=kept
    if [[ "$keep" == 0 && -f "$STATE/node.crt" && -n "$ca_url" ]]; then
        # Revoke with the certificate itself, so a removed machine is cut off now, not in 24 hours.
        if find_step && "$STEP" ca revoke --cert "$STATE/node.crt" --key "$STATE/node.key" --ca-url "$ca_url" \
                --root "$STATE/root_ca.crt" >/dev/null 2>&1; then
            revoked=revoked
        else
            revoked='not revoked (the CA did not answer; it expires within 24 hours)'
        fi
    fi
    for f in "$TUNNELS"/*; do
        [[ -f "$f" ]] && cmd_tunnel remove "${f##*/}"
    done
    # The door reads this machine's certificate, which is deleted below.
    [[ -f "$DOOR_PREFIX/etc/systemd/system/fleet-door.service" ]] && door_remove
    if [[ "$(uname -s)" == Darwin ]]; then
        launchctl bootout "gui/$(id -u)" "$HOME/Library/LaunchAgents/dev.fleet.agent.plist" 2>/dev/null || true
        rm -f "$HOME/Library/LaunchAgents/dev.fleet.agent.plist"
    elif systemctl --user show-environment >/dev/null 2>&1; then
        systemctl --user disable --now fleet-agent.service 2>/dev/null || true
        rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/fleet-agent.service"
        systemctl --user daemon-reload 2>/dev/null || true
    fi
    rm -f "$(agent_sock)"
    cmd_timer remove
    edit_authorized_keys ""
    rm -rf "$SSH_FLEET" "$STATE" "$CONFIG_DIR"
    printf 'fleet removed from this machine%s. Certificate: %s.\n' "${name:+ ($name)}" "$revoked"
    printf 'Not removed: pylon (~/.local/bin), and any bb host daemon. Remove the machine from bb with bb machine remove.\n'
}

cmd_agent() {
    case "${1:-run}" in
        run) agent_run ;;
        install) agent_install ;;
        remove) agent_remove ;;
        *) fail 'usage: fleet agent [run|install|remove]' ;;
    esac
}

# network_fs TYPE: true when TYPE, as findmnt, GNU stat -f, or the macOS mount table names it, is a
# network or cluster file system. Shared state there lets two nodes renew one identity at once.
network_fs() {
    case "$(tr '[:upper:]' '[:lower:]' <<<"$1")" in
        nfs|nfs3|nfs4|lustre|gpfs|cifs|smb|smb2|smb3|smbfs|beegfs|afs|ceph|glusterfs|9p|v9fs|davfs|webdav|afpfs|\
        panfs|wekafs|ocfs2|gfs2|sshfs|fuse.sshfs|fuse.glusterfs|fuse.ceph*|fuse.s3fs|fuse.gcsfuse|fuse.rclone|\
        fuse.juicefs|fuse.beegfs) return 0 ;;
        *) return 1 ;;
    esac
}

# fs_type DIR: the file system type of DIR, or nothing when the platform tools cannot tell.
fs_type() {
    if [[ "$(uname -s)" == Darwin ]]; then
        # macOS stat has no file system type. Find the mount point with df, then its type in mount.
        local mp
        mp=$(df -P "$1" 2>/dev/null | awk 'NR == 2 { for (i = 6; i <= NF; i++) printf "%s%s", (i > 6 ? " " : ""), $i }') || true
        [[ -n "$mp" ]] || return 0
        { command -v mount >/dev/null && mount || /sbin/mount; } 2>/dev/null |
            awk -v mp="$mp" '{ i = index($0, " on " mp " ("); if (i) { s = substr($0, i + length(mp) + 6); sub(/[,)].*/, "", s); t = s } }
                END { if (t != "") print t }' || true
    elif command -v findmnt >/dev/null; then
        findmnt -n -o FSTYPE -T "$1" 2>/dev/null || true
    else
        stat -f -c %T "$1" 2>/dev/null || true
    fi
}

cmd_doctor() {
    local dir="$STATE" type
    while [[ ! -e "$dir" ]]; do dir=$(dirname "$dir"); done
    type=$(fs_type "$dir")
    printf 'state: %s (%s)\n' "$STATE" "${type:-file system type unknown}"
    if [[ -n "$type" ]] && network_fs "$type"; then
        printf 'fleet: warning: the state directory %s is on a network file system (%s). Keys and the renewal lock belong on node-local disk; set FLEET_STATE_DIR to a local directory.\n' \
            "$STATE" "$type" >&2
    fi
    return 0
}

cmd_status() {
    load_config
    if [[ -z "$name" || ! -f "$STATE/node.crt" ]]; then
        printf 'not enrolled\n'
        [[ -n "$ca_url" ]] && printf 'ca: %s\n' "$ca_url"
        return 1
    fi
    printf 'name: %s\nca: %s\nserial: %s\n' "$name" "$ca_url" "$(serial_of "$STATE/node.crt")"
    printf 'client certificate: %s\n' "$(openssl x509 -noout -enddate -in "$STATE/node.crt" 2>/dev/null | sed 's/^notAfter=/expires /' || echo unreadable)"
    if [[ -f "$STATE/id_fleet-cert.pub" ]]; then
        printf 'ssh certificate: %s\n' "$(ssh-keygen -Lf "$STATE/id_fleet-cert.pub" 2>/dev/null | sed -n 's/^ *Valid: //p' || echo unreadable)"
    else
        printf 'ssh certificate: missing\n'
    fi
    if grep -q '^# BEGIN fleet$' "$HOME/.ssh/authorized_keys" 2>/dev/null; then
        printf 'trust: authorized_keys accepts principal %s\n' "${principal:-ryan}"
    else
        printf 'trust: off\n'
    fi
    if [[ -f "$SSH_FLEET/agent" ]]; then
        local sock bridge=socat keys
        sock=$(agent_sock)
        find_pylon && bridge=pylon
        if keys=$(SSH_AUTH_SOCK="$sock" ssh-add -L 2>/dev/null); then
            printf 'agent: %s on %s, %s keys\n' "$bridge" "$sock" "$(grep -c . <<<"$keys")"
        else
            printf 'agent: %s on %s, not answering\n' "$bridge" "$sock"
        fi
    else
        printf 'agent: off\n'
    fi
    need_broker
    if [[ "$(curl -fsS --max-time 5 --cert "$STATE/node.crt" --key "$STATE/node.key" --cacert "$STATE/root_ca.crt" \
            -H 'Accept: application/octet-stream' "$broker_url/v1/secrets/fleet-selftest" 2>/dev/null)" == ok ]]; then
        printf 'broker: ok\n'
    else
        printf 'broker: no answer\n'
    fi
}

command="${1:-}"
[[ $# -gt 0 ]] && shift
case "$command" in
    init) cmd_init "$@" ;;
    token) cmd_token "$@" ;;
    enroll) cmd_enroll "$@" ;;
    enroll-remote) cmd_enroll_remote "$@" ;;
    invite) cmd_invite "$@" ;;
    login) cmd_login "$@" ;;
    ephemeral) cmd_ephemeral "$@" ;;
    revoke) cmd_revoke "$@" ;;
    renew) cmd_renew "$@" ;;
    trust) cmd_trust "$@" ;;
    untrust) cmd_untrust ;;
    timer) cmd_timer "$@" ;;
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    list) cmd_list "$@" ;;
    secret) cmd_secret "$@" ;;
    tunnel) cmd_tunnel "$@" ;;
    door) cmd_door "$@" ;;
    uninstall|remove) cmd_uninstall "$@" ;;
    claude) cmd_secret env CLAUDE_CODE_OAUTH_TOKEN=claude-oauth-token -- claude "$@" ;;
    codex) cmd_secret env CODEX_ACCESS_TOKEN=codex-access-token -- codex "$@" ;;
    agent) cmd_agent "$@" ;;
    install-step) install_step ;;
    install-pylon) install_pylon ;;
    -h|--help|help|"") usage ;;
    *) usage >&2; exit 2 ;;
esac
