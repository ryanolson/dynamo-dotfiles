#!/usr/bin/env bash
# Keep tokens and keys out of shell traces.
set +x
set -euo pipefail
umask 077

STEP_VERSION=0.31.0
STEP_SHA256_amd64=2bc654b26ca467848edb764620d6f17febea9d7d3629368b76dd20ce40c6ef32
STEP_SHA256_arm64=3252032aded050abe93a642681995d3e36c66eaf1979da1980bf71b5e8973516
# pylon from agentic-control, served by the broker at /v1/artifacts/pylon/VERSION/TARGET.
# fleet-config/artifacts/publish prints these values.
PYLON_VERSION=0.2.0
PYLON_SHA256_darwin_arm64=fa1fdecfe66ecb805ab81826c1bca6c80b3a82d1ae2f23861c0d58a45235b79a
PYLON_SHA256_linux_aarch64=1c5b04b76d8fd57a0178ad3fa5cb8f82ec1eb7794fec021ffdd7d36fc27f03b3
PYLON_SHA256_linux_x86_64=e709cacffbf78057249cfaa13bcb6f5a20e904c58cba6e5a4060707206f695d7
ACTL_SHA256_darwin_arm64=5669575ca297131091c054bad2e4d36fc48009b602bd690551fd314581aac289
ACTL_SUPERVISOR_SHA256_darwin_arm64=6a2a87bf9ab08b2d5b52b78f747fae305cb8b56003a6b5cb00c6803d3ac14e9a
ACTL_SHA256_linux_aarch64=ba47e7a6d5ff3879dec1f74669016b97c05de737755005a220178af94c457d8d
ACTL_SUPERVISOR_SHA256_linux_aarch64=06b3cceeaba0262b549c0d5e396dc4175d248b1c7c9abc5ad173824a2976fab7
ACTL_SHA256_linux_x86_64=0047f70f4260193f4418848f8ca74b58d27c56d219b329b80b03ea8f80fce9f9
ACTL_SUPERVISOR_SHA256_linux_x86_64=9183e8fe41b36377c568801dc6603aba4bfc9f687d6fa4aa834b09f8e028b4b1
ACTL_VERSION=0.3.0
# actl and actl-supervisor from agentic-control, one pair from one build, served by the broker at
# /v1/artifacts/actl/VERSION/TARGET and /v1/artifacts/actl-supervisor/VERSION/TARGET.
# fleet-config/artifacts/release actl inserts ACTL_VERSION and the ACTL_SHA256_* and
# ACTL_SUPERVISOR_SHA256_* lines after the last checksum line, above this comment. When they are
# absent, the commands that need actl stop.

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/fleet"
CONFIG="$CONFIG_DIR/config"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/fleet"
# The actl fleet deployment (task 029). Tasks fetch the public dotfiles at a commit, without credentials.
DOTFILES_URL=https://github.com/ryanolson/dynamo-dotfiles.git
ACTL_CONFIG_DIR="$CONFIG_DIR/actl"
ACTL_STATE="$STATE/actl"
WORKER_ROOT="$STATE/actl-worker"
TASK_RUNS="$STATE/tasks"
TASK_TYPES="fleet-apply pylon-install secrets-flush fleet-probe"
SSH_FLEET="$HOME/.ssh/fleet"
SELF="$HOME/.local/bin/fleet"
X509_RENEW_BEFORE=16h
TOKEN_TTL=5m
# Laptops share 1Password, so a new laptop reads the deployment values from this item.
CONFIG_ITEM="${FLEET_CONFIG_ITEM:-op://Personal/Fleet config}"
ENROLL_QUIET=0
SSH_RENEW_BEFORE=8h

CLEANUP=()
cleanup() { rm -rf "${CLEANUP[@]+"${CLEANUP[@]}"}"; }
trap cleanup EXIT
fail() { printf 'fleet: %s\n' "$*" >&2; exit 1; }
# Sets SCRATCH in the caller; a $(...) subshell would lose the cleanup entry.
scratch() { SCRATCH=$(mktemp -d "${1:-${TMPDIR:-/tmp}}/.fleet.XXXXXX"); CLEANUP+=("$SCRATCH"); }

usage() {
    cat <<'EOF'
Usage: fleet <command> [options]

Laptop (has 1Password):
  init --ca-url URL --fingerprint SHA256 [--enroll-item op://VAULT/ITEM] [--admin-item op://VAULT/ITEM]
       [--broker-url URL] [--principal NAME]
  list [-a] [--json]                    List active machines; -a adds expired and revoked ones.
                                        Needs a certificate from fleet login.
  token NAME [--san NAME]...            Print a 5-minute enrollment token.
  enroll-remote HOST NAME [--san NAME]... [--no-trust] [--principal NAME]
                                        Mint a token and enroll HOST over SSH.
  invite NAME [--san NAME]... [--dotfiles] [--ephemeral] [--no-trust] [--principal NAME]
                                        Print a curl command that enrolls a new machine.
  login [NAME]                          Enroll this laptop as an admin, without login trust, and
                                        schedule renewal. Without fleet init, read the settings
                                        from op://Personal/Fleet config. Run it again after the
                                        certificate expired.
  revoke SERIAL                         Revoke a client certificate. Renewal and new SSH
                                        certificates stop within 24 hours.

Any machine:
  enroll NAME [--ca-url URL --fingerprint SHA256] [--token TOKEN] [--no-trust] [--principal NAME]
                                        Without --token, read the token from stdin.
  ephemeral NAME [--ca-url URL --fingerprint SHA256] [--no-trust] [--principal NAME]
                                        Enroll in memory-backed storage and renew in the
                                        foreground. On exit, revoke and remove everything.
  renew [--loop]                        Renew certificates that are close to expiry.
  agent [run|install|remove]            Bridge a local ssh-agent socket to the broker (pylon, else socat).
                                        install runs it as a launchd or systemd user service.
  tunnel add NAME --mode client|server|gate --listen HOST:PORT --to HOST:PORT [--peer NAME] [--allow CIDR]
       [--via HOST:PORT --via-peer NAME]
                                        Carry a TCP service over fleet mTLS and run it as a service.
                                        client: loopback -> server; server: fleet certificates only;
                                        gate: fleet certificates in, ciphertext through. --via sends a
                                        client through a gate with TLS inside TLS. --allow limits sources.
  tunnel run NAME | remove NAME | list
  door install [--listen HOST:PORT] [--to HOST:PORT] [--per-source N] [--max N] [--handshake-timeout S]
                                        Linux, sudo: run a public mTLS listener for fleet machines in front of a
                                        local service (nginx stream, a root system service). Defaults: 0.0.0.0:8461
                                        -> 127.0.0.1:38886, 64 connections per address, 1024 in all, 10 s to finish
                                        the TLS handshake. Each certificate renewal reloads it.
  door render DIR [same options] | door remove
  secret get NAME                       Print a secret from the broker, if the policy allows this machine.
  secret env VAR=NAME... -- CMD...      Run CMD with secrets in its environment. Values are not printed.
                                        NAME can be an op://VAULT/ITEM/[SECTION/]FIELD reference: pylon
                                        answers it from its cache, else the broker looks it up.
  secret flush                          Empty the secrets cache of the local pylon.
  secret flush --all [--commit SHA] [--timeout S]
                                        Laptop: empty it on every enrolled machine (fleet task secrets-flush --all).
  claude [ARGS...]                      Run claude with CLAUDE_CODE_OAUTH_TOKEN from the secret claude-oauth-token.
  trust [--principal NAME] | untrust    Add or remove the CA line in ~/.ssh/authorized_keys.
  timer install | timer remove          Schedule renew every hour.
  status
  uninstall [--yes] [--keep-cert]       Revoke this machine's certificate, stop the fleet services
                                        (renew, agent, tunnels, door), remove the authorized_keys CA line,
                                        and delete the fleet keys and settings. Alias: remove.
  install-step                          Linux: install the pinned step CLI into ~/.local/bin (~/.local/<arch>/bin on no-sudo hosts).
  install-pylon                         Install the pinned pylon from the broker into the same folder, and restart
                                        the agent, also when the binary was current. Fails when the restart fails.

Fleet tasks through actl (the controller runs on the host that the broker's /v1/actl names):
  worker install [--timeout S] [--server URL|default]
                                        Install or update the pinned actl pair, the worker seed, the
                                        worker configuration from the broker, and the worker service.
                                        Prints ID=OS:PUBLIC_KEY. An update drains the running worker first.
                                        --server tls://HOST:PORT replaces the broker's NATS URLs on this
                                        machine, for example a loopback fleet tunnel, and is kept for later
                                        installs and refreshes; --server default returns to the broker's URLs.
  worker refresh                        Rewrite the connection data in worker.toml and ca.pem from the broker.
                                        The service runs it before each start; on any failure the files stay.
  worker run                            Refresh, then exec the worker (the launchd agent's program).
  worker status                         The service, the pinned and installed actl, the connection,
                                        running attempts, and drain markers.
  worker enroll HOST [--controller HOST] [--provisioner PATH] [--fleet-config PATH] [--timeout S]
                                        Laptop: install the worker on HOST over SSH, enroll it on the
                                        controller host (default bb, provisioner ~/repos/agentic-control-fleet),
                                        add it to the fleet-config roster, and wait until it connects.
  actl client-init                      Laptop: create the client.cli seed and print its public key.
  actl client-config                    Laptop: write client.toml and ca.pem from the broker, again on each run.
  task NAME (--host ID... | --all) [--commit SHA] [--timeout S]
                                        Laptop: send the task NAME (fleet-apply, pylon-install,
                                        secrets-flush, fleet-probe) to each machine and report the results.
  task --resume RUN [--timeout S]       Finish a run that stopped or timed out.
  executor apply|pylon-install|probe    Run by the worker for a task, from the task's checkout. apply installs
                                        fleet and fleet-ssh-keygen from it; pylon-install runs install-pylon with
                                        its pins and checks the running pylon. Both refuse a commit older than the
                                        one they applied last (~/.local/state/fleet/applied); the same commit is a no-op.
EOF
}

valid_name() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$ ]]; }
# An SSH destination. A leading - would make ssh read it as an option, so callers also pass --.
valid_ssh_host() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9@._-]*$ ]]; }
valid_url() { [[ "$1" =~ ^https://[A-Za-z0-9.:-]+(/[A-Za-z0-9._/-]*)?$ ]]; }
valid_fingerprint() { [[ "$1" =~ ^[0-9a-f]{64}$ ]]; }
valid_principal() { [[ "$1" =~ ^[a-z_][a-z0-9_.-]{0,31}$ ]]; }
valid_item() { [[ "$1" =~ ^op://[A-Za-z0-9\ ._-]+/[A-Za-z0-9\ ._-]+$ ]]; }
valid_actl_server() { [[ "$1" =~ ^tls://[A-Za-z0-9.-]+:[0-9]{1,5}$ ]]; }
valid_token() { [[ "$1" =~ ^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$ ]]; }

declare ca_url="" fingerprint="" name="" enroll_item="" admin_item="" broker_url="" principal="" actl_server=""

load_config() {
    [[ -f "$CONFIG" ]] || return 0
    local key value
    while IFS='=' read -r key value; do
        case "$key" in
            ca_url) valid_url "$value" && ca_url="$value" ;;
            fingerprint) valid_fingerprint "$value" && fingerprint="$value" ;;
            name) valid_name "$value" && name="$value" ;;
            enroll_item) valid_item "$value" && enroll_item="$value" ;;
            admin_item) valid_item "$value" && admin_item="$value" ;;
            broker_url) valid_url "$value" && broker_url="$value" ;;
            principal) valid_principal "$value" && principal="$value" ;;
            actl_server) valid_actl_server "$value" && actl_server="$value" ;;
        esac
    done < "$CONFIG"
    return 0
}

save_config() {
    mkdir -p "$CONFIG_DIR"
    local tmp
    tmp=$(mktemp "$CONFIG_DIR/.config.XXXXXX")
    {
        [[ -n "$ca_url" ]] && printf 'ca_url=%s\n' "$ca_url"
        [[ -n "$fingerprint" ]] && printf 'fingerprint=%s\n' "$fingerprint"
        [[ -n "$name" ]] && printf 'name=%s\n' "$name"
        [[ -n "$enroll_item" ]] && printf 'enroll_item=%s\n' "$enroll_item"
        [[ -n "$admin_item" ]] && printf 'admin_item=%s\n' "$admin_item"
        [[ -n "$broker_url" ]] && printf 'broker_url=%s\n' "$broker_url"
        [[ -n "$principal" ]] && printf 'principal=%s\n' "$principal"
        [[ -n "$actl_server" ]] && printf 'actl_server=%s\n' "$actl_server"
        true
    } > "$tmp"
    mv "$tmp" "$CONFIG"
}

step_arch() {
    case "$(uname -m)" in
        x86_64|amd64) echo amd64 ;;
        aarch64|arm64) echo arm64 ;;
        *) fail "unsupported architecture $(uname -m)" ;;
    esac
}

# Timers run with a minimal PATH, and no-sudo hosts keep step in an arch directory.
find_step() {
    local candidate
    for candidate in "$(command -v step 2>/dev/null || true)" "$HOME/.local/$(uname -m)/bin/step" "$HOME/.local/bin/step" \
                     /opt/homebrew/bin/step /usr/local/bin/step /usr/bin/step; do
        [[ -n "$candidate" && -x "$candidate" ]] && { STEP="$candidate"; return 0; }
    done
    return 1
}

# The shell profiles turn on the no-sudo layout when ~/.local/<arch> exists. Use it only if it is
# already there: on a no-sudo host ~/.local/bin can be shared by machines of other architectures.
local_bin() {
    if [[ -d "$HOME/.local/$(uname -m)" ]]; then echo "$HOME/.local/$(uname -m)/bin"; else echo "$HOME/.local/bin"; fi
}

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'; else shasum -a 256 "$1" | awk '{print $1}'; fi
}

install_pylon() {
    local target sum_var sum dir have
    target="$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m)"
    sum_var="PYLON_SHA256_${target//-/_}"
    sum="${!sum_var:-}"
    [[ -n "$sum" ]] || fail "no pylon build for $target"
    dir=$(local_bin)
    if [[ -x "$dir/pylon" && "$(sha256_of "$dir/pylon")" == "$sum" ]]; then
        printf 'pylon %s is installed in %s\n' "$PYLON_VERSION" "$dir"
    else
        need_enrollment
        need_broker
        mkdir -p "$dir"
        scratch "$dir"
        curl -fsS --connect-timeout 10 --max-time 300 --cert "$STATE/node.crt" --key "$STATE/node.key" \
            --cacert "$STATE/root_ca.crt" -o "$SCRATCH/pylon" "$broker_url/v1/artifacts/pylon/$PYLON_VERSION/$target" ||
            fail "the broker did not return pylon $PYLON_VERSION for $target"
        [[ "$(sha256_of "$SCRATCH/pylon")" == "$sum" ]] || fail "pylon download checksum mismatch; nothing installed"
        chmod 0755 "$SCRATCH/pylon"
        mv -f "$SCRATCH/pylon" "$dir/pylon"
        printf 'installed pylon %s in %s\n' "$PYLON_VERSION" "$dir"
    fi
    restart_agent
}

# A running agent keeps the old binary until it restarts. Restart it also when the file was current:
# an earlier install can have replaced the file and then failed to restart, and the pylon-install
# executor must prove the daemon that runs, not the file.
# The restart has a limit (FLEET_RESTART_WAIT, 120 seconds): systemctl waits for the start job, and an
# executor that waits forever holds its actl attempt.
restart_agent() {
    local wait
    wait=$(wait_seconds FLEET_RESTART_WAIT 120) || exit 1
    if [[ "$(uname -s)" == Darwin ]]; then
        bounded "$wait" launchctl kickstart -k "gui/$(id -u)/dev.fleet.agent" >/dev/null 2>&1 ||
            fail "could not restart the fleet agent (launchd agent dev.fleet.agent) within $wait seconds. Run: fleet agent install"
    else
        user_bus
        command -v systemctl >/dev/null 2>&1 && bounded "$wait" systemctl --user restart fleet-agent.service ||
            fail "could not restart the fleet agent (systemd user service fleet-agent) within $wait seconds. Run: fleet agent install"
    fi
    printf 'restarted the fleet agent\n'
}

install_step() {
    [[ "$(uname -s)" == Linux ]] || fail 'install step with Homebrew on macOS: brew install step'
    local arch sum_var sum dir work
    arch=$(step_arch)
    sum_var="STEP_SHA256_$arch"; sum="${!sum_var}"
    dir=$(local_bin)
    scratch; work="$SCRATCH"
    curl -fsSL -o "$work/step.tgz" "https://github.com/smallstep/cli/releases/download/v$STEP_VERSION/step_linux_$arch.tar.gz"
    printf '%s  %s\n' "$sum" "$work/step.tgz" | sha256sum -c - >/dev/null || fail 'step download checksum mismatch'
    tar -xzf "$work/step.tgz" -C "$work"
    mkdir -p "$dir"
    install -m 0755 "$work/step_linux_$arch/bin/step" "$dir/step"
    STEP="$dir/step"
    printf 'installed %s\n' "$("$STEP" version | head -1)"
}

need_step() {
    find_step && return 0
    [[ "$(uname -s)" == Linux ]] || fail 'step is missing: brew install step'
    install_step
}

need_enrollment() {
    load_config
    [[ -n "$ca_url" && -n "$name" && -f "$STATE/node.crt" && -f "$STATE/node.key" ]] ||
        fail 'not enrolled: run fleet enroll NAME'
}

ca_flags() { CA=(--ca-url "$ca_url" --root "$STATE/root_ca.crt"); }

issue_ssh() {
    ca_flags
    "$STEP" ssh certificate "$name" "$STATE/id_fleet.pub" --sign --force --provisioner fleet \
        --x5c-cert "$STATE/node.crt" --x5c-key "$STATE/node.key" "${CA[@]}" >/dev/null 2>&1 ||
        fail 'could not get an SSH certificate'
}

# Short SSH names (`ssh bb`) come from the broker, so tailnet host names stay out of this
# public script. A broker outage keeps the last list. Each line is checked again here, so a
# line cannot add other SSH options.
ssh_aliases() {
    local list="$SSH_FLEET/hosts" fresh alias host user
    need_broker
    if fresh=$(curl -fsS --connect-timeout 3 --max-time 5 --cert "$STATE/node.crt" --key "$STATE/node.key" \
            --cacert "$STATE/root_ca.crt" -H 'Accept: text/plain' "$broker_url/v1/ssh-hosts" 2>/dev/null); then
        printf '%s\n' "$fresh" > "$list.tmp" && mv "$list.tmp" "$list"
    fi
    [[ -f "$list" ]] || return 0
    # Fields: alias hostname user [jump or -] [host key alias]. A tailnet IP as the hostname, with
    # the name as the host key alias, works where a corporate DNS agent hides tailnet names.
    local key_alias
    while read -r alias host user jump key_alias _; do
        [[ "$alias" =~ ^[a-z0-9][a-z0-9-]{0,62}$ && "$host" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$ &&
           "$user" =~ ^[a-z_][a-z0-9_.-]{0,31}$ ]] || continue
        [[ "$jump" == - ]] && jump=""
        [[ -z "$jump" || "$jump" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || continue
        [[ -z "$key_alias" || "$key_alias" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$ ]] || continue
        printf 'Host %s\n    HostName %s\n    User %s\n    StrictHostKeyChecking accept-new\n' "$alias" "$host" "$user"
        # if, not &&: a false test as the loop's last command would fail renew under set -e.
        if [[ -n "$jump" ]]; then printf '    ProxyJump %s\n' "$jump"; fi
        if [[ -n "$key_alias" ]]; then printf '    HostKeyAlias %s\n' "$key_alias"; fi
    done < "$list"
}

write_ssh_config() {
    ca_flags
    local host_ca
    host_ca=$("$STEP" ssh config --host --roots "${CA[@]}") || fail 'could not read the SSH host CA'
    mkdir -p "$SSH_FLEET"
    chmod 700 "$HOME/.ssh" "$SSH_FLEET"
    printf '@cert-authority * %s\n' "$host_ca" > "$SSH_FLEET/known_hosts.tmp"
    mv "$SSH_FLEET/known_hosts.tmp" "$SSH_FLEET/known_hosts"
    # Naming any IdentityFile drops the OpenSSH defaults, so list the ones that exist.
    # A missing IdentityFile makes every ssh command print a warning.
    local identities=("$STATE/id_fleet") key
    for key in id_ed25519 id_ecdsa id_ecdsa_sk id_ed25519_sk id_rsa; do
        [[ -f "$HOME/.ssh/$key" ]] && identities+=("$HOME/.ssh/$key")
    done
    local suffix
    suffix=$(tailnet_suffix)
    {
        # OpenSSH uses the first IdentityAgent, so the GitHub block must precede Host *.
        if [[ -f "$SSH_FLEET/agent" && -f "$SSH_FLEET/agent-auth.pub" ]]; then
            printf '%s\n' 'Host github.com'
            printf '    IdentityAgent %s\n' "$(<"$SSH_FLEET/agent")"
            printf '    IdentityFile %s\n' "$SSH_FLEET/agent-auth.pub"
            printf '    IdentitiesOnly yes\n'
        fi
        ssh_aliases
        # No sshd presents a fleet host certificate yet, so a fleet host is trusted on first use. A
        # changed key still fails. WireGuard already authenticates tailnet peers, which keeps the
        # first connection safe; scoping to the tailnet keeps GitHub and other hosts strict.
        local patterns="*.ts.net" octet
        for ((octet = 64; octet < 128; octet++)); do patterns+=" 100.$octet.*"; done
        printf 'Host %s\n    StrictHostKeyChecking accept-new\n' "$patterns"
        printf '%s\n' 'Host *'
        # A bare tailnet name matches no pattern above until ssh expands it to its ts.net name.
        if [[ -n "$suffix" ]]; then
            printf '    CanonicalizeHostname yes\n    CanonicalDomains %s\n    CanonicalizeMaxDots 0\n' "$suffix"
        fi
        printf '    IdentityFile %s\n' "${identities[@]}"
        printf '    CertificateFile %s\n' "$STATE/id_fleet-cert.pub"
        printf '    UserKnownHostsFile %s %s\n' "$HOME/.ssh/known_hosts" "$SSH_FLEET/known_hosts"
    } > "$SSH_FLEET/config.tmp"
    mv "$SSH_FLEET/config.tmp" "$SSH_FLEET/config"
}

edit_authorized_keys() {
    local block="$1" keys="$HOME/.ssh/authorized_keys" tmp
    [[ ! -L "$HOME/.ssh" && ! -L "$keys" ]] || fail 'refusing a symlink at ~/.ssh or ~/.ssh/authorized_keys'
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    tmp=$(mktemp "$HOME/.ssh/.authorized_keys.XXXXXX")
    if [[ -f "$keys" ]]; then
        awk '/^# BEGIN fleet$/{skip=1; next} /^# END fleet$/{skip=0; next} !skip' "$keys" > "$tmp"
    fi
    if [[ -n "$block" ]]; then
        printf '%s\n' "$block" >> "$tmp"
    fi
    if [[ ! -s "$tmp" && ! -f "$keys" ]]; then
        rm -f "$tmp"
        return 0
    fi
    chmod 600 "$tmp"
    mv "$tmp" "$keys"
}

cmd_trust() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --principal) valid_principal "${2:-}" || fail 'invalid principal'; principal="$2"; shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    local wanted="$principal" user_ca
    need_enrollment
    principal="${wanted:-${principal:-ryan}}"
    local p="$principal"
    need_step
    save_config
    ca_flags
    user_ca=$("$STEP" ssh config --roots "${CA[@]}") || fail 'could not read the SSH user CA'
    edit_authorized_keys "$(printf '# BEGIN fleet\ncert-authority,principals="%s" %s\n# END fleet' "$p" "$user_ca")"
}

cmd_untrust() { edit_authorized_keys ""; }

cmd_init() {
    load_config
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ca-url) valid_url "${2:-}" || fail 'invalid --ca-url (https only)'; ca_url="$2"; shift 2 ;;
            --fingerprint) valid_fingerprint "${2:-}" || fail 'invalid --fingerprint (64 hex digits)'; fingerprint="$2"; shift 2 ;;
            --enroll-item) valid_item "${2:-}" || fail 'invalid --enroll-item (op://VAULT/ITEM)'; enroll_item="$2"; shift 2 ;;
            --admin-item) valid_item "${2:-}" || fail 'invalid --admin-item (op://VAULT/ITEM)'; admin_item="$2"; shift 2 ;;
            --broker-url) valid_url "${2:-}" || fail 'invalid --broker-url (https only)'; broker_url="$2"; shift 2 ;;
            --principal) valid_principal "${2:-}" || fail 'invalid principal'; principal="$2"; shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    [[ -n "$ca_url" && -n "$fingerprint" ]] || fail 'init needs --ca-url and --fingerprint'
    save_config
}

# Sets ENROLL to a scratch directory holding the CA root and the provisioner key and password.
# The enroll provisioner issues machine certificates; the admin provisioner issues laptop certificates.
enroll_secrets() {
    local item="${1:-$enroll_item}"
    PROVISIONER="${2:-enroll}"
    [[ -n "$ca_url" && -n "$fingerprint" && -n "$item" ]] ||
        fail 'run fleet init with --ca-url, --fingerprint, and --enroll-item first'
    command -v op >/dev/null || fail 'op is required on this machine'
    need_step
    scratch; ENROLL="$SCRATCH"
    "$STEP" ca root "$ENROLL/root.crt" --ca-url "$ca_url" --fingerprint "$fingerprint" >/dev/null 2>&1 ||
        fail 'could not fetch and check the CA root'
    op read "$item/jwk_encrypted" > "$ENROLL/key"
    op read "$item/password" > "$ENROLL/password"
}

provisioner_token() {
    "$STEP" ca token "$@" --provisioner "$PROVISIONER" --key "$ENROLL/key" --password-file "$ENROLL/password" \
        --not-after "$TOKEN_TTL" --ca-url "$ca_url" --root "$ENROLL/root.crt" 2>/dev/null || fail 'could not mint a token'
}

mint_token() {
    local subject="$1"; shift
    local san_flags=(--san "$subject")
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --san) valid_name "${2:-}" || fail 'invalid --san'; san_flags+=(--san "$2"); shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    enroll_secrets
    provisioner_token "$subject" "${san_flags[@]}"
}

cmd_revoke() {
    [[ $# -eq 1 && "$1" =~ ^[0-9A-Za-z]{1,30}$ ]] || fail 'usage: fleet revoke SERIAL (base62, from fleet list or fleet status)'
    local serial
    serial=$(base62_to_decimal "$1")
    load_config
    enroll_secrets
    local token
    token=$(provisioner_token "$serial" --revoke)
    "$STEP" ca revoke "$serial" --token "$token" --ca-url "$ca_url" --root "$ENROLL/root.crt" >/dev/null 2>&1 ||
        fail 'the CA did not revoke the certificate'
    printf 'revoked %s\n' "$1"
}

cmd_token() {
    [[ $# -ge 1 ]] || fail 'usage: fleet token NAME [--san NAME]...'
    valid_name "$1" || fail 'invalid NAME'
    load_config
    mint_token "$@"
}

cmd_enroll() {
    [[ $# -ge 1 ]] || fail 'usage: fleet enroll NAME [options]'
    load_config
    valid_name "$1" || fail 'invalid NAME'
    name="$1"; shift
    local token="" trust=1
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ca-url) valid_url "${2:-}" || fail 'invalid --ca-url (https only)'; ca_url="$2"; shift 2 ;;
            --fingerprint) valid_fingerprint "${2:-}" || fail 'invalid --fingerprint (64 hex digits)'; fingerprint="$2"; shift 2 ;;
            --token) token="${2:-}"; shift 2 ;;
            --no-trust) trust=0; shift ;;
            --principal) valid_principal "${2:-}" || fail 'invalid principal'; principal="$2"; shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    [[ -n "$ca_url" && -n "$fingerprint" ]] || fail 'enroll needs --ca-url and --fingerprint'
    if [[ -z "$token" ]]; then
        [[ -t 0 ]] && printf 'Paste the enrollment token: ' >&2
        IFS= read -r token || true
    fi
    valid_token "$token" || fail 'the token is not a valid JWT'
    need_step
    mkdir -p "$STATE"
    chmod 700 "$STATE"
    local stage
    scratch "$STATE"; stage="$SCRATCH"
    "$STEP" ca root "$stage/root_ca.crt" --ca-url "$ca_url" --fingerprint "$fingerprint" >/dev/null 2>&1 ||
        fail 'could not fetch the CA root, or its fingerprint does not match'
    "$STEP" ca certificate "$name" "$stage/node.crt" "$stage/node.key" --token "$token" \
        --ca-url "$ca_url" --root "$stage/root_ca.crt" >/dev/null 2>&1 ||
        fail 'the CA rejected the token'
    chmod 600 "$stage/node.key"
    mv -f "$stage/root_ca.crt" "$stage/node.crt" "$stage/node.key" "$STATE/"
    if [[ ! -f "$STATE/id_fleet" ]]; then
        ssh-keygen -q -t ed25519 -N '' -C "fleet:$name" -f "$STATE/id_fleet"
    fi
    save_config
    issue_ssh
    write_ssh_config
    if [[ "$trust" == 1 ]]; then
        cmd_trust
    fi
    [[ "$ENROLL_QUIET" == 1 ]] || printf 'enrolled %s. Run: fleet timer install\n' "$name"
}

import_config() {
    command -v op >/dev/null || fail 'op is required: install 1Password CLI, or run fleet init'
    local field value
    for field in ca_url fingerprint broker_url enroll_item admin_item; do
        value=$(op read "$CONFIG_ITEM/$field") || fail "could not read $CONFIG_ITEM/$field"
        case "$field" in
            ca_url|broker_url) valid_url "$value" || fail "invalid $field in $CONFIG_ITEM" ;;
            fingerprint) valid_fingerprint "$value" || fail "invalid $field in $CONFIG_ITEM" ;;
            *) valid_item "$value" || fail "invalid $field in $CONFIG_ITEM" ;;
        esac
        printf -v "$field" '%s' "$value"
    done
    save_config
}

cmd_login() {
    load_config
    [[ -n "$ca_url" ]] || import_config
    local node="${1:-${name:-$(hostname -s)}}"
    valid_name "$node" || fail 'usage: fleet login [NAME]'
    [[ -n "$admin_item" ]] || fail 'run fleet init --admin-item op://VAULT/ITEM first'
    enroll_secrets "$admin_item" admin
    local token
    token=$(provisioner_token "$node" --san "$node")
    ENROLL_QUIET=1
    cmd_enroll "$node" --token "$token" --no-trust
    cmd_timer install
    printf 'logged in as %s (admin). Renewal runs every hour.\n' "$node"
}

cmd_invite() {
    [[ $# -ge 1 ]] || fail 'usage: fleet invite NAME [--san NAME]... [--dotfiles] [--ephemeral] [--no-trust] [--principal NAME] [--ref COMMIT]'
    valid_name "$1" || fail 'invalid NAME'
    local node="$1"; shift
    load_config
    local token_args=() join_args=() ref=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --san) token_args+=(--san "${2:-}"); shift 2 ;;
            --dotfiles|--ephemeral|--no-trust) join_args+=("$1"); shift ;;
            --principal) valid_principal "${2:-}" || fail 'invalid principal'; join_args+=(--principal "$2"); shift 2 ;;
            --ref) [[ "${2:-}" =~ ^[0-9a-f]{40}$ ]] || fail 'invalid --ref (full commit SHA)'; ref="$2"; shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    local src origin repo
    src="${FLEET_SOURCE:-$(chezmoi source-path 2>/dev/null || true)}"
    [[ -n "$src" && -d "$src/.git" ]] || fail 'cannot find the dotfiles source; set FLEET_SOURCE'
    origin=$(git -C "$src" remote get-url origin)
    case "$origin" in
        git@github.com:*) repo="${origin#git@github.com:}" ;;
        https://github.com/*) repo="${origin#https://github.com/}" ;;
        *) fail "origin is not a GitHub repository: $origin" ;;
    esac
    repo="${repo%.git}"
    [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fail "cannot parse the GitHub repository from $origin"
    # The join script and fleet come from this commit, so it must be on GitHub.
    if [[ -z "$ref" ]]; then
        ref=$(git -C "$src" rev-parse HEAD)
        git -C "$src" branch -r --contains "$ref" 2>/dev/null | grep -q 'origin/' ||
            fail "commit $ref is not on origin; push it first or pass --ref"
    fi
    TOKEN_TTL=15m
    local out
    scratch; out="$SCRATCH"
    mint_token "$node" "${token_args[@]+"${token_args[@]}"}" > "$out/token"
    printf 'Run this on the new machine within 15 minutes. The token works once.\n\n' >&2
    printf "bash -c 'exec bash <(curl -fsSL \"\$0\") \"\$@\"' %s --repo %s --ref %s --name %s --ca-url %s --fingerprint %s --token %s%s\n" \
        "https://raw.githubusercontent.com/$repo/$ref/join.sh" "$repo" "$ref" "$node" "$ca_url" "$fingerprint" \
        "$(<"$out/token")" "${join_args[*]+ ${join_args[*]}}"
}

ephemeral_exit() {
    local rc=$?
    trap - EXIT INT TERM
    local job
    for job in $(jobs -p); do kill "$job" 2>/dev/null || true; wait "$job" 2>/dev/null || true; done
    if [[ -n "${STEP:-}" && -f "$STATE/node.crt" ]]; then
        "$STEP" ca revoke --cert "$STATE/node.crt" --key "$STATE/node.key" --ca-url "$ca_url" \
            --root "$STATE/root_ca.crt" >/dev/null 2>&1 ||
            printf 'fleet: could not revoke the certificate; it expires within 24 hours\n' >&2
    fi
    if [[ -n "${EPHEMERAL_ROOT:-}" ]]; then
        edit_authorized_keys ""
        rm -rf "$SSH_FLEET" "$EPHEMERAL_ROOT"
    fi
    rm -rf "${CLEANUP[@]+"${CLEANUP[@]}"}"
    exit "$rc"
}

cmd_ephemeral() {
    [[ $# -ge 1 ]] || fail 'usage: fleet ephemeral NAME --ca-url URL --fingerprint SHA256 [--no-trust] [--principal NAME]'
    [[ ! -f "$STATE/node.crt" ]] || fail 'this machine has a persistent enrollment; use it instead'
    [[ ! -e "$SSH_FLEET" ]] || fail '~/.ssh/fleet exists; another fleet identity owns the SSH settings'
    local base
    for base in "${XDG_RUNTIME_DIR:-}" /dev/shm "${TMPDIR:-/tmp}"; do
        [[ -n "$base" && -d "$base" && -w "$base" ]] && break
    done
    EPHEMERAL_ROOT=$(mktemp -d "$base/fleet-ephemeral.XXXXXX")
    STATE="$EPHEMERAL_ROOT/state/fleet"
    CONFIG_DIR="$EPHEMERAL_ROOT/config/fleet"
    CONFIG="$CONFIG_DIR/config"
    trap ephemeral_exit EXIT
    trap 'exit 0' INT TERM
    ENROLL_QUIET=1
    cmd_enroll "$@"
    printf 'ephemeral identity %s is active. Keep this running; Ctrl-C revokes it and removes its files.\n' "$name"
    while true; do
        # A signal can land between the fork and $!, so the sleep must not hold this terminal's pipes.
        sleep 3600 </dev/null >/dev/null 2>&1 &
        wait $! || true
        ( cmd_renew ) || printf 'fleet: renew failed; retrying in 1 hour\n' >&2
    done
}

cmd_enroll_remote() {
    [[ $# -ge 2 ]] || fail 'usage: fleet enroll-remote HOST NAME [--san NAME]... [--no-trust] [--principal NAME]'
    local host="$1" node="$2"; shift 2
    valid_ssh_host "$host" || fail 'invalid HOST'
    valid_name "$node" || fail 'invalid NAME'
    load_config
    local token_args=() remote_args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --san) token_args+=(--san "${2:-}"); shift 2 ;;
            --no-trust) remote_args+=(--no-trust); shift ;;
            --principal) valid_principal "${2:-}" || fail 'invalid principal'; remote_args+=(--principal "$2"); shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    local out
    scratch; out="$SCRATCH"
    mint_token "$node" "${token_args[@]+"${token_args[@]}"}" > "$out/token"
    ssh -- "$host" < "$out/token" "~/.local/bin/fleet enroll $node --ca-url $ca_url --fingerprint $fingerprint ${remote_args[*]-}"
}

cmd_renew() {
    local loop=0
    [[ "${1:-}" == --loop ]] && loop=1
    if [[ "$loop" == 1 ]]; then
        while true; do
            "$SELF" renew || printf 'fleet: renew failed; retrying in 1h\n' >&2
            sleep 3600
        done
    fi
    need_enrollment
    door_ca_check
    need_step
    ca_flags
    # pylon renews both certificates with the same rules, without one step process per call.
    # An older pylon has no renew command, so ask first.
    if find_pylon && "$PYLON" renew --help >/dev/null 2>&1; then
        "$PYLON" renew --ca-url "$ca_url" --state "$STATE" --name "$name" >/dev/null ||
            fail 'renewal failed; the certificate is expired or revoked. Enroll again: fleet login on a laptop, or a new token.'
        write_ssh_config
        return
    fi
    local rc=0 ssh_due=0
    "$STEP" certificate needs-renewal "$STATE/node.crt" --expires-in "$X509_RENEW_BEFORE" >/dev/null 2>&1 || rc=$?
    case "$rc" in
        0) "$STEP" ca renew "$STATE/node.crt" "$STATE/node.key" --force "${CA[@]}" >/dev/null 2>&1 ||
               fail 'renewal failed; the certificate is expired or revoked. Enroll again: fleet login on a laptop, or a new token.'
           ssh_due=1 ;;
        1) ;;
        *) fail 'could not read the client certificate' ;;
    esac
    if [[ "$ssh_due" == 0 && -f "$STATE/id_fleet-cert.pub" ]]; then
        rc=0
        "$STEP" ssh needs-renewal "$STATE/id_fleet-cert.pub" --expires-in "$SSH_RENEW_BEFORE" >/dev/null 2>&1 || rc=$?
        [[ "$rc" == 1 ]] || ssh_due=1
    else
        ssh_due=1
    fi
    if [[ "$ssh_due" == 1 ]]; then
        issue_ssh
    fi
    write_ssh_config
}

timer_systemd() {
    local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
    mkdir -p "$dir"
    printf '%s\n' '[Unit]' 'Description=Renew fleet certificates' '' '[Service]' 'Type=oneshot' \
        "ExecStart=$SELF renew" > "$dir/fleet-renew.service"
    printf '%s\n' '[Unit]' 'Description=Renew fleet certificates every hour' '' '[Timer]' 'OnBootSec=2min' \
        'OnUnitActiveSec=1h' 'Persistent=true' '' '[Install]' 'WantedBy=timers.target' > "$dir/fleet-renew.timer"
    systemctl --user daemon-reload
    systemctl --user enable --now fleet-renew.timer
    if [[ "$(loginctl show-user "$USER" -p Linger --value 2>/dev/null || true)" != yes ]]; then
        loginctl enable-linger "$USER" 2>/dev/null ||
            printf 'fleet: linger is off, so the timer stops at logout. Ask an admin for: loginctl enable-linger %s\n' "$USER" >&2
    fi
}

timer_launchd() {
    local plist="$HOME/Library/LaunchAgents/dev.fleet.renew.plist"
    mkdir -p "$(dirname "$plist")"
    cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>dev.fleet.renew</string>
    <key>ProgramArguments</key><array><string>$SELF</string><string>renew</string></array>
    <key>StartInterval</key><integer>3600</integer>
    <key>RunAtLoad</key><true/>
</dict>
</plist>
EOF
    launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
}

timer_cron() {
    command -v crontab >/dev/null || fail 'no systemd user session, launchd, or crontab. Run: fleet renew --loop'
    { crontab -l 2>/dev/null | grep -v '# fleet-renew$' || true
      printf '17 * * * * %s renew >/dev/null 2>&1 # fleet-renew\n' "$SELF"; } | crontab -
}

cmd_timer() {
    case "${1:-}" in
        install)
            if [[ "$(uname -s)" == Darwin ]]; then timer_launchd
            elif systemctl --user show-environment >/dev/null 2>&1; then timer_systemd
            else timer_cron
            fi ;;
        remove)
            if [[ "$(uname -s)" == Darwin ]]; then
                launchctl bootout "gui/$(id -u)" "$HOME/Library/LaunchAgents/dev.fleet.renew.plist" 2>/dev/null || true
                rm -f "$HOME/Library/LaunchAgents/dev.fleet.renew.plist"
            fi
            if systemctl --user show-environment >/dev/null 2>&1; then
                systemctl --user disable --now fleet-renew.timer 2>/dev/null || true
                rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/fleet-renew."{service,timer}
            fi
            if command -v crontab >/dev/null && crontab -l 2>/dev/null | grep -q '# fleet-renew$'; then
                crontab -l | grep -v '# fleet-renew$' | crontab -
            fi ;;
        *) fail 'usage: fleet timer install|remove' ;;
    esac
}

B62=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz

# Serials are 128-bit, too large for shell arithmetic.
serial_of() {
    local hex
    hex=$(openssl x509 -noout -serial -in "$1" 2>/dev/null | sed 's/^serial=//') || true
    if [[ -z "$hex" ]]; then echo unknown
    elif command -v python3 >/dev/null; then
        python3 -c 'import sys; n=int(sys.argv[1], 16); d=sys.argv[2]; o=""
while True:
    n, r = divmod(n, 62); o = d[r] + o
    if not n: break
print(o)' "$hex" "$B62"
    else echo "0x$hex (install python3 for the base62 form)"
    fi
}

base62_to_decimal() {
    command -v python3 >/dev/null || fail 'python3 is required to read a base62 serial'
    python3 -c 'import sys; d=sys.argv[2]; n=0
for ch in sys.argv[1]: n = n * 62 + d.index(ch)
print(n)' "$1" "$B62"
}

cmd_list() {
    local accept='text/plain' query=''
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) accept='application/json'; shift ;;
            -a|--all) query='?all=1'; shift ;;
            *) fail "unknown option $1" ;;
        esac
    done
    need_enrollment
    need_broker
    curl -fsS --cert "$STATE/node.crt" --key "$STATE/node.key" --cacert "$STATE/root_ca.crt" \
        -H "Accept: $accept" "$broker_url/v1/machines$query" ||
        fail 'the broker refused the request; fleet list needs a certificate from fleet login'
}

valid_secret() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]]; }

# The broker runs on the CA host, as the agent port does. A saved broker_url overrides this.
need_broker() {
    if [[ -z "$broker_url" ]]; then
        local host="${ca_url#https://}"; host="${host%%/*}"; host="${host%%:*}"
        [[ -n "$host" ]] || fail 'run fleet init --broker-url https://HOST:PORT first'
        broker_url="https://$host:8443"
    fi
}

valid_ref() {
    local part='[A-Za-z0-9 ._-]+'
    [[ "$1" =~ ^op://$part/$part/($part/)?$part$ ]]
}

# The characters that valid_ref allows need only these escapes in a query string.
encode_ref() {
    local s="${1// /%20}"
    s="${s//:/%3A}"; s="${s//\//%2F}"
    printf '%s' "$s"
}

secrets_sock() {
    if [[ -n "${FLEET_SECRETS_SOCK:-}" ]]; then
        printf '%s' "$FLEET_SECRETS_SOCK"
    else
        local agent; agent=$(agent_sock)
        if [[ "$agent" == */fleet-agent.sock ]]; then
            printf '%s' "${agent%/*}/fleet-secrets.sock"
        else
            printf '%s' "$SSH_FLEET/secrets.sock"
        fi
    fi
}

# pylon keeps values in memory for a short time. If it is not running or fails, ask the broker.
ref_value() {
    valid_ref "$1" || fail "invalid secret reference: $1"
    local sock query
    sock=$(secrets_sock)
    query="ref=$(encode_ref "$1")"
    if [[ -S "$sock" ]] && curl -fsS --unix-socket "$sock" "http://pylon/v1/secrets?$query" 2>/dev/null; then
        return 0
    fi
    need_enrollment
    need_broker
    curl -fsS --cert "$STATE/node.crt" --key "$STATE/node.key" --cacert "$STATE/root_ca.crt" \
        -H 'Accept: application/octet-stream' "$broker_url/v1/secrets?$query" ||
        fail "the broker did not return the secret $1"
}

secret_value() {
    if [[ "$1" == op://* ]]; then
        ref_value "$1"
        return
    fi
    valid_secret "$1" || fail "invalid secret name: $1"
    need_enrollment
    need_broker
    curl -fsS --cert "$STATE/node.crt" --key "$STATE/node.key" --cacert "$STATE/root_ca.crt" \
        -H 'Accept: application/octet-stream' "$broker_url/v1/secrets/$1" ||
        fail "the broker did not return the secret $1"
}

cmd_secret() {
    case "${1:-}" in
        get)
            [[ $# -eq 2 ]] || fail 'usage: fleet secret get NAME'
            secret_value "$2" ;;
        env)
            shift
            local pair var value
            local -a pairs=()
            while [[ $# -gt 0 && "$1" != -- ]]; do pairs+=("$1"); shift; done
            [[ "${1:-}" == -- && $# -ge 2 && ${#pairs[@]} -gt 0 ]] || fail 'usage: fleet secret env VAR=NAME... -- CMD...'
            shift
            for pair in "${pairs[@]}"; do
                var="${pair%%=*}"
                [[ "$var" =~ ^[A-Z_][A-Z0-9_]*$ && "$pair" == *=* ]] || fail "invalid VAR=NAME: $pair"
                value=$(secret_value "${pair#*=}") || exit 1
                export "$var=$value"
            done
            exec "$@" ;;
        flush)
            # --all flushes every enrolled machine through actl; the rest of the arguments go to fleet task.
            if [[ "${2:-}" == --all ]]; then
                shift 2
                cmd_task secrets-flush --all "$@"
                return
            fi
            [[ $# -eq 1 ]] || fail 'usage: fleet secret flush [--all [--commit SHA] [--timeout S]]'
            local sock; sock=$(secrets_sock)
            [[ -S "$sock" ]] || fail "pylon does not serve secrets on $sock"
            curl -fsS --unix-socket "$sock" -X POST http://pylon/v1/flush >/dev/null || fail 'pylon did not flush its cache'
            echo 'flushed the pylon secrets cache' ;;
        *) fail 'usage: fleet secret get NAME | fleet secret env VAR=NAME... -- CMD... | fleet secret flush [--all]' ;;
    esac
}

# The user's runtime folder when XDG_RUNTIME_DIR is unset. FLEET_RUNTIME_BASE lets tests use their
# own folder: a test that falls back to /run/user/UID would reach the host's live sockets.
user_runtime_dir() {
    printf '%s' "${XDG_RUNTIME_DIR:-${FLEET_RUNTIME_BASE:-/run/user}/$(id -u)}"
}

# Unix socket paths are limited to 104 bytes on macOS and 108 on Linux.
agent_sock() {
    if [[ -n "${FLEET_AGENT_SOCK:-}" ]]; then
        printf '%s' "$FLEET_AGENT_SOCK"
    elif [[ "$(uname -s)" == Linux && -d "$(user_runtime_dir)" ]]; then
        # The systemd user service always has XDG_RUNTIME_DIR. Some SSH sessions (Tailscale SSH)
        # do not, so fall back to the same directory, or install looks for the wrong socket.
        printf '%s' "$(user_runtime_dir)/fleet-agent.sock"
    else
        printf '%s' "$SSH_FLEET/agent.sock"
    fi
}

find_pylon() {
    local candidate candidates=("${FLEET_PYLON:-}")
    [[ -n "${FLEET_PYLON:-}" ]] || candidates=("$(command -v pylon 2>/dev/null || true)" "$(local_bin)/pylon")
    for candidate in "${candidates[@]}"; do
        [[ -n "$candidate" && -x "$candidate" ]] && { PYLON="$candidate"; return 0; }
    done
    return 1
}

find_tailscale() {
    local candidate candidates=("${FLEET_TAILSCALE:-}")
    [[ -n "${FLEET_TAILSCALE:-}" ]] || candidates=("$(command -v tailscale 2>/dev/null || true)"
        /Applications/Tailscale.app/Contents/MacOS/Tailscale)
    for candidate in "${candidates[@]}"; do
        [[ -n "$candidate" && -x "$candidate" ]] && { TAILSCALE="$candidate"; return 0; }
    done
    return 1
}

# Print the tailnet's MagicDNS suffix, or nothing when tailscale is missing, stopped, or odd.
tailnet_suffix() {
    local suffix=""
    find_tailscale || return 0
    suffix=$("$TAILSCALE" status --json 2>/dev/null |
        sed -n 's/^ *"MagicDNSSuffix": *"\([^"]*\)".*/\1/p' | head -n 1) || true
    if [[ "$suffix" =~ ^[a-z0-9-]+(\.[a-z0-9-]+)*\.ts\.net$ ]]; then printf '%s\n' "$suffix"; fi
}

find_socat() {
    local candidate candidates=("${FLEET_SOCAT:-}")
    [[ -n "${FLEET_SOCAT:-}" ]] || candidates=("$(command -v socat 2>/dev/null || true)" /opt/homebrew/bin/socat
        /usr/local/bin/socat "$HOME/.pixi/bin/socat" "$HOME/.local/$(uname -m)/pixi/bin/socat" /usr/bin/socat)
    for candidate in "${candidates[@]}"; do
        [[ -n "$candidate" && -x "$candidate" ]] && { SOCAT="$candidate"; return 0; }
    done
    return 1
}

# pylon keeps a warm connection and caches the key list (about 0.15 s per signature). socat opens
# a new mTLS connection for each agent client (about 0.5 s). Both read the renewed certificate.
find_bridge() {
    find_pylon || find_socat || fail 'pylon or socat is required. Run chezmoi apply, or install one of them.'
}

agent_run() {
    need_enrollment
    local sock host addr
    sock=$(agent_sock)
    (( ${#sock} <= 100 )) || fail "the agent socket path is too long (${#sock} bytes): $sock. Set FLEET_AGENT_SOCK."
    find_bridge
    host="${ca_url#https://}"; host="${host%%/*}"; host="${host%%:*}"
    addr="${FLEET_AGENT_ADDR:-$host:8444}"
    mkdir -p "$(dirname "$sock")"
    if [[ -n "${PYLON:-}" ]]; then
        local -a secrets=()
        # An older pylon has no secrets socket. Turn it on only when this pylon has the flag.
        if "$PYLON" agent --help 2>/dev/null | grep -q -- --secrets-socket; then
            need_broker
            secrets=(--secrets-socket "$(secrets_sock)" --broker-url "$broker_url")
        fi
        exec "$PYLON" agent --socket "$sock" --broker "$addr" \
            --cert "$STATE/node.crt" --key "$STATE/node.key" --ca "$STATE/root_ca.crt" ${secrets[@]+"${secrets[@]}"}
    fi
    exec "$SOCAT" "UNIX-LISTEN:$sock,fork,unlink-early,mode=600" \
        "OPENSSL:$addr,cert=$STATE/node.crt,key=$STATE/node.key,cafile=$STATE/root_ca.crt,verify=1"
}

agent_install() {
    need_enrollment
    find_bridge
    local sock
    sock=$(agent_sock)
    if [[ "$(uname -s)" == Darwin ]]; then
        local plist="$HOME/Library/LaunchAgents/dev.fleet.agent.plist"
        mkdir -p "$(dirname "$plist")" "$HOME/Library/Logs"
        cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>dev.fleet.agent</string>
    <key>ProgramArguments</key><array><string>$SELF</string><string>agent</string></array>
    <key>KeepAlive</key><true/>
    <key>RunAtLoad</key><true/>
    <key>StandardErrorPath</key><string>$HOME/Library/Logs/fleet-agent.log</string>
</dict>
</plist>
EOF
        launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true
        launchctl bootstrap "gui/$(id -u)" "$plist"
    elif systemctl --user show-environment >/dev/null 2>&1; then
        local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
        mkdir -p "$dir"
        printf '%s\n' '[Unit]' 'Description=Fleet SSH agent bridge' '' '[Service]' "ExecStart=$SELF agent" \
            'Restart=always' 'RestartSec=5' '' '[Install]' 'WantedBy=default.target' > "$dir/fleet-agent.service"
        systemctl --user daemon-reload
        systemctl --user enable --now fleet-agent.service
    else
        fail 'no launchd or systemd user session. Run fleet agent in the foreground, for example in a Zellij pane.'
    fi
    wire_agent "$sock"
    printf 'agent running. git signs and GitHub logs in through it. For other tools: export SSH_AUTH_SOCK=%s\n' "$sock"
}

# Point git signing and GitHub SSH at the agent. The signing key comes from the agent itself.
wire_agent() {
    local sock="$1" pub="" auth="" i keys
    for ((i = 0; i < ${FLEET_AGENT_WAIT:-15}; i++)); do
        keys=$(SSH_AUTH_SOCK="$sock" ssh-add -L 2>/dev/null) || true
        pub=$(awk '/ fleet agent-signing$/ {print $1, $2; exit}' <<<"$keys")
        auth=$(awk '/ fleet agent-auth$/ {print; exit}' <<<"$keys")
        [[ -n "$pub" ]] && break
        sleep 1
    done
    [[ -n "$pub" ]] || fail "the agent at $sock does not list the fleet agent-signing key"
    mkdir -p "$SSH_FLEET"
    if [[ -n "$auth" ]]; then
        printf '%s\n' "$auth" > "$SSH_FLEET/agent-auth.pub"
    else
        rm -f "$SSH_FLEET/agent-auth.pub"
    fi
    {
        [[ -f "$HOME/.ssh/allowed_signers" ]] && cat "$HOME/.ssh/allowed_signers"
        printf '* %s\n' "$pub"
    } > "$SSH_FLEET/allowed_signers.tmp"
    mv "$SSH_FLEET/allowed_signers.tmp" "$SSH_FLEET/allowed_signers"
    # A key file rather than key::<key>: git before 2.35 (Ubuntu 22.04 ships 2.34) treats the
    # key:: form as a path and cannot sign.
    printf '%s fleet agent-signing\n' "$pub" > "$SSH_FLEET/agent-signing.pub"
    cat > "$SSH_FLEET/gitconfig.tmp" <<EOF
[user]
    signingkey = $SSH_FLEET/agent-signing.pub
[gpg]
    format = ssh
[gpg "ssh"]
    program = $HOME/.local/bin/fleet-ssh-keygen
    allowedSignersFile = $SSH_FLEET/allowed_signers
[commit]
    gpgsign = true
EOF
    mv "$SSH_FLEET/gitconfig.tmp" "$SSH_FLEET/gitconfig"
    printf '%s\n' "$sock" > "$SSH_FLEET/agent"
    need_step
    write_ssh_config
}

agent_remove() {
    if [[ "$(uname -s)" == Darwin ]]; then
        launchctl bootout "gui/$(id -u)" "$HOME/Library/LaunchAgents/dev.fleet.agent.plist" 2>/dev/null || true
        rm -f "$HOME/Library/LaunchAgents/dev.fleet.agent.plist"
    elif systemctl --user show-environment >/dev/null 2>&1; then
        systemctl --user disable --now fleet-agent.service 2>/dev/null || true
        rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/fleet-agent.service"
    fi
    rm -f "$(agent_sock)" "$SSH_FLEET/agent" "$SSH_FLEET/gitconfig" "$SSH_FLEET/allowed_signers" \
        "$SSH_FLEET/agent-auth.pub" "$SSH_FLEET/agent-signing.pub"
    load_config
    if [[ -n "$ca_url" && -f "$STATE/node.crt" ]] && find_step; then
        write_ssh_config
    fi
}

# Tunnels carry a TCP service between fleet machines, gated by fleet certificates:
#   client  loopback listener -> mTLS to a server, which must present the certificate of --peer
#   server  mTLS listener that accepts only fleet certificates -> a local TCP service
#   gate    mTLS listener (fleet certificates only, optional source allowlist) -> TCP to a server,
#           for a machine on two networks. A client reaches the server through it with --via: the
#           client's TLS to the server runs inside its TLS to the gate, so the gate admits only
#           fleet machines and never sees the traffic, and the server sees the client's own name.
# socat reads the certificate when each client connection opens. A server reads it at start,
# so its service restarts every 6 hours, well inside the 24-hour lifetime.
TUNNELS="$CONFIG_DIR/tunnels"
valid_addr() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*:[0-9]{1,5}$ ]]; }
valid_cidr() { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$ ]]; }

tunnel_unit_install() {
    local tname="$1" mode="$2"
    [[ -n "${FLEET_TUNNEL_NO_SERVICE:-}" ]] && return 0
    if [[ "$(uname -s)" == Darwin ]]; then
        local plist="$HOME/Library/LaunchAgents/dev.fleet.tunnel.$tname.plist"
        mkdir -p "$(dirname "$plist")" "$HOME/Library/Logs"
        cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>dev.fleet.tunnel.$tname</string>
    <key>ProgramArguments</key><array><string>$SELF</string><string>tunnel</string><string>run</string><string>$tname</string></array>
    <key>KeepAlive</key><true/>
    <key>RunAtLoad</key><true/>
    <key>StandardErrorPath</key><string>$HOME/Library/Logs/fleet-tunnel-$tname.log</string>
</dict>
</plist>
EOF
        launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true
        launchctl bootstrap "gui/$(id -u)" "$plist"
    elif systemctl --user show-environment >/dev/null 2>&1; then
        local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
        mkdir -p "$dir"
        {
            printf '%s\n' '[Unit]' "Description=Fleet tunnel $tname ($mode)" '' '[Service]' \
                "ExecStart=$SELF tunnel run $tname" 'Restart=always' 'RestartSec=5'
            [[ "$mode" != client ]] && printf '%s\n' 'RuntimeMaxSec=6h'
            printf '%s\n' '' '[Install]' 'WantedBy=default.target'
        } > "$dir/fleet-tunnel-$tname.service"
        systemctl --user daemon-reload
        systemctl --user enable --now "fleet-tunnel-$tname.service" >/dev/null
        systemctl --user restart "fleet-tunnel-$tname.service"
    else
        fail 'no launchd or systemd user session. Run fleet tunnel run NAME in the foreground.'
    fi
}

cmd_tunnel() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        add)
            local tname="${1:-}" mode="" listen="" to="" peer="" allow="" via="" via_peer=""
            shift || true
            [[ "$tname" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || fail 'usage: fleet tunnel add NAME --mode client|server|gate --listen HOST:PORT --to HOST:PORT [--peer NAME] [--via HOST:PORT --via-peer NAME] [--allow CIDR]'
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --mode) mode="${2:-}"; shift 2 ;;
                    --listen) listen="${2:-}"; shift 2 ;;
                    --to) to="${2:-}"; shift 2 ;;
                    --peer) peer="${2:-}"; shift 2 ;;
                    --allow) allow="${2:-}"; shift 2 ;;
                    --via) via="${2:-}"; shift 2 ;;
                    --via-peer) via_peer="${2:-}"; shift 2 ;;
                    *) fail "unknown option $1" ;;
                esac
            done
            [[ "$mode" =~ ^(client|server|gate)$ ]] || fail '--mode must be client, server, or gate'
            valid_addr "$listen" || fail 'invalid --listen (HOST:PORT)'
            valid_addr "$to" || fail 'invalid --to (HOST:PORT)'
            if [[ "$mode" == client ]]; then
                valid_name "$peer" || fail 'a client tunnel needs --peer: the fleet name of the server'
            fi
            if [[ -n "$via" || -n "$via_peer" ]]; then
                [[ "$mode" == client ]] && valid_addr "$via" && valid_name "$via_peer" ||
                    fail '--via HOST:PORT and --via-peer NAME go together, on a client tunnel'
            fi
            [[ -z "$allow" ]] || valid_cidr "$allow" || fail 'invalid --allow (IPv4 CIDR, for example 10.0.0.9/32)'
            need_enrollment
            mkdir -p "$TUNNELS"
            printf 'mode=%s\nlisten=%s\nto=%s\npeer=%s\nallow=%s\nvia=%s\nvia_peer=%s\n' \
                "$mode" "$listen" "$to" "$peer" "$allow" "$via" "$via_peer" > "$TUNNELS/$tname"
            tunnel_unit_install "$tname" "$mode"
            printf 'tunnel %s: %s %s -> %s\n' "$tname" "$mode" "$listen" "$to" ;;
        run)
            local tname="${1:-}" key value mode="" listen="" to="" peer="" allow="" via="" via_peer=""
            [[ "$tname" =~ ^[a-z0-9][a-z0-9-]{0,30}$ && -f "$TUNNELS/$tname" ]] || fail "no tunnel named ${tname:-?}"
            while IFS='=' read -r key value; do
                case "$key" in mode) mode="$value" ;; listen) listen="$value" ;; to) to="$value" ;; peer) peer="$value" ;; allow) allow="$value" ;; via) via="$value" ;; via_peer) via_peer="$value" ;; esac
            done < "$TUNNELS/$tname"
            valid_addr "$listen" && valid_addr "$to" || fail "tunnel $tname has an invalid address"
            [[ -z "$allow" ]] || valid_cidr "$allow" || fail "tunnel $tname has an invalid allow list"
            local range="${allow:+,range=$allow}"
            find_socat || fail 'socat is required for tunnels'
            local lhost="${listen%:*}" lport="${listen##*:}"
            local tls="cert=$STATE/node.crt,key=$STATE/node.key,cafile=$STATE/root_ca.crt,verify=1"
            case "$mode" in
                client)
                    valid_name "$peer" || fail "tunnel $tname has no valid peer"
                    [[ -n "$via" ]] || exec "$SOCAT" "TCP-LISTEN:$lport,bind=$lhost,reuseaddr,fork" "OPENSSL:$to,$tls,commonname=$peer"
                    valid_addr "$via" && valid_name "$via_peer" || fail "tunnel $tname has an invalid via"
                    # Two socat processes: the inner one speaks TLS to the server through a loopback
                    # hop, and the hop wraps that stream in TLS to the gate. The server's name is
                    # checked on the inner connection, so the gate cannot impersonate it.
                    local hop=$((lport + 1)) a b
                    "$SOCAT" "TCP-LISTEN:$hop,bind=127.0.0.1,reuseaddr,fork" "OPENSSL:$via,$tls,commonname=$via_peer" & b=$!
                    "$SOCAT" "TCP-LISTEN:$lport,bind=$lhost,reuseaddr,fork" "OPENSSL:127.0.0.1:$hop,$tls,commonname=$peer" & a=$!
                    trap 'kill "$a" "$b" 2>/dev/null' EXIT INT TERM
                    # macOS ships bash 3.2, which has no wait -n: poll, and stop when either exits.
                    while kill -0 "$a" 2>/dev/null && kill -0 "$b" 2>/dev/null; do sleep 2; done
                    exit 1 ;;
                server)
                    exec "$SOCAT" "OPENSSL-LISTEN:$lport,bind=$lhost,reuseaddr,fork,$tls$range" "TCP:$to" ;;
                gate)
                    exec "$SOCAT" "OPENSSL-LISTEN:$lport,bind=$lhost,reuseaddr,fork,$tls$range" "TCP:$to" ;;
                *) fail "tunnel $tname has an invalid mode" ;;
            esac ;;
        remove)
            local tname="${1:-}"
            [[ "$tname" =~ ^[a-z0-9][a-z0-9-]{0,30}$ ]] || fail 'usage: fleet tunnel remove NAME'
            if [[ "$(uname -s)" == Darwin ]]; then
                launchctl bootout "gui/$(id -u)" "$HOME/Library/LaunchAgents/dev.fleet.tunnel.$tname.plist" 2>/dev/null || true
                rm -f "$HOME/Library/LaunchAgents/dev.fleet.tunnel.$tname.plist"
            elif systemctl --user show-environment >/dev/null 2>&1; then
                systemctl --user disable --now "fleet-tunnel-$tname.service" 2>/dev/null || true
                rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/fleet-tunnel-$tname.service"
                systemctl --user daemon-reload
            fi
            rm -f "$TUNNELS/$tname" ;;
        list)
            local f
            for f in "$TUNNELS"/*; do [[ -f "$f" ]] && printf '%s: %s\n' "${f##*/}" "$(tr '\n' ' ' < "$f")"; done; true ;;
        *) fail 'usage: fleet tunnel add|run|remove|list' ;;
    esac
}

# The door is the public mTLS listener for fleet machines in front of a local TCP service (bb on
# brev). A tunnel server cannot face the internet: socat forks before the TLS handshake, has no
# handshake deadline (only a per-read timeout, which one byte every few seconds defeats), and so a
# few slow clients fill any child limit (task 030 part 3b). nginx's stream module has a deadline for
# the whole handshake (ssl_handshake_timeout, also in Ubuntu 22.04's 1.18), connection limits
# that apply before the handshake, and event-driven workers. It runs as a root system service and
# reads a root-only copy of this machine's certificate; a path unit and a timer copy each renewal
# and reload nginx, then check the certificate it serves. Fleet clients keep fleet tunnel client
# mode, which checks the door's fleet name.
DOOR_PREFIX="${FLEET_DOOR_PREFIX:-}"
DOOR_NGINX="${FLEET_DOOR_NGINX:-/usr/sbin/nginx}"
DOOR_MODULE="${FLEET_DOOR_MODULE:-/usr/lib/nginx/modules/ngx_stream_module.so}"
DOOR_UNITS="fleet-door.service fleet-door-sync.path fleet-door-sync.timer"
DOOR_USAGE='usage: fleet door render DIR|install [--listen HOST:PORT] [--to HOST:PORT] [--per-source N] [--max N] [--handshake-timeout S] | remove'

door_options() {
    door_listen=0.0.0.0:8461 door_to=127.0.0.1:38886 door_per_source=64 door_max=1024 door_deadline=10
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --listen) door_listen="${2:-}"; shift 2 ;;
            --to) door_to="${2:-}"; shift 2 ;;
            --per-source) door_per_source="${2:-}"; shift 2 ;;
            --max) door_max="${2:-}"; shift 2 ;;
            --handshake-timeout) door_deadline="${2:-}"; shift 2 ;;
            *) fail "$DOOR_USAGE" ;;
        esac
    done
    valid_addr "$door_listen" || fail 'invalid --listen (HOST:PORT)'
    # The sync checks the served certificate over loopback, which the total limit does not count.
    [[ "${door_listen%:*}" == 0.0.0.0 || "${door_listen%:*}" =~ ^127\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] ||
        fail 'invalid --listen: the host is 0.0.0.0 or a 127.x.x.x address'
    valid_addr "$door_to" || fail 'invalid --to (HOST:PORT)'
    [[ "$door_per_source" =~ ^[1-9][0-9]{0,4}$ ]] || fail 'invalid --per-source (connections per address)'
    [[ "$door_max" =~ ^[1-9][0-9]{0,4}$ ]] || fail 'invalid --max (connections in all)'
    [[ "$door_deadline" =~ ^[1-9][0-9]?$ && "$door_deadline" -le 60 ]] || fail 'invalid --handshake-timeout (1 to 60 seconds)'
    # The paths go into nginx and systemd files unquoted.
    [[ "$STATE$DOOR_PREFIX$DOOR_NGINX$DOOR_MODULE" =~ ^[A-Za-z0-9/._-]+$ ]] ||
        fail "the fleet state or door paths have characters the door files cannot hold: $STATE"
}

DOOR_FILES="etc/fleet-door/nginx.conf:644 usr/local/libexec/fleet-door-sync:755
etc/systemd/system/fleet-door.service:644 etc/systemd/system/fleet-door-sync.service:644
etc/systemd/system/fleet-door-sync.path:644 etc/systemd/system/fleet-door-sync.timer:644"

# Print one door file. install pipes it to root, so root never installs a file the user can write.
door_file() {
    local p="$DOOR_PREFIX" tls="$DOOR_PREFIX/etc/fleet-door/tls" sync="$DOOR_PREFIX/usr/local/libexec/fleet-door-sync"
    local check="$door_listen"
    [[ "${check%:*}" == 0.0.0.0 ]] && check="127.0.0.1:${check##*:}"
    case "$1" in
        etc/fleet-door/nginx.conf)
            # worker_connections counts both sides of each connection, so it is above twice --max.
            cat <<EOF
# Rendered by fleet door install. Mutual TLS with fleet certificates in front of $door_to.
load_module $DOOR_MODULE;
user www-data;
worker_processes 2;
worker_rlimit_nofile 16384;
pid $p/run/fleet-door.pid;
# A reload starts new workers; old ones keep their connections, for at most this long.
worker_shutdown_timeout 1h;
error_log stderr notice;
events {
    worker_connections 4096;
}
stream {
    limit_conn_zone \$binary_remote_addr zone=door_source:10m;
    # The sync checks the served certificate over loopback, so a full door does not fail that check.
    # A probe to any 127.x.x.x listener comes from 127.0.0.1. That address keeps the limit per
    # address, shared by every local client.
    map \$remote_addr \$door_all_key {
        127.0.0.1 "";
        default \$server_port;
    }
    limit_conn_zone \$door_all_key zone=door_all:1m;
    server {
        listen $door_listen ssl;
        limit_conn door_source $door_per_source;
        limit_conn door_all $door_max;
        ssl_certificate $tls/current/node.crt;
        ssl_certificate_key $tls/current/node.key;
        ssl_client_certificate $tls/current/root_ca.crt;
        ssl_verify_client on;
        ssl_verify_depth 1;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!eNULL:!PSK;
        ssl_handshake_timeout ${door_deadline}s;
        proxy_connect_timeout 5s;
        proxy_timeout 24h;
        proxy_pass $door_to;
    }
}
EOF
            ;;
        usr/local/libexec/fleet-door-sync)
            printf '#!/bin/bash\n# Rendered by fleet door install.\nset -euo pipefail\n'
            printf 'src=%q\ndst=%q\ncheck=%q\nfingerprint=%s\n' "$STATE" "$tls" "$check" "$fingerprint"
            cat <<'EOF'
# copy: copy this machine's fleet certificate for nginx, which reads it as root at start and reload.
# Without an argument, also reload nginx when the copy changed, then check what the door serves.
# nginx reads $dst/current, a link to a complete version folder, so a reload never sees a key from
# one copy and a certificate from another.
stale=28800
say() { printf 'fleet-door: %s\n' "$*" >&2; }
die() { say "$*"; exit 1; }
serial() { openssl x509 -noout -serial | sed 's/^serial=//'; }
umask 077
mkdir -p "$dst"
chmod 700 "$dst"
if [[ "${1:-}" == --locked-copy ]]; then
    [[ -n "${FLEET_DOOR_LOCKED:-}" ]] || die '--locked-copy runs only under the lock'
    tmp=$(mktemp -d "$dst/v.XXXXXX")
    trap 'rm -rf "$tmp" "$dst/.next"' EXIT
    for f in node.crt node.key root_ca.crt; do
        cp -- "$src/$f" "$tmp/$f" 2>/dev/null || die "cannot read $src/$f; is this machine enrolled?"
    done
    # Anyone who runs as the fleet user can write $src; only the CA that enrollment pinned admits clients.
    [[ "$(openssl x509 -noout -fingerprint -sha256 -in "$tmp/root_ca.crt" | sed 's/^.*=//; s/://g' |
          tr 'A-F' 'a-f')" == "$fingerprint" ]] || die "$src/root_ca.crt is not the fleet CA (fingerprint $fingerprint)"
    # fleet renew writes the certificate and the key one after the other; the path unit runs again.
    [[ "$(openssl x509 -noout -pubkey -in "$tmp/node.crt")" == "$(openssl pkey -pubout -in "$tmp/node.key")" ]] ||
        die "the certificate and key in $src do not match; retrying at the next change or timer"
    openssl verify -CAfile "$tmp/root_ca.crt" -untrusted "$tmp/node.crt" "$tmp/node.crt" >/dev/null 2>&1 ||
        die "the certificate in $src is expired or not issued by the fleet CA"
    changed=unchanged
    for f in node.crt node.key root_ca.crt; do cmp -s "$tmp/$f" "$dst/current/$f" || changed=changed; done
    if [[ "$changed" == changed ]]; then
        chmod 700 "$tmp"
        ln -sfn "${tmp##*/}" "$dst/.next"
        # rename(2) replaces the link in one step; mv would move it into the old version folder.
        perl -e 'rename($ARGV[0], $ARGV[1]) or die "fleet-door: $!\n"' "$dst/.next" "$dst/current"
        for old in "$dst"/v.*; do [[ "${old##*/}" == "${tmp##*/}" ]] || rm -rf "$old"; done
        tmp=""
        say "copied certificate serial $(serial < "$dst/current/node.crt")"
    fi
    # A door from before the version folders kept its files here.
    rm -f "$dst/node.crt" "$dst/node.key" "$dst/root_ca.crt"
    echo "$changed"
    exit 0
fi
# ExecStartPre, the path unit, and the timer can run at once, so the copy and the swap run under a
# lock. The lock ends before the reload: systemctl reload waits for a start in progress, and that
# start's ExecStartPre waits for the lock.
changed=$(FLEET_DOOR_LOCKED=1 perl -MFcntl=:flock -e 'BEGIN { $^F = 255 }
    open(my $lock, ">>", shift) or die "fleet-door: lock: $!\n";
    flock($lock, LOCK_EX) or die "fleet-door: lock: $!\n";
    exec { $ARGV[0] } @ARGV or die "fleet-door: $!\n"' "$dst/.lock" "$0" --locked-copy)
[[ "${1:-}" == copy ]] && exit 0
# Each probe is bounded, and so is the whole check: a door that accepts and never answers fails it.
want=$(serial < "$dst/current/node.crt") served="" served_file=$(mktemp)
trap 'rm -f "$served_file"' EXIT
probe() {
    timeout 5 openssl s_client -connect "$check" -tls1_3 </dev/null 2>/dev/null |
        openssl x509 > "$served_file" 2>/dev/null || true
    served=$(serial < "$served_file" 2>/dev/null || true)
}
# Reload when the copy changed, and also when the door serves another serial: an earlier reload
# may have failed, or an earlier run may have stopped between the swap and the reload. A probe that
# gets no certificate is not another serial: reloading a door that does not answer hides the fault.
if [[ "$changed" == unchanged ]]; then probe; fi
if [[ "$changed" != unchanged || ( -n "$served" && "$served" != "$want" ) ]]; then
    systemctl reload fleet-door.service || die 'could not reload fleet-door.service'
fi
# A reload that nginx rejects keeps the old certificate, so check the served one, not the copy.
end=$((SECONDS + 20))
while [[ "$served" != "$want" ]] && (( SECONDS < end )); do
    sleep 0.5
    probe
done
[[ "$served" == "$want" ]] || die "the door at $check serves serial ${served:-none}, not $want"
openssl x509 -noout -checkend "$stale" -in "$served_file" >/dev/null ||
    die "the served certificate expires within 8 hours; check fleet renew on this machine"
EOF
            ;;
        etc/systemd/system/fleet-door.service)
            # nginx measured on Ubuntu 22.04's 1.18: about 60 KB per connection, so 1024 connections take
            # about 70 MB; a reload can keep a second set of workers for up to an hour. TasksMax and
            # MemoryMax leave room for that and stop a runaway.
            printf '%s\n' '[Unit]' "Description=Fleet door: mTLS on $door_listen to $door_to" \
                'After=network-online.target' 'Wants=network-online.target' 'StartLimitIntervalSec=0' '' '[Service]' \
                "ExecStartPre=$sync copy" "ExecStart=$DOOR_NGINX -c $p/etc/fleet-door/nginx.conf -g 'daemon off;'" \
                'ExecReload=/bin/kill -HUP $MAINPID' 'Restart=always' 'RestartSec=5' 'TasksMax=32' 'MemoryMax=256M' \
                'LimitNOFILE=16384' 'NoNewPrivileges=yes' 'ProtectSystem=full' "ReadWritePaths=$tls" 'PrivateTmp=yes' \
                '' '[Install]' 'WantedBy=multi-user.target' ;;
        etc/systemd/system/fleet-door-sync.service)
            printf '%s\n' '[Unit]' 'Description=Copy the fleet certificate to the fleet door and check what it serves' \
                '' '[Service]' 'Type=oneshot' "ExecStart=$sync" ;;
        etc/systemd/system/fleet-door-sync.path)
            printf '%s\n' '[Unit]' 'Description=Refresh the fleet door when the fleet certificate changes' '' '[Path]' \
                "PathChanged=$STATE/node.crt" "PathChanged=$STATE/node.key" 'Unit=fleet-door-sync.service' '' \
                '[Install]' 'WantedBy=multi-user.target' ;;
        etc/systemd/system/fleet-door-sync.timer)
            printf '%s\n' '[Unit]' 'Description=Retry the fleet door refresh and check for a stale certificate' '' \
                '[Timer]' 'OnBootSec=2min' 'OnUnitActiveSec=15min' '' '[Install]' 'WantedBy=timers.target' ;;
    esac
}

# The sync runs as root but reads the user's state, so it trusts only the CA that enrollment pinned.
door_fingerprint() {
    load_config
    [[ -n "$fingerprint" ]] || fail 'no fleet CA fingerprint in the fleet config; enroll this machine first'
}

door_render() {
    local out="$1" entry rel
    door_fingerprint
    for entry in $DOOR_FILES; do
        rel="${entry%:*}"
        mkdir -p "$out/$(dirname "$rel")"
        door_file "$rel" > "$out/$rel"
        chmod "${entry##*:}" "$out/$rel"
    done
}

# The door copies the CA that enrollment pinned into its sync script. A new fleet CA needs a new install.
door_ca_check() {
    local installed
    installed=$(sed -n 's/^fingerprint=//p' "$DOOR_PREFIX/usr/local/libexec/fleet-door-sync" 2>/dev/null || true)
    [[ -z "$installed" || "$installed" == "$fingerprint" ]] ||
        printf 'fleet: the fleet door trusts CA %s, but this machine is enrolled with CA %s. Run fleet door install again.\n' \
            "$installed" "$fingerprint" >&2
}

door_remove() {
    local p="$DOOR_PREFIX"
    # shellcheck disable=SC2086
    sudo systemctl disable --now $DOOR_UNITS 2>/dev/null || true
    sudo rm -rf "$p/etc/fleet-door" "$p/usr/local/libexec/fleet-door-sync" "$p/etc/systemd/system/fleet-door.service" \
        "$p/etc/systemd/system/fleet-door-sync.service" "$p/etc/systemd/system/fleet-door-sync.path" \
        "$p/etc/systemd/system/fleet-door-sync.timer"
    sudo systemctl daemon-reload 2>/dev/null || true
}

cmd_door() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        render)
            [[ -n "${1:-}" ]] || fail "$DOOR_USAGE"
            local out="$1"; shift
            door_options "$@"
            door_render "$out" ;;
        install)
            door_options "$@"
            need_enrollment
            [[ -x "$DOOR_NGINX" && -f "$DOOR_MODULE" ]] ||
                fail "nginx with the stream module is required: sudo apt-get install nginx-core libnginx-mod-stream"
            door_fingerprint
            local p="$DOOR_PREFIX" entry rel content
            # sudo -v asks for a password when any sudoers rule needs one, even beside a NOPASSWD
            # rule, so try a command without a password first.
            sudo -n true 2>/dev/null || sudo -v
            sudo install -d -m 755 "$p/etc/fleet-door" "$p/usr/local/libexec" "$p/etc/systemd/system"
            sudo install -d -m 700 "$p/etc/fleet-door/tls"
            # Each file goes to root on stdin and lands in a root-owned folder: no file the user can
            # write is installed, so nothing can be swapped in while sudo asks for a password.
            for entry in $DOOR_FILES; do
                rel="${entry%:*}"
                # Render first: a render that fails stops the install before root writes anything.
                content=$(door_file "$rel")
                printf '%s\n' "$content" |
                    sudo sh -c 'umask 077; cat > "$1.new" && chmod "$2" "$1.new" && mv -f "$1.new" "$1"' \
                    sh "$p/$rel" "${entry##*:}"
            done
            sudo systemctl daemon-reload
            # shellcheck disable=SC2086
            sudo systemctl enable $DOOR_UNITS
            sudo systemctl restart fleet-door.service
            sudo systemctl restart fleet-door-sync.path fleet-door-sync.timer
            # The first sync checks that the door serves this machine's certificate.
            sudo systemctl start fleet-door-sync.service
            printf 'fleet door: %s -> %s, %s per address, %s in all, handshake within %ss\n' \
                "$door_listen" "$door_to" "$door_per_source" "$door_max" "$door_deadline" ;;
        remove)
            [[ $# -eq 0 ]] || fail "$DOOR_USAGE"
            door_remove ;;
        *) fail "$DOOR_USAGE" ;;
    esac
}

# Remove everything fleet set up on this machine. The dotfiles still own the fleet script and the
# Include line in ~/.ssh/config, which is harmless once ~/.ssh/fleet is gone.
cmd_uninstall() {
    local yes=0 keep=0 answer f
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --yes) yes=1; shift ;;
            --keep-cert) keep=1; shift ;;
            *) fail 'usage: fleet uninstall [--yes] [--keep-cert]' ;;
        esac
    done
    load_config
    if [[ "$yes" == 0 ]]; then
        [[ -t 0 ]] || fail 'refusing to uninstall without a terminal to confirm; pass --yes'
        printf 'Remove fleet from this machine%s: revoke its certificate, stop its services, and delete its keys? [y/N] ' \
            "${name:+ ($name)}"
        read -r answer
        [[ "$answer" =~ ^[Yy] ]] || fail 'cancelled'
    fi
    local revoked=kept
    if [[ "$keep" == 0 && -f "$STATE/node.crt" && -n "$ca_url" ]]; then
        # Revoke with the certificate itself, so a removed machine is cut off now, not in 24 hours.
        if find_step && "$STEP" ca revoke --cert "$STATE/node.crt" --key "$STATE/node.key" --ca-url "$ca_url" \
                --root "$STATE/root_ca.crt" >/dev/null 2>&1; then
            revoked=revoked
        else
            revoked='not revoked (the CA did not answer; it expires within 24 hours)'
        fi
    fi
    for f in "$TUNNELS"/*; do
        [[ -f "$f" ]] && cmd_tunnel remove "${f##*/}"
    done
    # The door reads this machine's certificate, which is deleted below.
    [[ -f "$DOOR_PREFIX/etc/systemd/system/fleet-door.service" ]] && door_remove
    # The actl worker reads its seed and configuration from the fleet folders removed below.
    if [[ "$(uname -s)" == Darwin ]]; then
        launchctl bootout "gui/$(id -u)" "$HOME/Library/LaunchAgents/dev.fleet.agent.plist" 2>/dev/null || true
        rm -f "$HOME/Library/LaunchAgents/dev.fleet.agent.plist"
        launchctl bootout "gui/$(id -u)/dev.fleet.worker" 2>/dev/null || true
        rm -f "$WORKER_PLIST"
    elif systemctl --user show-environment >/dev/null 2>&1; then
        systemctl --user disable --now fleet-agent.service 2>/dev/null || true
        systemctl --user disable --now fleet-worker.service 2>/dev/null || true
        rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/fleet-agent.service" "$SYSTEMD_UNIT"
        systemctl --user daemon-reload 2>/dev/null || true
    fi
    rm -f "$(agent_sock)"
    cmd_timer remove
    edit_authorized_keys ""
    rm -rf "$SSH_FLEET" "$STATE" "$CONFIG_DIR"
    printf 'fleet removed from this machine%s. Certificate: %s.\n' "${name:+ ($name)}" "$revoked"
    printf 'Not removed: pylon and actl (~/.local/bin), and any bb host daemon. Remove the machine from bb with bb machine remove.\n'
}

cmd_agent() {
    case "${1:-run}" in
        run) agent_run ;;
        install) agent_install ;;
        remove) agent_remove ;;
        *) fail 'usage: fleet agent [run|install|remove]' ;;
    esac
}

cmd_status() {
    load_config
    if [[ -z "$name" || ! -f "$STATE/node.crt" ]]; then
        printf 'not enrolled\n'
        [[ -n "$ca_url" ]] && printf 'ca: %s\n' "$ca_url"
        return 1
    fi
    printf 'name: %s\nca: %s\nserial: %s\n' "$name" "$ca_url" "$(serial_of "$STATE/node.crt")"
    printf 'client certificate: %s\n' "$(openssl x509 -noout -enddate -in "$STATE/node.crt" 2>/dev/null | sed 's/^notAfter=/expires /' || echo unreadable)"
    if [[ -f "$STATE/id_fleet-cert.pub" ]]; then
        printf 'ssh certificate: %s\n' "$(ssh-keygen -Lf "$STATE/id_fleet-cert.pub" 2>/dev/null | sed -n 's/^ *Valid: //p' || echo unreadable)"
    else
        printf 'ssh certificate: missing\n'
    fi
    if grep -q '^# BEGIN fleet$' "$HOME/.ssh/authorized_keys" 2>/dev/null; then
        printf 'trust: authorized_keys accepts principal %s\n' "${principal:-ryan}"
    else
        printf 'trust: off\n'
    fi
    if [[ -f "$SSH_FLEET/agent" ]]; then
        local sock bridge=socat keys
        sock=$(agent_sock)
        find_pylon && bridge=pylon
        if keys=$(SSH_AUTH_SOCK="$sock" ssh-add -L 2>/dev/null); then
            printf 'agent: %s on %s, %s keys\n' "$bridge" "$sock" "$(grep -c . <<<"$keys")"
        else
            printf 'agent: %s on %s, not answering\n' "$bridge" "$sock"
        fi
    else
        printf 'agent: off\n'
    fi
    need_broker
    if [[ "$(curl -fsS --max-time 5 --cert "$STATE/node.crt" --key "$STATE/node.key" --cacert "$STATE/root_ca.crt" \
            -H 'Accept: application/octet-stream' "$broker_url/v1/secrets/fleet-selftest" 2>/dev/null)" == ok ]]; then
        printf 'broker: ok\n'
    else
        printf 'broker: no answer\n'
    fi
}

# ---- actl fleet deployment (agentic-control task 029) ----
# Each fleet machine runs one actl worker as the user, and the admin laptop sends tasks to it. The
# broker serves the connection data at /v1/actl, so the controller's tailnet name stays out of this
# public script. JSON is parsed by the helper below, so these commands need python3 (3.9 or later).
FLEET_PY=$(cat <<'PY'
import json, os, re, sys

SERVER = re.compile(r'tls://[A-Za-z0-9][A-Za-z0-9.-]{0,252}:[0-9]{1,5}')
PEM = re.compile(r'(-----BEGIN CERTIFICATE-----\n[A-Za-z0-9+/=\n]+-----END CERTIFICATE-----\n)+')
WORKER_ID = re.compile(r'[A-Za-z0-9_-]{1,59}')
TASK_KEYS = {'protocol_version', 'id', 'correlation_id', 'parent_task_id', 'repository', 'commit', 'task_type',
             'context_refs', 'required_capabilities', 'policy', 'created_at'}


def sync_dir(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def atomic(path, text, mode=None):
    """Write a temporary file, sync it, rename it over PATH, and sync the directory."""
    d = os.path.dirname(os.path.abspath(path))
    tmp = os.path.join(d, '.' + os.path.basename(path) + '.tmp')
    with open(tmp, 'w') as f:
        f.write(text)
        f.flush()
        os.fsync(f.fileno())
    if mode is not None:
        os.chmod(tmp, mode)
    os.replace(tmp, path)
    sync_dir(d)


def workers_of(data):
    workers = data.get('workers')
    if not isinstance(workers, list) or len(workers) > 50:
        sys.exit('workers must be a list of at most 50 entries')
    seen = set()
    for w in workers:
        if not isinstance(w, dict) or set(w) != {'id', 'os'} or not isinstance(w['id'], str) \
                or not WORKER_ID.fullmatch(w['id']) or w['os'] not in ('linux', 'macos') or w['id'].lower() in seen:
            sys.exit(f'invalid worker entry {w!r}')
        seen.add(w['id'].lower())
    return workers


def load(path):
    with open(path) as f:
        return json.load(f)


cmd, a = sys.argv[1], sys.argv[2:]
if cmd == 'actl-endpoint':
    # /v1/actl from the broker: check it again here, then write servers (one per line), tls_first,
    # ca.pem, and workers into a[1]. actl takes one to eight servers.
    data = load(a[0])
    if not isinstance(data, dict):
        sys.exit('not an object')
    servers, tls_first, ca = data.get('servers'), data.get('tls_first'), data.get('ca_pem')
    if not isinstance(servers, list) or not 1 <= len(servers) <= 8 or len(set(map(str, servers))) != len(servers):
        sys.exit(f'invalid servers {servers!r}')
    for server in servers:
        if not isinstance(server, str) or not SERVER.fullmatch(server) or not 0 < int(server.rsplit(':', 1)[1]) < 65536:
            sys.exit(f'invalid server {server!r}')
    if not isinstance(tls_first, bool):
        sys.exit(f'invalid tls_first {tls_first!r}')
    if not isinstance(ca, str) or not PEM.fullmatch(ca):
        sys.exit('invalid ca_pem')
    workers = workers_of(data)
    with open(os.path.join(a[1], 'servers'), 'w') as f:
        f.write(''.join(s + '\n' for s in servers))
    with open(os.path.join(a[1], 'tls_first'), 'w') as f:
        f.write('true' if tls_first else 'false')
    with open(os.path.join(a[1], 'ca.pem'), 'w') as f:
        f.write(ca)
    with open(os.path.join(a[1], 'workers'), 'w') as f:
        f.write(''.join(f"{w['id']} {w['os']}\n" for w in workers))
elif cmd == 'sync-dir':
    sync_dir(a[0])
elif cmd == 'install-file':
    # Replace a[1] with the contents of a[0] atomically, keeping the mode of the file it replaces.
    with open(a[0]) as f:
        text = f.read()
    try:
        mode = os.stat(a[1]).st_mode & 0o777
    except FileNotFoundError:
        mode = 0o600
    atomic(a[1], text, mode)
elif cmd == 'drained-pid':
    # The worker's drain acknowledgement: {"pid": N, "drained_at": UNIX_SECONDS}.
    data = load(a[0])
    pid = data.get('pid') if isinstance(data, dict) else None
    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
        sys.exit(1)
    print(pid)
elif cmd == 'roster-add':
    path, wid, wos = a
    data = load(path)
    if not isinstance(data, dict):
        sys.exit(f'{path} is not a JSON object')
    workers = workers_of(data)
    for w in workers:
        if w['id'].lower() == wid.lower():
            if w['id'] == wid and w['os'] == wos:
                print('present')
                sys.exit(0)
            sys.exit(f"{wid} is already in the roster as {w['id']} ({w['os']}); fix {path} by hand")
    workers.append({'id': wid, 'os': wos})
    atomic(path, json.dumps(data, indent=2) + '\n', os.stat(path).st_mode & 0o777)
    print('added')
elif cmd == 'workers-has':
    # One page of `actl --json workers`: print "found", or the cursor of the next page, or nothing.
    data = load(a[0])
    if any(r.get('worker', {}).get('worker_id') == a[1] for r in data.get('workers', [])):
        print('found')
    elif data.get('next'):
        print(data['next'])
elif cmd == 'spec-write':
    path, task, commit, timeout, hosts, roster = a
    with open(roster) as f:
        entries = [line.split() for line in f if line.strip()]
    spec = {'task': task, 'commit': commit, 'timeout': int(timeout), 'hosts': hosts.split(','),
            'roster': [{'id': i, 'os': o} for i, o in entries], 'repository': 'dotfiles'}
    atomic(path, json.dumps(spec, indent=2) + '\n')
elif cmd == 'spec-read':
    spec = load(a[0])
    hosts = spec['hosts']
    if not isinstance(hosts, list) or not all(isinstance(h, str) and WORKER_ID.fullmatch(h) for h in hosts):
        sys.exit('invalid hosts')
    if spec['task'] not in a[1].split() or not re.fullmatch(r'[0-9a-f]{40}', spec['commit']):
        sys.exit('invalid task or commit')
    print(spec['task'], spec['commit'])
    for h in hosts:
        print(h)
elif cmd == 'task-doc':
    # A saved task document counts only if it is complete and is the task of this run and machine.
    path, task, commit, host = a
    try:
        doc = load(path)
    except (OSError, ValueError):
        sys.exit(1)
    if not isinstance(doc, dict) or not TASK_KEYS <= set(doc) or not isinstance(doc['id'], str) \
            or not re.fullmatch(r'[0-9a-f-]{36}', doc['id']) or doc['repository'] != 'dotfiles' \
            or doc['task_type'] != task or doc['commit'] != commit or doc['required_capabilities'] != [f'host-{host}']:
        sys.exit(1)
    print(doc['id'])
elif cmd == 'record':
    # The reply of `actl --json submit` or `actl --json status`: print "TASK_ID STATE DETAIL".
    data = load(a[0])
    record = data['record']
    state = record['state']
    status = state['status']
    detail = '-'
    result = state.get('result') or {}
    if status == 'completed':
        detail = f"exit={result.get('exit_code')}"
    elif status == 'failed':
        detail = f"{state.get('reason')},exit={result.get('exit_code')}"
    elif status == 'queued' and data.get('eligible_workers') == 0:
        detail = 'no-eligible-worker'
    print(record['task']['id'], status, detail)
elif cmd in ('fence', 'fence-record'):
    # ~/.local/state/fleet/applied: one line "EXECUTOR COMMIT COMMITTER_TIME" for each executor. A
    # malformed file stops the executor rather than letting a stale commit through.
    path, name, commit, ctime = a
    records = {}
    if os.path.exists(path):
        with open(path) as f:
            for line in f:
                parts = line.split()
                if len(parts) != 3 or not re.fullmatch(r'[a-z-]{1,32}', parts[0]) \
                        or not re.fullmatch(r'[0-9a-f]{40}', parts[1]) or not parts[2].isdigit():
                    sys.exit(f'{path} is malformed; inspect it')
                records[parts[0]] = (parts[1], int(parts[2]))
    if cmd == 'fence':
        old = records.get(name)
        if old is None:
            print('apply')
        elif old[0] == commit:
            print('repeat')
        elif int(ctime) < old[1]:
            print('stale', old[0], old[1])
        else:
            print('apply')
    else:
        records[name] = (commit, int(ctime))
        atomic(path, ''.join(f'{k} {c} {t}\n' for k, (c, t) in sorted(records.items())), 0o600)
elif cmd == 'status-version':
    # pylon's GET /v1/status on stdin: print its version, or exit 2 when it reports none.
    data = json.load(sys.stdin)
    version = data.get('version') if isinstance(data, dict) else None
    if not isinstance(version, str) or not re.fullmatch(r'[0-9A-Za-z.+-]{1,64}', version):
        sys.exit(2)
    print(version)
else:
    sys.exit(f'unknown helper command {cmd}')
PY
)

need_python() { command -v python3 >/dev/null 2>&1 || fail 'python3 is required for the actl commands'; }
fpy() { python3 -c "$FLEET_PY" "$@"; }
valid_worker_id() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,59}$ ]]; }
valid_nkey() { [[ "$1" =~ ^U[A-Z2-7]{55}$ ]]; }
valid_commit() { [[ "$1" =~ ^[0-9a-f]{40}$ ]]; }

actl_target() { printf '%s-%s' "$(uname -s | tr '[:upper:]' '[:lower:]')" "$(uname -m)"; }

# actl_pin BINARY: the pinned SHA-256 of actl or actl-supervisor for this machine.
actl_pin() {
    local target var
    [[ -n "${ACTL_VERSION:-}" ]] ||
        fail 'actl is not pinned in this fleet script (ACTL_VERSION). The first actl release (agentic-control task 029, part 6) adds the pins. For client commands, FLEET_ACTL can name a local actl.'
    target=$(actl_target)
    var="$(printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_')_SHA256_${target//-/_}"
    [[ -n "${!var:-}" ]] || fail "actl is not pinned for $target ($var)"
    printf '%s' "${!var}"
}

broker_get() {
    curl -fsS --connect-timeout 5 --max-time 30 --cert "$STATE/node.crt" --key "$STATE/node.key" \
        --cacert "$STATE/root_ca.crt" -H 'Accept: application/json' "$broker_url$1"
}

# Sets ACTL_BIN to the install folder and ACTL_STAGE to a folder with the pinned pair: the installed
# binaries when both match, else both downloads, each checked before anything is replaced.
# ACTL_NEW is 1 when the installed pair must be replaced.
stage_actl_pair() {
    local sum_a sum_s target name
    sum_a=$(actl_pin actl)
    sum_s=$(actl_pin actl-supervisor)
    target=$(actl_target)
    ACTL_BIN=$(local_bin)
    if [[ -x "$ACTL_BIN/actl" && -x "$ACTL_BIN/actl-supervisor" && "$(sha256_of "$ACTL_BIN/actl")" == "$sum_a" &&
          "$(sha256_of "$ACTL_BIN/actl-supervisor")" == "$sum_s" ]]; then
        ACTL_STAGE="$ACTL_BIN" ACTL_NEW=0
        return 0
    fi
    need_enrollment
    need_broker
    mkdir -p "$ACTL_BIN"
    scratch "$ACTL_BIN"; ACTL_STAGE="$SCRATCH" ACTL_NEW=1
    for name in actl actl-supervisor; do
        curl -fsS --cert "$STATE/node.crt" --key "$STATE/node.key" --cacert "$STATE/root_ca.crt" \
            -o "$ACTL_STAGE/$name" "$broker_url/v1/artifacts/$name/$ACTL_VERSION/$target" ||
            fail "the broker did not return $name $ACTL_VERSION for $target"
    done
    [[ "$(sha256_of "$ACTL_STAGE/actl")" == "$sum_a" ]] || fail 'actl download checksum mismatch; nothing installed'
    [[ "$(sha256_of "$ACTL_STAGE/actl-supervisor")" == "$sum_s" ]] ||
        fail 'actl-supervisor download checksum mismatch; nothing installed'
    chmod 0755 "$ACTL_STAGE/actl" "$ACTL_STAGE/actl-supervisor"
}

install_actl_pair() {
    mv -f "$ACTL_STAGE/actl-supervisor" "$ACTL_BIN/actl-supervisor"
    mv -f "$ACTL_STAGE/actl" "$ACTL_BIN/actl"
    printf 'installed actl %s in %s\n' "$ACTL_VERSION" "$ACTL_BIN" >&2
}

# Sets ACTL for the laptop commands: FLEET_ACTL, else the pinned pair, installed when needed. The
# pair of a machine that also runs a worker changes only through fleet worker install, which drains it.
need_actl() {
    if [[ -n "${FLEET_ACTL:-}" ]]; then
        [[ -x "$FLEET_ACTL" ]] || fail "FLEET_ACTL ($FLEET_ACTL) is not executable"
        ACTL="$FLEET_ACTL"
        return 0
    fi
    stage_actl_pair
    if [[ "$ACTL_NEW" == 1 ]]; then
        [[ ! -f "$ACTL_CONFIG_DIR/worker.toml" ]] ||
            fail 'this machine runs an actl worker with another actl; update it with fleet worker install'
        install_actl_pair
    fi
    ACTL="$ACTL_BIN/actl"
}

file_stat() { stat -c '%a %u %h' "$1" 2>/dev/null || stat -f '%Lp %u %l' "$1"; }

private_dir_ok() {
    local mode uid links
    [[ -d "$1" && ! -L "$1" ]] || return 1
    read -r mode uid links <<<"$(file_stat "$1")"
    [[ "$mode" == 700 && "$uid" == "$(id -u)" ]]
}

# seed_ready PATH: true for a seed that fleet may use, false when there is none. Anything else
# stops, because a seed that someone else could read or replace must not identify this machine.
seed_ready() {
    local seed="$1" mode uid links
    [[ -e "$seed" || -L "$seed" ]] || return 1
    [[ -f "$seed" && ! -L "$seed" ]] || fail "the seed $seed is not a regular file; inspect it and remove it"
    read -r mode uid links <<<"$(file_stat "$seed")"
    [[ "$mode" == 600 && "$uid" == "$(id -u)" && "$links" == 1 ]] ||
        fail "the seed $seed must have mode 600, one link, and owner $(id -un); inspect it and remove it"
    private_dir_ok "$(dirname "$seed")" ||
        fail "the seed directory $(dirname "$seed") must have mode 700 and owner $(id -un); inspect it"
    return 0
}

# ensure_seed PATH ACTL: use the seed at PATH, or create it with actl keygen. Sets SEED_KEY to its
# public key and SEED_NEW. The public key is kept in PATH.pub, because a seed does not give it back
# without the NKey library. The seed appears last, so an interrupted run never leaves a seed
# whose key was not recorded.
ensure_seed() {
    local seed="$1" actl="$2" dir pub key
    dir=$(dirname "$seed") pub="${1%.seed}.pub"
    if seed_ready "$seed"; then
        [[ -f "$pub" ]] || fail "the seed $seed has no public key file $pub. If this key was never enrolled, remove the seed and run again."
        key=$(<"$pub")
        valid_nkey "$key" || fail "$pub does not hold a public user NKey"
        SEED_KEY="$key" SEED_NEW=0
        return 0
    fi
    if [[ ! -e "$dir" ]]; then
        mkdir -p "$(dirname "$dir")"
        mkdir -m 700 "$dir"
    fi
    private_dir_ok "$dir" || fail "the seed directory $dir must have mode 700 and owner $(id -un); inspect it"
    rm -f "$seed.new"
    key=$("$actl" keygen --seed-file "$seed.new") || fail 'actl keygen failed'
    valid_nkey "$key" || { rm -f "$seed.new"; fail 'actl keygen did not print a public user NKey'; }
    printf '%s\n' "$key" > "$pub.tmp"
    mv -f "$pub.tmp" "$pub"
    mv "$seed.new" "$seed"
    SEED_KEY="$key" SEED_NEW=1
}

# fetch_actl DIR: read /v1/actl into DIR (servers, tls_first, ca.pem, workers) and load it.
fetch_actl() {
    need_python
    need_enrollment
    need_broker
    broker_get /v1/actl > "$1/actl.json" ||
        fail 'the broker did not return /v1/actl; the actl deployment is not published yet (fleet-config broker/actl.json)'
    fpy actl-endpoint "$1/actl.json" "$1" || fail 'the broker returned malformed /v1/actl data'
    load_actl "$1"
}

# load_actl DIR: set ACTL_SERVERS and ACTL_TLS_FIRST from the files of fetch_actl.
load_actl() {
    local line
    ACTL_SERVERS=()
    while IFS= read -r line; do ACTL_SERVERS+=("$line"); done < "$1/servers"
    ACTL_TLS_FIRST=$(<"$1/tls_first")
}

# actl reads client_certificate, client_key, and tls_first from 0.3.0 on (agentic-control task
# 030), and an older actl refuses a configuration with fields it does not know. So the settings
# follow the actl that reads the file, not the pin: a fleet-apply can update this script before
# fleet worker install replaces the binary.
actl_reads_tls() {
    local v
    v=$("$1" --version 2>/dev/null) || return 1
    [[ "$v" =~ ^actl\ ([0-9]+)\.([0-9]+)\.[0-9]+ ]] || return 1
    (( BASH_REMATCH[1] > 0 || BASH_REMATCH[2] >= 3 ))
}

# render_connection PRINCIPAL SEED ACTL [CA]: the [connection] section for ACTL. CA defaults to the
# installed ca.pem. The client certificate is this machine's fleet certificate, which fleet renew
# replaces atomically; actl reads it again on each connect.
render_connection() {
    local principal="$1" seed="$2" actl="$3" ca="${4:-$ACTL_CONFIG_DIR/ca.pem}"
    toml_check "${ACTL_SERVERS[@]}" "$ca" "$seed" "$STATE"
    printf '[connection]\nservers = %s\nca_certificate = "%s"\nseed_file = "%s"\nprincipal = "%s"\n' \
        "$(toml_list "${ACTL_SERVERS[@]}")" "$ca" "$seed" "$principal"
    if actl_reads_tls "$actl"; then
        printf 'client_certificate = "%s"\nclient_key = "%s"\ntls_first = %s\n' \
            "$STATE/node.crt" "$STATE/node.key" "$ACTL_TLS_FIRST"
    fi
}

# TOML basic strings without escapes. Paths and values with a quote, backslash, or control
# character are refused rather than escaped, so the rendered file needs no TOML parser to check.
toml_check() {
    local v
    for v in "$@"; do
        [[ "$v" != *'"'* && "$v" != *'\'* && ! "$v" =~ [[:cntrl:]] ]] || fail "cannot write this value into TOML: $v"
    done
}
toml_list() {
    local v out=""
    for v in "$@"; do out="${out:+$out, }\"$v\""; done
    printf '[%s]' "$out"
}

worker_os() {
    case "$(uname -s)" in
        Linux) echo linux ;;
        Darwin) echo macos ;;
        *) fail "unsupported system $(uname -s)" ;;
    esac
}

# The worker ID is the fleet machine name, not an SSH alias, and also names the principal
# worker.ID and the capability host-ID.
worker_id() {
    load_config
    valid_worker_id "$name" ||
        fail "the fleet name '$name' is not a valid actl worker ID (1-59 letters, digits, _ or -)"
    printf '%s' "$name"
}

# A fixed PATH, not the caller's: a rendered file that depends on the shell that ran install would
# restart the worker after each install from a different shell.
executor_path() {
    local p out="" list
    list=("$(local_bin)" "$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/.pixi/bin")
    if [[ "$(uname -s)" == Darwin ]]; then
        list+=(/opt/homebrew/bin /opt/homebrew/sbin /usr/local/bin /usr/bin /bin /usr/sbin /sbin)
    else
        list+=(/usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin)
    fi
    for p in "${list[@]}"; do
        [[ ":$out:" == *":$p:"* ]] || out="${out:+$out:}$p"
    done
    printf '%s' "$out"
}

git_binary() {
    if [[ -x /usr/bin/git ]]; then echo /usr/bin/git; return; fi
    local git; git=$(command -v git 2>/dev/null || true)
    [[ "$git" == /* ]] || fail 'git is required for the actl worker'
    echo "$git"
}

# render_worker FILE ID OS ACTL: the worker configuration. The worker clears the environment of each
# executor, so the executors are /usr/bin/env with fixed arguments that remove the worker's Git
# variables and set the user's (ruling R5 of task 029). The command runs the fleet script of the
# task's checkout, so the code that runs is the code at the task's commit.
render_worker() {
    local out="$1" id="$2" os="$3" actl="$4" user lang git bin env_args name run
    user=$(id -un)
    git=$(git_binary)
    bin=$ACTL_BIN
    if [[ "$os" == macos ]]; then lang=en_US.UTF-8; else lang=C.UTF-8; fi
    env_args=(-u GIT_CONFIG_GLOBAL -u GIT_CONFIG_NOSYSTEM -u GIT_TERMINAL_PROMPT -u GIT_LFS_SKIP_SMUDGE
        "HOME=$HOME" "USER=$user" "LOGNAME=$user" "LANG=$lang" "XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}"
        "XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}")
    # The runtime folder of the user who runs install (user_bus fills it for an SSH session without
    # one): systemctl --user finds the user manager through it, and pylon keeps its sockets in it.
    [[ "$os" == linux ]] && env_args+=("XDG_RUNTIME_DIR=$(user_runtime_dir)")
    env_args+=("PATH=$(executor_path)")
    toml_check "$WORKER_ROOT" "$git" "$bin" "${env_args[@]}"
    {
        render_connection "worker.$id" "$ACTL_STATE/worker.seed" "$actl"
        printf '\n[worker]\nroot = "%s"\ngit_binary = "%s"\nsupervisor_binary = "%s"\n' \
            "$WORKER_ROOT" "$git" "$bin/actl-supervisor"
        printf 'max_disk_bytes = 10737418240\nretain_attempts = 100\ncapabilities = ["host-%s", "os-%s"]\n\n' "$id" "$os"
        printf '[worker.repositories]\ndotfiles = "%s"\n' "$DOTFILES_URL"
        for name in fleet-apply pylon-install secrets-flush fleet-probe; do
            case "$name" in
                fleet-apply) run=(executor apply) ;;
                pylon-install) run=(executor pylon-install) ;;
                secrets-flush) run=(secret flush) ;;
                fleet-probe) run=(executor probe) ;;
            esac
            printf '\n[worker.executors.%s]\nkind = "command"\nprogram = "/usr/bin/env"\nargs = %s\n' "$name" \
                "$(toml_list "${env_args[@]}" /bin/bash dot_local/bin/executable_fleet "${run[@]}")"
        done
    } > "$out"
}

SYSTEMD_UNIT="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/fleet-worker.service"
WORKER_PLIST="$HOME/Library/LaunchAgents/dev.fleet.worker.plist"
WORKER_LOG="$HOME/Library/Logs/fleet-worker.log"

# SSH sessions without a login session (Tailscale SSH) have no XDG_RUNTIME_DIR, and
# systemctl --user needs it to find the user manager.
user_bus() {
    if [[ "$(uname -s)" == Linux && -z "${XDG_RUNTIME_DIR:-}" && -d "$(user_runtime_dir)" ]]; then
        XDG_RUNTIME_DIR=$(user_runtime_dir)
        export XDG_RUNTIME_DIR
    fi
}

worker_service_kind() {
    if [[ "$(uname -s)" == Darwin ]]; then echo launchd
    elif systemctl --user show-environment >/dev/null 2>&1; then echo systemd
    else fail 'the actl worker needs a systemd user session or launchd'
    fi
}

worker_service_file() { if [[ "$1" == launchd ]]; then echo "$WORKER_PLIST"; else echo "$SYSTEMD_UNIT"; fi; }

# The service row of task 029. On macOS, KeepAlive restarts only a failed worker: launchd starts a
# job again at once after any exit, and the new worker would replace the drain acknowledgement of
# the one that drained before install could read it. systemd waits RestartSec first.
# Each start runs fleet worker refresh first. systemd ignores its failure ("-"), and launchd has no
# such hook, so the agent runs fleet worker run, which refreshes and then execs actl in the same
# process: launchd and the drain check see the worker's process ID.
render_worker_service() {
    local out="$1" kind="$2" config="$ACTL_CONFIG_DIR/worker.toml" actl="$ACTL_BIN/actl"
    [[ "$config$actl$SELF" != *[[:space:]]* ]] || fail 'the worker paths must not contain white space'
    if [[ "$kind" == launchd ]]; then
        cat > "$out" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>dev.fleet.worker</string>
    <key>ProgramArguments</key><array><string>$SELF</string><string>worker</string><string>run</string></array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
    <key>ExitTimeOut</key><integer>60</integer>
    <key>StandardOutPath</key><string>$WORKER_LOG</string>
    <key>StandardErrorPath</key><string>$WORKER_LOG</string>
</dict>
</plist>
EOF
    else
        # systemd expands % specifiers and $ variables in ExecStart, so the unit would run another path.
        [[ "$config$actl$SELF" != *[%\$]* ]] || fail 'the worker paths must not contain % or $ for a systemd unit'
        printf '%s\n' '[Unit]' 'Description=Fleet actl worker' '' '[Service]' \
            "ExecStartPre=-$SELF worker refresh" "ExecStart=$actl --config $config worker" 'Restart=always' 'RestartSec=30' 'TimeoutStopSec=90' '' \
            '[Install]' 'WantedBy=default.target' > "$out"
    fi
}

# The main process ID of the worker service, or 0.
worker_pid() {
    local pid
    if [[ "$1" == launchd ]]; then
        pid=$(launchctl print "gui/$(id -u)/dev.fleet.worker" 2>/dev/null | awk '$1 == "pid" && $2 == "=" {print $3; exit}') || true
    else
        pid=$(systemctl --user show -p MainPID --value fleet-worker.service 2>/dev/null) || true
    fi
    [[ "$pid" =~ ^[0-9]+$ ]] || pid=0
    echo "$pid"
}

worker_failed() { [[ "$1" == systemd ]] && systemctl --user is-failed --quiet fleet-worker.service 2>/dev/null; }

worker_log() {
    if [[ "$1" == launchd ]]; then tail -n 40 "$WORKER_LOG" 2>/dev/null || true
    else journalctl --user -u fleet-worker.service -n 40 --no-pager 2>&1 || true
    fi
}

worker_stop() {
    if [[ "$1" == launchd ]]; then launchctl bootout "gui/$(id -u)/dev.fleet.worker" 2>/dev/null || true
    else systemctl --user stop fleet-worker.service 2>/dev/null || true
    fi
}

# Load, enable, and start the service from its current files.
worker_start() {
    if [[ "$1" == launchd ]]; then
        launchctl bootout "gui/$(id -u)/dev.fleet.worker" 2>/dev/null || true
        launchctl bootstrap "gui/$(id -u)" "$WORKER_PLIST"
    else
        systemctl --user daemon-reload
        systemctl --user enable fleet-worker.service >/dev/null 2>&1
        systemctl --user start fleet-worker.service
        local user; user=$(id -un)
        if [[ "$(loginctl show-user "$user" -p Linger --value 2>/dev/null || true)" != yes ]]; then
            loginctl enable-linger "$user" 2>/dev/null ||
                printf 'fleet: linger is off, so the worker stops at logout. Ask an admin for: loginctl enable-linger %s\n' "$user" >&2
        fi
    fi
}

# Start a service that is installed but not running, without changing its files.
worker_ensure_running() {
    if [[ "$1" == launchd ]]; then
        if ! launchctl print "gui/$(id -u)/dev.fleet.worker" >/dev/null 2>&1; then
            launchctl bootstrap "gui/$(id -u)" "$WORKER_PLIST"
        elif [[ "$(worker_pid launchd)" == 0 ]]; then
            launchctl kickstart "gui/$(id -u)/dev.fleet.worker"
        fi
    else
        systemctl --user is-active --quiet fleet-worker.service || systemctl --user start fleet-worker.service
    fi
}

# drain_worker KIND PID TIMEOUT: ask the running worker to finish its attempt and exit (task 029,
# part 4a). Only an acknowledgement from that process proves that no attempt was cut short.
drain_worker() {
    local kind="$1" p0="$2" timeout="$3" deadline pid ack failed
    [[ -d "$WORKER_ROOT" ]] || mkdir -p -m 700 "$WORKER_ROOT"
    rm -f "$WORKER_ROOT/drained"
    : > "$WORKER_ROOT/drain"
    printf 'fleet: draining the worker (pid %s), for up to %s seconds\n' "$p0" "$timeout" >&2
    deadline=$((SECONDS + timeout))
    while true; do
        # The state first: a worker that acknowledged and then exited still shows its acknowledgement.
        pid=$(worker_pid "$kind")
        failed=0
        if worker_failed "$kind"; then failed=1; fi
        ack=$(fpy drained-pid "$WORKER_ROOT/drained" 2>/dev/null || true)
        [[ "$ack" == "$p0" ]] && return 0
        if [[ "$pid" != "$p0" || "$failed" == 1 ]]; then
            worker_log "$kind" >&2
            fail "the worker (pid $p0) exited without a drain acknowledgement. $WORKER_ROOT/drain stays, so the worker does not take new tasks. Inspect its processes and the log above as the actl operations guide requires, then remove the drain file and run fleet worker install again."
        fi
        if (( SECONDS >= deadline )); then
            rm -f "$WORKER_ROOT/drain"
            [[ "$(worker_pid "$kind")" != 0 ]] || worker_ensure_running "$kind"
            fail "the worker did not drain within $timeout seconds; its attempt still runs. The drain file is removed and the worker keeps working. Run fleet worker install again later, or with a longer --timeout."
        fi
        sleep 1
    done
}

cmd_worker_install() {
    local timeout=600 server=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --timeout) [[ "${2:-}" =~ ^[0-9]+$ ]] || fail 'invalid --timeout (seconds)'; timeout="$2"; shift 2 ;;
            --server)
                [[ "${2:-}" == default ]] || valid_actl_server "${2:-}" || fail 'invalid --server (tls://HOST:PORT, or default)'
                server="$2"; shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    need_python
    need_enrollment
    # The saved URL outlives this install, so an actl update does not drop a machine's tunnel.
    if [[ -n "$server" ]]; then
        [[ "$server" == default ]] && actl_server="" || actl_server="$server"
        save_config
    fi
    user_bus
    local id os kind work changed=0 f p0
    id=$(worker_id)
    os=$(worker_os)
    [[ ! -e "$WORKER_ROOT/unsafe-exit" ]] ||
        fail "$WORKER_ROOT/unsafe-exit exists: the worker stopped without a confirmed teardown. Inspect its processes and its log (fleet worker status) as the actl operations guide requires, then remove the marker and run again."
    kind=$(worker_service_kind)
    stage_actl_pair
    scratch; work="$SCRATCH"
    fetch_actl "$work"
    [[ -z "$actl_server" ]] || ACTL_SERVERS=("$actl_server")
    ensure_seed "$ACTL_STATE/worker.seed" "$ACTL_STAGE/actl"
    render_worker "$work/worker.toml" "$id" "$os" "$ACTL_STAGE/actl"
    render_worker_service "$work/service" "$kind"
    [[ "$ACTL_NEW" == 1 || "$SEED_NEW" == 1 ]] && changed=1
    cmp -s "$work/worker.toml" "$ACTL_CONFIG_DIR/worker.toml" || changed=1
    cmp -s "$work/ca.pem" "$ACTL_CONFIG_DIR/ca.pem" || changed=1
    cmp -s "$work/service" "$(worker_service_file "$kind")" || changed=1
    if [[ "$changed" == 0 ]]; then
        worker_ensure_running "$kind"
        printf 'actl worker %s is current\n' "$id" >&2
        printf '%s=%s:%s\n' "$id" "$os" "$SEED_KEY"
        return 0
    fi
    p0=$(worker_pid "$kind")
    [[ "$p0" == 0 ]] || drain_worker "$kind" "$p0" "$timeout"
    worker_stop "$kind"
    [[ "$ACTL_NEW" == 0 ]] || install_actl_pair
    mkdir -p "$ACTL_CONFIG_DIR" "$(dirname "$(worker_service_file "$kind")")"
    [[ "$kind" == systemd ]] || mkdir -p "$(dirname "$WORKER_LOG")"
    for f in ca.pem worker.toml; do
        cmp -s "$work/$f" "$ACTL_CONFIG_DIR/$f" || mv -f "$work/$f" "$ACTL_CONFIG_DIR/$f"
    done
    f=$(worker_service_file "$kind")
    cmp -s "$work/service" "$f" || mv -f "$work/service" "$f"
    rm -f "$WORKER_ROOT/drain" "$WORKER_ROOT/drained"
    worker_start "$kind"
    printf 'actl worker %s is running\n' "$id" >&2
    printf '%s=%s:%s\n' "$id" "$os" "$SEED_KEY"
}

# The worker service runs this before each start (render_worker_service). It reads /v1/actl again and
# rewrites the [connection] section of worker.toml, and ca.pem, so a changed server address reaches
# every worker on its next restart, without SSH to each machine (agentic-control task 030). The rest
# of worker.toml stays as install wrote it. When the broker cannot be reached, returns invalid data,
# or the installed actl refuses the new files (actl doctor --offline on a copy that names the new
# ca.pem), both files stay as they were. Both are checked before either is replaced; if a crash
# comes between the two renames, the next start finishes the change.
cmd_worker_refresh() {
    [[ $# -eq 0 ]] || fail 'usage: fleet worker refresh'
    local toml="$ACTL_CONFIG_DIR/worker.toml" actl work id f kept='kept the last good worker configuration'
    actl="$(local_bin)/actl"
    [[ -f "$toml" && -x "$actl" ]] || fail "no installed worker ($toml, $actl); run fleet worker install"
    scratch; work="$SCRATCH"
    (fetch_actl "$work") || fail "could not read /v1/actl; $kept"
    load_actl "$work"
    load_config
    id=$(worker_id)
    [[ -z "$actl_server" ]] || ACTL_SERVERS=("$actl_server")
    sed -n '/^\[worker\]$/,$p' "$toml" > "$work/rest"
    [[ -s "$work/rest" ]] || fail "$toml has no [worker] section; $kept. Run fleet worker install."
    (render_connection "worker.$id" "$ACTL_STATE/worker.seed" "$actl") > "$work/worker.toml" || fail "$kept"
    (render_connection "worker.$id" "$ACTL_STATE/worker.seed" "$actl" "$work/ca.pem") > "$work/check.toml" ||
        fail "$kept"
    for f in worker.toml check.toml; do
        printf '\n' >> "$work/$f"
        cat "$work/rest" >> "$work/$f"
    done
    if cmp -s "$work/worker.toml" "$toml" && cmp -s "$work/ca.pem" "$ACTL_CONFIG_DIR/ca.pem"; then
        printf 'fleet: the worker configuration is current (%s)\n' "${ACTL_SERVERS[*]}" >&2
        return 0
    fi
    "$actl" --config "$work/check.toml" doctor --offline >/dev/null 2>&1 ||
        fail "$actl doctor --offline refuses the new configuration; $kept"
    cmp -s "$work/ca.pem" "$ACTL_CONFIG_DIR/ca.pem" || fpy install-file "$work/ca.pem" "$ACTL_CONFIG_DIR/ca.pem"
    cmp -s "$work/worker.toml" "$toml" || fpy install-file "$work/worker.toml" "$toml"
    printf 'fleet: refreshed %s for %s\n' "$toml" "${ACTL_SERVERS[*]}" >&2
}

# The launchd agent's program: refresh, then become the worker. A failed refresh has printed why and
# kept the old files, and the worker still starts with them. The refresh runs in a subshell, which
# does not inherit the EXIT trap, and exec skips this shell's trap, so the subshell sets its own to
# remove its scratch folder.
cmd_worker_run() {
    [[ $# -eq 0 ]] || fail 'usage: fleet worker run'
    (trap cleanup EXIT; cmd_worker_refresh) || true
    exec "$(local_bin)/actl" --config "$ACTL_CONFIG_DIR/worker.toml" worker
}

cmd_worker_status() {
    load_config
    user_bus
    local kind pid bin sum server check="" attempts=0 drain=none
    bin=$(local_bin)
    printf 'worker: %s (%s)\n' "${name:-not enrolled}" "$(worker_os)"
    kind=$(worker_service_kind)
    if [[ ! -f "$(worker_service_file "$kind")" ]]; then
        printf 'service: not installed\n'
        pid=0
    else
        pid=$(worker_pid "$kind")
        if [[ "$pid" != 0 ]]; then printf 'service: active, pid %s\n' "$pid"
        elif worker_failed "$kind"; then printf 'service: failed\n'
        else printf 'service: inactive\n'
        fi
    fi
    if [[ -n "${ACTL_VERSION:-}" ]]; then printf 'pinned: actl %s\n' "$ACTL_VERSION"; else printf 'pinned: none\n'; fi
    if [[ -x "$bin/actl" ]]; then
        sum=$( (actl_pin actl) 2>/dev/null || true)
        if [[ -n "$sum" && "$(sha256_of "$bin/actl")" == "$sum" ]]; then
            printf 'installed: actl %s, matches the pin\n' "$ACTL_VERSION"
        else
            printf 'installed: %s, does not match the pin\n' "$("$bin/actl" --version 2>/dev/null || echo 'an unknown actl')"
        fi
    else
        printf 'installed: none\n'
    fi
    if [[ -f "$ACTL_CONFIG_DIR/worker.toml" ]]; then
        server=$(sed -n 's/^servers = \[\(.*\)\]$/\1/p' "$ACTL_CONFIG_DIR/worker.toml" | tr -d '"')
        if "$bin/actl" --config "$ACTL_CONFIG_DIR/worker.toml" doctor --offline >/dev/null 2>&1; then
            check='configuration and credential OK'
        else
            check='configuration check failed: actl doctor --offline'
        fi
        printf 'connection: %s (%s)\n' "$server" "$check"
    else
        printf 'connection: not configured\n'
    fi
    # Each running attempt has one actl-supervisor child of the worker.
    if [[ "$pid" != 0 ]]; then attempts=$(pgrep -P "$pid" -x actl-supervisor 2>/dev/null | grep -c . || true); fi
    printf 'active attempts: %s\n' "${attempts:-0}"
    if [[ -e "$WORKER_ROOT/unsafe-exit" ]]; then drain='unsafe-exit marker: inspect the worker, then remove the marker'
    elif [[ -e "$WORKER_ROOT/drained" ]]; then drain="drained (pid $(fpy drained-pid "$WORKER_ROOT/drained" 2>/dev/null || echo '?'))"
    elif [[ -e "$WORKER_ROOT/drain" ]]; then drain=requested
    fi
    printf 'drain: %s\n' "$drain"
}

CLIENT_TOML="$ACTL_CONFIG_DIR/client.toml"

cmd_actl_client_init() {
    [[ $# -eq 0 ]] || fail 'usage: fleet actl client-init'
    need_actl
    mkdir -p "$STATE"
    ensure_seed "$ACTL_STATE/client.seed" "$ACTL"
    printf '%s\n' "$SEED_KEY"
}

# The laptop's client configuration, written again on each run, so a laptop follows a changed
# /v1/actl. It shares ca.pem with a worker on the same machine, so a changed CA is left to fleet
# worker install, which restarts the worker with it.
cmd_actl_client_config() {
    [[ $# -eq 0 ]] || fail 'usage: fleet actl client-config'
    seed_ready "$ACTL_STATE/client.seed" || fail 'no client seed; run fleet actl client-init first'
    local work
    need_actl
    scratch; work="$SCRATCH"
    fetch_actl "$work"
    if [[ -f "$ACTL_CONFIG_DIR/worker.toml" && -f "$ACTL_CONFIG_DIR/ca.pem" ]] && ! cmp -s "$work/ca.pem" "$ACTL_CONFIG_DIR/ca.pem"; then
        fail 'the deployment CA changed; run fleet worker install first, which restarts the worker with it'
    fi
    render_connection client.cli "$ACTL_STATE/client.seed" "$ACTL" > "$work/client.toml"
    mkdir -p "$ACTL_CONFIG_DIR"
    fpy install-file "$work/ca.pem" "$ACTL_CONFIG_DIR/ca.pem"
    fpy install-file "$work/client.toml" "$CLIENT_TOML"
    printf 'wrote %s for %s\n' "$CLIENT_TOML" "${ACTL_SERVERS[*]}"
}

need_client_config() { [[ -f "$CLIENT_TOML" ]] || cmd_actl_client_config >&2; }

cmd_actl() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        client-init) cmd_actl_client_init "$@" ;;
        client-config) cmd_actl_client_config "$@" ;;
        *) fail 'usage: fleet actl client-init | fleet actl client-config' ;;
    esac
}

# Laptop: enroll HOST as a worker. Each step converges, so a failed run is repaired by running the
# same command again: install is idempotent, --add-worker converges, and the roster gains an ID once.
cmd_worker_enroll() {
    [[ $# -ge 1 ]] || fail 'usage: fleet worker enroll HOST [--controller HOST] [--provisioner PATH] [--fleet-config PATH] [--timeout S]'
    local host="$1"; shift
    valid_ssh_host "$host" || fail 'invalid HOST'
    local controller="${FLEET_ACTL_CONTROLLER:-bb}" provisioner="${FLEET_ACTL_PROVISIONER:-~/repos/agentic-control-fleet}"
    local fleet_config="${FLEET_CONFIG_REPO:-$HOME/repos/fleet-config}" timeout=120
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --controller) controller="${2:-}"; shift 2 ;;
            --provisioner) provisioner="${2:-}"; shift 2 ;;
            --fleet-config) fleet_config="${2:-}"; shift 2 ;;
            --timeout) [[ "${2:-}" =~ ^[0-9]+$ ]] || fail 'invalid --timeout (seconds)'; timeout="$2"; shift 2 ;;
            *) fail "unknown option $1" ;;
        esac
    done
    valid_ssh_host "$controller" || fail 'invalid --controller'
    [[ "$provisioner" =~ ^(/|~/)[A-Za-z0-9_./-]*$ ]] || fail 'invalid --provisioner (an absolute or ~/ path)'
    need_python
    need_client_config
    need_actl
    local out line id os
    out=$(ssh -- "$host" '~/.local/bin/fleet worker install') || fail "fleet worker install failed on $host"
    line=$(printf '%s\n' "$out" | grep -E '^[A-Za-z0-9_-]{1,59}=(linux|macos):U[A-Z2-7]{55}$' || true)
    [[ -n "$line" && "$line" != *$'\n'* ]] || fail "fleet worker install on $host did not print one ID=OS:PUBLIC_KEY line"
    id="${line%%=*}" os="${line#*=}" os="${os%%:*}"
    printf '%s is the worker %s (%s)\n' "$host" "$id" "$os"
    ssh -- "$controller" "sudo -n $provisioner/scripts/provision.py --config /etc/actl-fleet/deployment.json --environment prod --add-worker $line" ||
        fail "provision.py --add-worker failed on $controller. Run the same fleet worker enroll again; each step is safe to repeat."
    printf 'the controller on %s enrolls %s\n' "$controller" "$id"
    local roster="$fleet_config/broker/actl.json" added
    [[ -f "$roster" ]] || fail "$roster is missing; publish the actl deployment in fleet-config first (README, actl connection data)"
    added=$(fpy roster-add "$roster" "$id" "$os") || fail "could not add $id to $roster"
    if [[ "$added" == added ]]; then printf 'added %s to %s\n' "$id" "$roster"; else printf '%s is already in %s\n' "$id" "$roster"; fi
    printf 'next, unless done already: commit broker/actl.json in %s and deploy the broker (copy broker/ to ca-1, sudo broker/install.sh)\n' "$fleet_config"
    local deadline=$((SECONDS + timeout)) page after found work
    scratch; work="$SCRATCH"
    while true; do
        after="" found=""
        while true; do
            if ! "$ACTL" --config "$CLIENT_TOML" --json workers --after "$after" > "$work/workers.json" 2>"$work/err"; then
                break
            fi
            page=$(fpy workers-has "$work/workers.json" "$id")
            if [[ "$page" == found ]]; then found=1; break; fi
            [[ -n "$page" ]] || break
            after="$page"
        done
        if [[ -n "$found" ]]; then
            printf '%s is connected\n' "$id"
            return 0
        fi
        (( SECONDS < deadline )) || fail "$id is not connected after $timeout seconds. Check fleet worker status on $host, then run the same fleet worker enroll again."
        sleep 2
    done
}

cmd_worker() {
    local sub="${1:-}"; shift || true
    case "$sub" in
        install) cmd_worker_install "$@" ;;
        enroll) cmd_worker_enroll "$@" ;;
        status) [[ $# -eq 0 ]] || fail 'usage: fleet worker status'; cmd_worker_status ;;
        refresh) cmd_worker_refresh "$@" ;;
        run) cmd_worker_run "$@" ;;
        *) fail 'usage: fleet worker install [--timeout S] [--server URL|default] | status | refresh | run | enroll HOST [options]' ;;
    esac
}

# ---- fleet task: one actl task for each machine ----
# actl delivers a task at least once, and each fleet executor is idempotent and refuses a stale
# commit (part 5). So fleet task may run a task twice on a machine, and it must never skip one:
# every machine ends with a result or an explicit unfinished status. The run directory keeps the
# specification and each machine's task documents, so --resume can finish a run that stopped.

valid_run() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]]; }

# Hold an exclusive lock on RUN/lock until this process exits. flock belongs to the open file, which
# this shell keeps on descriptor 9, so the lock outlives the python process that takes it.
lock_run() {
    exec 9>>"$1/lock"
    python3 -c 'import fcntl; fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)' 2>/dev/null ||
        fail "another fleet task holds the run $(basename "$1"); wait for it to finish"
}

actl_call() {
    RUST_LOG=warn "$ACTL" --config "$CLIENT_TOML" --json "$@"
}

# TASK_STATE/<id> holds "TASK_ID STATE DETAIL" for each machine; STATE "unsent" has no task ID.
note_state() { printf '%s\n' "$2" > "$TASK_STATE/$1"; }

# submit_machine ID: make sure that the machine has a task that the controller holds.
submit_machine() {
    local id="$1" dir="$RUN/$1" n=0 last="" tid f num err
    mkdir -p "$dir"
    for f in "$dir"/task-*.json; do
        [[ -e "$f" ]] || continue
        num="${f##*/task-}" num="${num%.json}"
        [[ "$num" =~ ^[0-9]+$ ]] || continue
        if (( num > n )); then n=$num last=$f; fi
    done
    err="$TASK_STATE/$id.err"
    if [[ -n "$last" ]] && tid=$(fpy task-doc "$last" "$RUN_TASK" "$RUN_COMMIT" "$id"); then
        # A task that the controller knows is kept, whatever reply the first submission lost.
        if actl_call status "$tid" > "$TASK_STATE/$id.json" 2>"$err"; then
            note_state "$id" "$(fpy record "$TASK_STATE/$id.json")"
            return 0
        fi
        # The controller deduplicates the same document.
        if actl_call submit --task-file "$last" > "$TASK_STATE/$id.json" 2>"$err"; then
            note_state "$id" "$(fpy record "$TASK_STATE/$id.json")"
            return 0
        fi
        if ! grep -q 'controller rejected request' "$err"; then
            note_state "$id" "- unsent controller-unreachable"
            return 0
        fi
        printf 'fleet: the controller refused task %s for %s again; sending a new task\n' "$tid" "$id" >&2
    fi
    # No complete document, or a refused one: a new task with a new ID. The old one can still be
    # admitted late, and then the machine runs the task twice, which the executors allow.
    n=$((n + 1))
    if actl_call submit --repo dotfiles --commit "$RUN_COMMIT" --type "$RUN_TASK" --requires "host-$id" \
            --save-task "$dir/task-$n.json" > "$TASK_STATE/$id.json" 2>"$err"; then
        fpy sync-dir "$dir"
        note_state "$id" "$(fpy record "$TASK_STATE/$id.json")"
    else
        [[ -d "$dir" ]] && fpy sync-dir "$dir"
        note_state "$id" "- unsent $(grep -v '^{' "$err" | head -1 | tr ' ' '-' | cut -c1-60)"
    fi
}

terminal_state() { [[ "$1" == completed || "$1" == failed || "$1" == cancelled ]]; }

cmd_task() {
    local task="" all=0 commit="" timeout=600 resume="" h hosts=() roster
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --host) valid_worker_id "${2:-}" || fail 'invalid --host (a worker ID)'; hosts+=("$2"); shift 2 ;;
            --all) all=1; shift ;;
            --commit) valid_commit "${2:-}" || fail 'invalid --commit (a full lowercase commit SHA)'; commit="$2"; shift 2 ;;
            --timeout) [[ "${2:-}" =~ ^[0-9]+$ ]] || fail 'invalid --timeout (seconds)'; timeout="$2"; shift 2 ;;
            --resume) valid_run "${2:-}" || fail 'invalid --resume RUN'; resume="$2"; shift 2 ;;
            -*) fail "unknown option $1" ;;
            *) [[ -z "$task" ]] || fail "unexpected argument $1"; task="$1"; shift ;;
        esac
    done
    need_python
    need_actl
    local work
    scratch; work="$SCRATCH"
    TASK_STATE="$work/state"
    mkdir "$TASK_STATE"
    if [[ -n "$resume" ]]; then
        [[ -z "$task" && "$all" == 0 && ${#hosts[@]} -eq 0 && -z "$commit" ]] ||
            fail 'fleet task --resume RUN takes only --timeout'
        RUN="$TASK_RUNS/$resume"
        [[ -f "$RUN/spec.json" ]] || fail "no fleet task run $resume in $TASK_RUNS"
        lock_run "$RUN"
        local spec
        spec=$(fpy spec-read "$RUN/spec.json" "$TASK_TYPES") || fail "$RUN/spec.json is not a valid run specification"
        read -r RUN_TASK RUN_COMMIT <<<"$(head -1 <<<"$spec")"
        hosts=()
        while read -r h; do [[ -n "$h" ]] && hosts+=("$h"); done < <(tail -n +2 <<<"$spec")
        need_client_config
    else
        [[ " $TASK_TYPES " == *" $task "* ]] || fail "usage: fleet task NAME (--host ID... | --all) [--commit SHA] [--timeout S]; NAME is one of: $TASK_TYPES"
        [[ "$all" == 1 || ${#hosts[@]} -gt 0 ]] || fail 'name the machines: --host ID or --all'
        [[ "$all" == 0 || ${#hosts[@]} -eq 0 ]] || fail '--host and --all exclude each other'
        if [[ -z "$commit" ]]; then
            commit=$(git ls-remote "$DOTFILES_URL" refs/heads/main 2>/dev/null | awk '{print $1; exit}') || true
            valid_commit "$commit" || fail "could not read main of $DOTFILES_URL; pass --commit SHA"
        fi
        fetch_actl "$work"
        need_client_config
        roster="$work/workers"
        if [[ "$all" == 1 ]]; then
            while read -r h _; do [[ -n "$h" ]] && hosts+=("$h"); done < "$roster"
            [[ ${#hosts[@]} -gt 0 ]] || fail 'the roster from /v1/actl is empty; enroll a worker first'
        else
            for h in "${hosts[@]}"; do
                awk -v h="$h" '$1 == h {found=1} END {exit !found}' "$roster" ||
                    fail "$h is not in the roster from /v1/actl (a worker ID, not an SSH alias)"
            done
        fi
        RUN_TASK="$task" RUN_COMMIT="$commit"
        local run_id joined=""
        run_id="$(date -u +%Y%m%dT%H%M%SZ)-$task-$$"
        mkdir -p "$TASK_RUNS"
        RUN="$TASK_RUNS/$run_id"
        mkdir -m 700 "$RUN"
        lock_run "$RUN"
        for h in "${hosts[@]}"; do joined="${joined:+$joined,}$h"; done
        # The specification is durable before any task is sent, so a resume knows every machine.
        fpy spec-write "$RUN/spec.json" "$task" "$commit" "$timeout" "$joined" "$roster"
        resume="$run_id"
    fi
    printf 'run %s: %s at %s on %s machine(s); resume with: fleet task --resume %s\n' \
        "$resume" "$RUN_TASK" "$RUN_COMMIT" "${#hosts[@]}" "$resume"
    for h in "${hosts[@]}"; do submit_machine "$h"; done
    local deadline=$((SECONDS + timeout)) interval="${FLEET_TASK_POLL:-1}" pending tid st detail
    while true; do
        pending=0
        for h in "${hosts[@]}"; do
            read -r tid st detail < "$TASK_STATE/$h"
            [[ "$st" != unsent ]] || continue
            terminal_state "$st" && continue
            if actl_call status "$tid" > "$TASK_STATE/$h.json" 2>"$TASK_STATE/$h.err"; then
                note_state "$h" "$(fpy record "$TASK_STATE/$h.json")"
                read -r tid st detail < "$TASK_STATE/$h"
            fi
            terminal_state "$st" || pending=$((pending + 1))
        done
        (( pending > 0 && SECONDS < deadline )) || break
        sleep "$interval"
        interval=$(awk -v i="$interval" 'BEGIN { i *= 2; if (i > 15) i = 15; print i }')
    done
    local unfinished=0 failed=0
    for h in "${hosts[@]}"; do
        read -r tid st detail < "$TASK_STATE/$h"
        printf '%-20s %-10s %-24s %s\n' "$h" "$st" "$detail" "$tid"
        if ! terminal_state "$st"; then unfinished=$((unfinished + 1))
        elif [[ "$st" != completed || "$detail" != exit=0 ]]; then failed=$((failed + 1))
        fi
    done
    if (( unfinished > 0 )); then
        printf '%s machine%s unfinished. Resume: fleet task --resume %s\n' "$unfinished" "$([[ $unfinished == 1 ]] || echo s)" "$resume"
    fi
    (( failed > 0 )) && printf '%s machine%s failed\n' "$failed" "$([[ $failed == 1 ]] || echo s)"
    (( unfinished == 0 && failed == 0 ))
}

# ---- Executors: the worker runs these from the task's checkout of the dotfiles (see render_worker) ----
# The code that runs, and so the pins it uses, is the code at the task's commit.

# The freshness fence (task 029 part 5). actl delivers at least once, and a task abandoned by fleet
# task can be admitted late, after a newer one ran. So each executor records the commit it applied
# and that commit's committer time, refuses an older commit, and treats the same commit as a repeat.
# The worker's checkout is one commit deep, so only the commit itself is read. Each executor has its
# own line: they change different files, and a fleet-apply of a newer commit must not make a
# release's pylon-install of its pin commit stale.
# fence_open NAME: take the fence lock and set FENCE (apply or repeat), FENCE_COMMIT, FENCE_TIME.
fence_open() {
    local name="$1" verdict
    need_python
    [[ -f dot_local/bin/executable_fleet ]] && git rev-parse --git-dir >/dev/null 2>&1 ||
        fail "fleet executor $name runs from a checkout of the dotfiles"
    read -r FENCE_COMMIT FENCE_TIME <<<"$(git -c log.showSignature=false log -1 --format='%H %ct' HEAD 2>/dev/null || true)"
    valid_commit "${FENCE_COMMIT:-}" && [[ "${FENCE_TIME:-}" =~ ^[0-9]+$ ]] || fail 'cannot read the commit of this checkout'
    mkdir -p "$STATE"
    # One executor at a time decides and records, so two tasks cannot both pass the check. The wait
    # has a limit (FLEET_FENCE_WAIT, 600 seconds): a stuck holder must not hold this attempt forever.
    local wait
    wait=$(wait_seconds FLEET_FENCE_WAIT 600) || exit 1
    exec 8>>"$STATE/applied.lock"
    python3 -c '
import fcntl, sys, time
deadline = time.monotonic() + float(sys.argv[1])
while True:
    try:
        fcntl.flock(8, fcntl.LOCK_EX | fcntl.LOCK_NB)
        break
    except BlockingIOError:
        if time.monotonic() >= deadline:
            sys.exit(1)
        time.sleep(0.2)
' "$wait" ||
        fail "another executor held the fence lock $STATE/applied.lock for $wait seconds (FLEET_FENCE_WAIT); nothing changed"
    verdict=$(fpy fence "$STATE/applied" "$name" "$FENCE_COMMIT" "$FENCE_TIME") || exit 1
    case "$verdict" in
        apply|repeat) FENCE="$verdict" ;;
        stale\ *)
            local newer newer_time
            read -r _ newer newer_time <<<"$verdict"
            fail "refusing $name of ${FENCE_COMMIT:0:12} (committed $FENCE_TIME): it is older than ${newer:0:12} (committed $newer_time), which this machine applied already. Nothing changed." ;;
        *) fail "unexpected fence verdict: $verdict" ;;
    esac
}

fence_record() { fpy fence-record "$STATE/applied" "$1" "$FENCE_COMMIT" "$FENCE_TIME"; }

# The fleet files that fleet-apply installs, as SOURCE:TARGET under $HOME. Neither is a template, so
# a copy renders them exactly as chezmoi would. A copy, not chezmoi apply: machines that joined with
# join.sh have fleet but no chezmoi, and chezmoi apply would also read the user's chezmoi
# configuration and state, which a task should not depend on.
APPLY_FILES="dot_local/bin/executable_fleet:.local/bin/fleet dot_local/bin/executable_fleet-ssh-keygen:.local/bin/fleet-ssh-keygen"

executor_apply() {
    fence_open fleet-apply
    # The fence only refuses an older commit. A repeat of the same commit still compares and copies,
    # so a file changed or removed by hand since the last apply is put back.
    local pair src dst tmp staged=() i
    # A killed apply leaves its temporary files. The fence lock is held, so none belongs to a live apply.
    for pair in $APPLY_FILES; do
        dst="$HOME/${pair#*:}"
        rm -f "$(dirname "$dst")"/.fleet-apply.??????
    done
    # Stage and check every file first, so a missing source or a script that does not parse changes
    # nothing. All the APPLY_FILES are bash scripts.
    for pair in $APPLY_FILES; do
        src="${pair%%:*}" dst="$HOME/${pair#*:}"
        [[ -f "$src" ]] || fail "this checkout has no $src"
        cmp -s "$src" "$dst" && [[ -x "$dst" ]] && continue
        mkdir -p "$(dirname "$dst")"
        tmp=$(mktemp "$(dirname "$dst")/.fleet-apply.XXXXXX")
        CLEANUP+=("$tmp")
        cp "$src" "$tmp"
        chmod 0755 "$tmp"
        bash -n "$tmp" 2>/dev/null || fail "$src of ${FENCE_COMMIT:0:12} does not parse (bash -n); nothing changed"
        staged+=("$tmp" "$dst")
    done
    for ((i = 0; i < ${#staged[@]}; i += 2)); do
        mv -f "${staged[i]}" "${staged[i + 1]}"
        printf 'installed %s\n' "${staged[i + 1]}"
    done
    if [[ "$FENCE" == repeat ]]; then
        printf 'fleet-apply: %s is applied already\n' "${FENCE_COMMIT:0:12}"
        return 0
    fi
    fence_record fleet-apply
    printf 'fleet-apply: applied %s\n' "${FENCE_COMMIT:0:12}"
}

# bounded SECONDS CMD...: CMD, killed after SECONDS. An executor that waits forever holds its actl
# attempt, and a child left running after the executor exits makes the worker record an unsafe exit
# and stop, so the child is killed and reaped here, not left in the background. macOS has no timeout
# without coreutils; perl's alarm survives exec and kills the command the same way.
# A wait setting of 0 would mean no limit to timeout and perl, so only a whole number above 0 is valid.
wait_seconds() {
    local value="${!1:-$2}"
    [[ "$value" =~ ^[1-9][0-9]*$ ]] || fail "$1 must be a whole number of seconds more than 0, not '$value'"
    printf '%s\n' "$value"
}

bounded() {
    local seconds="$1"; shift
    if command -v timeout >/dev/null 2>&1; then
        timeout "$seconds" "$@"
    else
        perl -e 'alarm shift; exec @ARGV or exit 127' "$seconds" "$@"
    fi
}

# prove_pylon: the restarted agent answers on the live secrets socket with the pinned version, a
# secret arrives through that socket, and the agent lists keys. pylon needs a moment to start, so
# retry until FLEET_PYLON_WAIT seconds pass. A status without a version is a pylon older than the pin.
# The secret is fetched from the socket only, not with ref_value: its broker fallback would pass
# while the pylon path that openv uses is broken. Only its length is checked; the value is not kept.
prove_pylon() {
    local sock agent deadline status version seen='does not answer' keys length wait
    local ref="${FLEET_SELFTEST_REF:-op://Fleet/HuggingFace/credential}"
    valid_ref "$ref" || fail "invalid FLEET_SELFTEST_REF: $ref"
    wait=$(wait_seconds FLEET_PYLON_WAIT 30) || exit 1
    sock=$(secrets_sock) agent=$(agent_sock)
    deadline=$((SECONDS + wait))
    while true; do
        if status=$(curl -fsS --max-time 5 --unix-socket "$sock" http://pylon/v1/status 2>/dev/null); then
            if version=$(printf '%s' "$status" | fpy status-version 2>/dev/null); then
                [[ "$version" == "$PYLON_VERSION" ]] && break
                seen="reports version '$version'"
            else
                seen='reports no version'
            fi
        fi
        (( SECONDS < deadline )) || fail "pylon on $sock $seen; the pin is $PYLON_VERSION"
        sleep 1
    done
    length=$(curl -fsS --connect-timeout 5 --max-time 30 --unix-socket "$sock" \
        "http://pylon/v1/secrets?ref=$(encode_ref "$ref")" 2>/dev/null | wc -c) ||
        fail "$ref did not arrive through the pylon secrets socket $sock"
    (( length > 0 )) || fail "$ref arrived empty through the pylon secrets socket $sock"
    # The key check has its own FLEET_PYLON_WAIT: the secret fetch can use up the first one.
    deadline=$((SECONDS + wait))
    while true; do
        keys=$(SSH_AUTH_SOCK="$agent" bounded $((deadline > SECONDS ? deadline - SECONDS : 1)) ssh-add -L 2>/dev/null |
            grep -c '^[a-z]' || true)
        (( keys > 0 )) && break
        (( SECONDS < deadline )) || fail "the fleet agent lists no keys on $agent"
        sleep 1
    done
    printf 'pylon %s runs on %s; secrets ok; %s agent keys\n' "$PYLON_VERSION" "$sock" "$keys"
}

executor_pylon_install() {
    wait_seconds FLEET_PYLON_WAIT 30 >/dev/null || exit 1
    wait_seconds FLEET_RESTART_WAIT 120 >/dev/null || exit 1
    fence_open pylon-install
    # A repeat does not restart, but still proves the daemon that runs: something can have replaced
    # or stopped it since the first delivery.
    if [[ "$FENCE" == repeat ]]; then
        prove_pylon
        printf 'pylon-install: %s is installed already\n' "${FENCE_COMMIT:0:12}"
        return 0
    fi
    install_pylon
    prove_pylon
    fence_record pylon-install
    printf 'pylon-install: installed %s\n' "${FENCE_COMMIT:0:12}"
}

cmd_executor() {
    case "${1:-}" in
        probe)
            load_config
            printf 'fleet-probe: %s task %s user %s home %s\n' "${name:-unknown}" "${ACTL_TASK_ID:-none}" \
                "${USER:-?}" "$HOME" ;;
        apply) executor_apply ;;
        pylon-install) executor_pylon_install ;;
        *) fail 'usage: fleet executor apply|pylon-install|probe' ;;
    esac
}

command="${1:-}"
[[ $# -gt 0 ]] && shift
case "$command" in
    init) cmd_init "$@" ;;
    token) cmd_token "$@" ;;
    enroll) cmd_enroll "$@" ;;
    enroll-remote) cmd_enroll_remote "$@" ;;
    invite) cmd_invite "$@" ;;
    login) cmd_login "$@" ;;
    ephemeral) cmd_ephemeral "$@" ;;
    revoke) cmd_revoke "$@" ;;
    renew) cmd_renew "$@" ;;
    trust) cmd_trust "$@" ;;
    untrust) cmd_untrust ;;
    timer) cmd_timer "$@" ;;
    status) cmd_status ;;
    list) cmd_list "$@" ;;
    secret) cmd_secret "$@" ;;
    tunnel) cmd_tunnel "$@" ;;
    door) cmd_door "$@" ;;
    uninstall|remove) cmd_uninstall "$@" ;;
    claude) cmd_secret env CLAUDE_CODE_OAUTH_TOKEN=claude-oauth-token -- claude "$@" ;;
    agent) cmd_agent "$@" ;;
    install-step) install_step ;;
    install-pylon) install_pylon ;;
    worker) cmd_worker "$@" ;;
    actl) cmd_actl "$@" ;;
    task) cmd_task "$@" ;;
    executor) cmd_executor "$@" ;;
    -h|--help|help|"") usage ;;
    *) usage >&2; exit 2 ;;
esac
