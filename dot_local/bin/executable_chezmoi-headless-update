#!/usr/bin/env python3
"""Update the chezmoi source and apply it with no terminal, for a remote caller such as a bb server.

stdout carries one JSON report. Child output goes to stderr. Exit status:
  0  updated, and nothing needs a person
  1  the pull failed, and nothing was applied
  2  applied, but something needs a person (see "reasons")

The pull is a fetch and a fast-forward merge, not `chezmoi update`. That command runs
`git pull --autostash --rebase`, and a conflict leaves a rebase and a stash in the source
repository, which every later run then fails on. A failed fast-forward changes nothing.

Files edited outside chezmoi are skipped and reported, never overwritten. A changed config
template is reported, never regenerated: `--init` can silently change settings.

Uses only the standard library and Python 3.6 features, because older nodes run old python3.
"""
import json
import os
import platform
import shutil
import subprocess
import sys

CONFIG_TEMPLATE_CHANGED = 'config file template has changed'
LOG_TAIL_LINES = 40


def child_env():
    """Return the environment for children, with the user tool folders that a non-login SSH command lacks."""
    env = dict(os.environ)
    home = os.path.expanduser('~')
    arch = os.path.join(home, '.local', platform.machine())
    dirs = [os.path.join(arch, 'bin'), os.path.join(arch, 'pixi', 'bin'), os.path.join(arch, 'npm', 'bin'),
            os.path.join(home, '.pixi', 'bin'), os.path.join(home, '.npm-global', 'bin'),
            os.path.join(home, '.local', 'bin'), os.path.join(home, '.cargo', 'bin')]
    env['PATH'] = os.pathsep.join(dirs + [env.get('PATH') or '/usr/bin:/bin'])
    # --no-tty covers only the prompts of chezmoi. git and ssh can still ask for credentials.
    env['GIT_TERMINAL_PROMPT'] = '0'
    env['GIT_SSH_COMMAND'] = 'ssh -o BatchMode=yes'
    return env


class Runner(object):
    def __init__(self, env):
        self.env = env
        self.log = []
        self.config_template_changed = False

    def run(self, args, cwd=None):
        """Run args with no stdin and no controlling terminal. Return (exit status, stdout, stderr)."""
        proc = subprocess.Popen(args, cwd=cwd, env=self.env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, universal_newlines=True, start_new_session=True)
        out, err = proc.communicate()
        for text in (out, err):
            if text:
                sys.stderr.write(text)
                self.log.extend(text.splitlines())
        if CONFIG_TEMPLATE_CHANGED in err:
            self.config_template_changed = True
        return proc.returncode, out, err


def report(result, code, **fields):
    fields['result'] = result
    json.dump(fields, sys.stdout, sort_keys=True)
    sys.stdout.write('\n')
    return code


def main():
    env = child_env()
    runner = Runner(env)
    chezmoi = shutil.which('chezmoi', path=env['PATH'])
    if chezmoi is None:
        return report('pull_failed', 1, reasons=['chezmoi_missing'], before=None, after=None, pending=[], log_tail=[])

    code, out, _ = runner.run([chezmoi, 'source-path'])
    source = out.strip()
    if code != 0 or not source:
        return report('pull_failed', 1, reasons=['source_missing'], before=None, after=None, pending=[],
                      log_tail=runner.log[-LOG_TAIL_LINES:])

    def head():
        return runner.run(['git', 'rev-parse', 'HEAD'], cwd=source)[1].strip() or None

    before = head()
    for reason, args in (('fetch_failed', ['git', 'fetch', '--quiet']),
                         ('merge_failed', ['git', 'merge', '--ff-only', '--quiet', '@{upstream}'])):
        if runner.run(args, cwd=source)[0] != 0:
            return report('pull_failed', 1, reasons=[reason], before=before, after=head(), pending=[],
                          log_tail=runner.log[-LOG_TAIL_LINES:])
    after = head()

    reasons = []
    if runner.run([chezmoi, 'apply', '--no-tty', '--keep-going'])[0] != 0:
        reasons.append('apply_failed')
    code, out, _ = runner.run([chezmoi, 'status'])
    # Each line is two status letters, a space, and a target path.
    pending = [{'status': line[:2], 'path': line[3:]} for line in out.splitlines() if line.strip()]
    if code != 0:
        reasons.append('status_failed')
    if pending:
        reasons.append('pending')
    if runner.config_template_changed:
        reasons.append('config_template_changed')

    if reasons:
        return report('needs_attention', 2, reasons=reasons, before=before, after=after, pending=pending,
                      log_tail=runner.log[-LOG_TAIL_LINES:])
    return report('updated', 0, reasons=[], before=before, after=after, pending=[], log_tail=[])


if __name__ == '__main__':
    sys.exit(main())
