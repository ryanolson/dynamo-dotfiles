#!/usr/bin/env bash
set -euo pipefail

# Every machine has the same file of VAR=op://... lines. openv asks fleet for each value
# (the local pylon cache, else the broker). If any value fails, or the machine is not
# enrolled, op resolves the whole file. A command never gets values from both sources.
REFS="$HOME/.config/dynamo/dev.env.fleet"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/fleet"

usage() {
    echo "Usage: openv <command...>" >&2
    exit 1
}

[[ $# -gt 0 ]] || usage

part='[A-Za-z0-9 ._-]+'
vars=()
refs=()
if [[ -f "$REFS" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        if [[ ! "$line" =~ ^([A-Z_][A-Z0-9_]*)=(op://$part/$part/($part/)?$part)$ ]]; then
            echo "openv: invalid line in $REFS: $line" >&2
            exit 1
        fi
        vars+=("${BASH_REMATCH[1]}")
        refs+=("${BASH_REMATCH[2]}")
    done < "$REFS"
fi
if [[ ${#vars[@]} -eq 0 ]]; then
    echo "openv: no secret references in $REFS" >&2
    exit 1
fi

fleet=$(command -v fleet || echo "$HOME/.local/bin/fleet")
if [[ -x "$fleet" && -f "$STATE/node.crt" ]]; then
    values=()
    for ref in "${refs[@]}"; do
        value=$("$fleet" secret get "$ref" 2>/dev/null) || { values=(); break; }
        values+=("$value")
    done
    if [[ ${#values[@]} -eq ${#vars[@]} ]]; then
        for i in "${!vars[@]}"; do
            export "${vars[$i]}=${values[$i]}"
        done
        unset values value
        exec "$@"
    fi
fi

if command -v op >/dev/null 2>&1; then
    exec op run --env-file "$REFS" -- "$@"
fi
echo "openv: the fleet broker did not return the secrets, and the 1Password CLI (op) is not installed" >&2
exit 1
