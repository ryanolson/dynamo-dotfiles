#!/usr/bin/env python3
"""Run codex with the wcie profile (~/.codex/wcie.config.toml).

The OpenRouter key comes from fleet first, as openv does, and from op when the machine is not
enrolled or the broker fails. The key reaches only the codex process. Arguments pass through to
codex.

`wcie-codex app-server ...` is for ACP adapters that take a codex executable (CODEX_PATH): codex
refuses --profile for app-server, so the profile is passed as -c overrides instead. These read
~/.codex/wcie.profile.json, which chezmoi renders from the source profile: the deployed TOML also
holds TUI state that codex writes back, and older python3 (macOS ships 3.9) has no tomllib.

Both modes pass a model catalog that lists K3 (the profile's model) and Astra 6. The Astra entry
comes from the live OpenAI catalog with its slug moved to OpenRouter's.
"""
import copy
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

REF = "op://Fleet/OpenRouter-WCIE-Limited/credential"
PROFILE = "wcie"
OPENROUTER_SLUGS = {"gpt-6-astra": "openai/gpt-6-astra"}
# Well under the 30 s that bb gives an ACP agent to start; a timeout falls back to the cache.
CATALOG_TIMEOUT_S = 10
K3_EFFORTS = ("low", "medium", "high", "xhigh", "max")
K3_CONTEXT_WINDOW = 1_048_576


def die(message):
    print(f"wcie-codex: {message}", file=sys.stderr)
    sys.exit(1)


def warn(message):
    print(f"wcie-codex: {message}", file=sys.stderr)


def read_key():
    home = Path.home()
    state = Path(os.environ.get("XDG_STATE_HOME") or home / ".local/state") / "fleet"
    sources = []
    fleet = shutil.which("fleet") or str(home / ".local/bin/fleet")
    if os.access(fleet, os.X_OK) and (state / "node.crt").is_file():
        sources.append([fleet, "secret", "get", REF])
    if shutil.which("op"):
        sources.append(["op", "read", REF])
    for command in sources:
        result = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, universal_newlines=True)
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    die(f"could not read {REF} from the fleet broker or 1Password (op)")


def find_codex():
    # npx puts the ACP adapter's node_modules/.bin first on PATH, and the adapter depends on its own
    # codex package. Skip those so the adapter runs the one installed codex.
    dirs = os.environ.get("PATH", "").split(os.pathsep)
    path = os.pathsep.join(d for d in dirs if not d.rstrip("/").endswith("node_modules/.bin"))
    return shutil.which("codex", path=path) or die("no codex on PATH outside node_modules/.bin")


def load_profile():
    """The rendered profile, or None when chezmoi has not rendered it."""
    home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
    try:
        return json.loads((home / f"{PROFILE}.profile.json").read_text())
    except (OSError, ValueError):
        return None


def toml_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    if isinstance(value, str):
        return json.dumps(value)
    if isinstance(value, list):
        return "[" + ", ".join(toml_value(v) for v in value) + "]"
    if isinstance(value, dict):
        return "{" + ", ".join(f"{toml_key(k)} = {toml_value(v)}" for k, v in value.items()) + "}"
    raise TypeError(f"unsupported TOML value {value!r}")


def toml_key(key):
    # Codex splits -c keys on dots and does not read quotes, so only bare keys survive.
    if not re.fullmatch(r"[A-Za-z0-9_-]+", key):
        die(f"the profile key {key!r} cannot be passed to codex as a -c override")
    return key


def overrides(profile, prefix=""):
    """Flatten the profile into -c key=value arguments, one per leaf."""
    args = []
    for key, value in profile.items():
        path = prefix + toml_key(key)
        if isinstance(value, dict):
            args += overrides(value, path + ".")
        else:
            args += ["-c", f"{path}={toml_value(value)}"]
    return args


def k3_entry(model, template):
    # Codex's metadata for a model it does not know (models-manager model_info_from_slug), which is
    # what K3 ran on before it had an entry. Every field is explicit, so no serde default decides.
    # Only the name, picker placement, review model, reasoning efforts, instructions (from Astra), and
    # context window differ. The efforts make K3's reasoning selectable in the codex and bb pickers, with
    # max as the default. Ultra is left out: it is Codex task delegation, not an OpenRouter effort. The
    # window is K3's own, 1,048,576 tokens on every OpenRouter endpoint: codex compacts against it, so
    # the unknown-model 272,000 cut K3's sessions to about a quarter of what it serves.
    return {
        "slug": model,
        "display_name": "Kimi K3",
        "description": None,
        "default_reasoning_level": "max",
        "supported_reasoning_levels": [l for l in template["supported_reasoning_levels"] if l["effort"] in K3_EFFORTS],
        "shell_type": "unified_exec",
        "visibility": "list",
        "supported_in_api": True,
        "priority": -1,
        "additional_speed_tiers": [],
        "service_tiers": [],
        "default_service_tier": None,
        "available_access_programs": None,
        "availability_nux": None,
        "upgrade": None,
        "model_messages": template["model_messages"],
        "include_skills_usage_instructions": False,
        "include_plugin_usage_instructions": False,
        "include_apps_usage_instructions": False,
        "supports_reasoning_summary_parameter": True,
        "default_reasoning_summary": "auto",
        "support_verbosity": False,
        "default_verbosity": None,
        "apply_patch_tool_type": None,
        "web_search_tool_type": "text",
        "truncation_policy": {"mode": "bytes", "limit": 10000},
        "supports_image_detail_original": False,
        "context_window": K3_CONTEXT_WINDOW,
        "max_context_window": K3_CONTEXT_WINDOW,
        "auto_compact_token_limit": None,
        "comp_hash": None,
        "effective_context_window_percent": 95,
        "experimental_supported_tools": [],
        "input_modalities": ["text", "image"],
        "supports_search_tool": False,
        "supports_experimental_context": False,
        "use_responses_lite": False,
        "supports_reasoning_effort_updates": True,
        "guardian": None,
        "node_repl_auto_review_required": False,
        "node_repl_disabled": False,
        "auto_review_model_override": model,
        "model_specialty": None,
        "tool_mode": None,
    }


def openrouter_entry(entry, slug, model):
    entry = copy.deepcopy(entry)
    entry.update(slug=slug, availability_nux=None, upgrade=None, auto_review_model_override=model)
    return entry


def build_catalog(live, model):
    by_slug = {m["slug"]: m for m in live["models"]}
    missing = [s for s in OPENROUTER_SLUGS if s not in by_slug]
    if missing:
        raise KeyError(f"the OpenAI catalog has no {', '.join(missing)}")
    models = [k3_entry(model, by_slug["gpt-6-astra"])]
    models += [openrouter_entry(by_slug[s], OPENROUTER_SLUGS[s], model) for s in OPENROUTER_SLUGS]
    return {"models": models}


def cached_catalog(cache, model):
    """True when the cache parses and was built for this model."""
    try:
        return json.loads(cache.read_text())["models"][0]["slug"] == model
    except (OSError, ValueError, KeyError, IndexError, TypeError):
        return False


def write_catalog(cache, catalog):
    # A unique temporary file per launch: bb can start several app-servers at once.
    cache.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=str(cache.parent), prefix=".models-", suffix=".json")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(catalog, f)
        os.replace(tmp, str(cache))
    except BaseException:
        os.unlink(tmp)
        raise


def catalog_path(profile, codex):
    """Write the catalog to the cache and return its path, or None when there is none to use."""
    if profile is None:
        warn("~/.codex/wcie.profile.json is missing; running without the K3/Astra catalog")
        return None
    cache = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "wcie-codex/models.json"
    try:
        result = subprocess.run([codex, "debug", "models"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                universal_newlines=True, timeout=CATALOG_TIMEOUT_S)
        if result.returncode != 0:
            raise RuntimeError(f"codex debug models exited {result.returncode}")
        write_catalog(cache, build_catalog(json.loads(result.stdout), profile["model"]))
        return cache
    except Exception as error:  # Any failure leaves codex running, with the last good catalog if any.
        if cached_catalog(cache, profile["model"]):
            warn(f"{error}; using the cached catalog")
            return cache
        warn(f"{error}; running without the K3/Astra catalog")
        return None


def main():
    args = sys.argv[1:]
    app_server = bool(args) and args[0] == "app-server"
    profile = load_profile()
    if app_server and profile is None:
        die("~/.codex/wcie.profile.json is missing or invalid; run chezmoi apply")
    profile_args = overrides(profile) if app_server else ["-p", PROFILE]
    os.environ["OPENROUTER_API_KEY"] = read_key()
    codex = find_codex()
    catalog = catalog_path(profile, codex)
    catalog_args = ["-c", f"model_catalog_json={json.dumps(str(catalog))}"] if catalog else []
    os.execv(codex, [codex, *profile_args, *catalog_args, *args])


if __name__ == "__main__":
    main()
