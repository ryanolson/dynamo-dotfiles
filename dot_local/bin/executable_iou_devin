#!/usr/bin/env bash
set -euo pipefail

if ! command -v devin >/dev/null 2>&1; then
    installer=$(mktemp)
    trap 'rm -f "$installer"' EXIT
    curl -fsSL https://cli.devin.ai/install.sh -o "$installer"
    bash "$installer"
    # The installer may place devin in a directory that is not yet on PATH.
    export PATH="$HOME/.local/bin:$PATH"
fi

exec devin update
